VITE_API_URL=http://localhost:5000/api/v1
# Router/query devtools render only when this is exactly 'true' (Phase 22A).
VITE_DEVTOOLS=false

# The film reel behind the landing hero (optional). One address, or several separated by
# commas, played in turn with a cross-fade between them. Put the files under
# frontend/public/media/ and name them here; leave empty to paint the brand ground only.
# Muted, no controls, paused for people who ask for less motion; a poster image shows while
# the first film loads. See frontend/public/media/SOURCES.md for the films shipped here.
VITE_LANDING_VIDEO_URL=/media/hero-01-architects-plans.mp4,/media/hero-02-site-blueprint.mp4,/media/hero-03-site-engineers.mp4,/media/hero-04-bridge-plans.mp4,/media/hero-05-engineers-review.mp4,/media/hero-06-interior-plans.mp4,/media/hero-07-site-plans.mp4,/media/hero-08-site-walk.mp4,/media/hero-09-site-inspection.mp4,/media/hero-10-presenting-plan.mp4,/media/hero-11-site-devices.mp4,/media/hero-12-scaffolding-consult.mp4
VITE_LANDING_VIDEO_POSTER=

# Where those films are served from. The films are large and they are not code, so they
# live in object storage rather than in this repository: upload them with
# scripts/upload-landing-reel.mjs and put the public address of the bucket here. Every
# name above that is not already a full address is hung off it. Left empty, the names
# are taken as they stand, which is how a developer serves them from frontend/public.
VITE_LANDING_VIDEO_BASE=
