VITE_API_URL=http://localhost:5000/api/v1
# Router/query devtools render only when this is exactly 'true' (Phase 22A).
VITE_DEVTOOLS=false

# The film reel behind the landing hero (optional). One address, or several separated by
# commas, played in turn with a cross-fade between them. Put the files under
# frontend/public/media/ and name them here; leave empty to paint the brand ground only.
# Muted, no controls, paused for people who ask for less motion; a poster image shows while
# the first film loads. See frontend/public/media/SOURCES.md for the films shipped here.
VITE_LANDING_VIDEO_URL=/media/hero-01-architects-plans.mp4,/media/hero-02-site-blueprint.mp4,/media/hero-03-site-engineers.mp4,/media/hero-04-bridge-plans.mp4,/media/hero-05-engineers-review.mp4,/media/hero-06-interior-plans.mp4
VITE_LANDING_VIDEO_POSTER=
