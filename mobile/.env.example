# OctaPM mobile — environment
#
# Only variables prefixed EXPO_PUBLIC_ reach the app bundle. Nothing here is a
# secret: the app carries no server credentials. Copy to .env for local work.

# Which backend this build talks to. One of: local, development, staging, production.
EXPO_PUBLIC_ENV=local

# The API origin, without the /api/v1 suffix. On a physical device "localhost"
# is the phone, not your machine: use your machine's LAN address, e.g.
# http://192.168.1.20:5000
EXPO_PUBLIC_API_ORIGIN=http://localhost:5000

# The web platform, used to hand a link to the browser when the app cannot open it.
EXPO_PUBLIC_WEB_ORIGIN=http://localhost:5173

# Push notifications need an Expo project id (from `eas init`). Leave empty for
# local development: the app then skips registration and says so in Settings.
EXPO_PUBLIC_EAS_PROJECT_ID=
