{
  "name": "pmcopilots-backend",
  "version": "1.0.0",
  "description": "PMcopilots Express.js REST API",
  "main": "src/index.js",
  "engines": {
    "node": ">=24.14.0 <25",
    "npm": ">=11.9.0 <12"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "db:dev": "node scripts/dev-db.mjs",
    "start": "node src/index.js",
    "db:migrate": "npx prisma migrate dev",
    "db:seed": "node prisma/seed.js",
    "db:studio": "npx prisma studio",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "openapi:validate": "node scripts/validate-openapi.js",
    "smoke:deploy": "node scripts/deployment-smoke.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "worker": "node src/worker.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.88.0",
    "@e965/xlsx": "^0.20.3",
    "@prisma/client": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.0",
    "stripe": "^22.1.1",
    "swagger-ui-express": "^5.0.1",
    "xml2js": "^0.6.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "embedded-postgres": "^18.3.0-beta.17",
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prisma": "^6.0.0",
    "supertest": "^7.2.2"
  }
}
