# OctaPM backend environment
#
# Copy to backend/.env and fill in. Keys under "Required" must be set; every
# other section is optional and the feature it names simply stays off until you
# set it. Commented-out lines show the default the code uses.
#
# In production (NODE_ENV=production) `config/security.js` refuses to boot
# unless the whole production contract holds — see "Running on AWS" at the end
# of this file for every variable it checks. Development needs none of it:
# every setting below that section keeps its local default.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/pmcopilots"
JWT_SECRET="your-secret-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
# Only when the API sits behind CloudFront (TRUST_PROXY_HOPS=2): CloudFront adds
# this header and the API refuses requests without it. With the API directly
# behind a load balancer (TRUST_PROXY_HOPS=1) it must be left unset.
# CLOUDFRONT_SHARED_SECRET=

# ---------------------------------------------------------------------------
# Server and URLs
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
# The mobile app's web development target runs on 8081; native builds send no Origin and need no entry.
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081"
# Where the browser app lives. Used to build every link in an email,
# notification, QR code and portal invitation.
WEB_APP_URL="http://localhost:5173"
# Public origin of this API. Every OAuth and SSO redirect URI is built from it.
# Either spelling works — with or without a trailing /api/v1.
API_BASE_URL="http://localhost:5000"
# APP_NAME="OctaPM"
# Number of proxy hops to trust for the client IP (behind a load balancer).
# TRUST_PROXY_HOPS=1

JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
# PASSWORD_RESET_TOKEN_MINUTES=60
# INVITATION_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Shared state and background jobs
# ---------------------------------------------------------------------------
# Optional. When set, rate-limit counters live in Redis; otherwise they live in
# Postgres in production and in memory everywhere else (RATE_LIMIT_STORE).
REDIS_URL=""
REALTIME_EMIT_DELAY_MS=150
# The job worker runs ONLY when JOB_WORKER_ENABLED is exactly "true" (missing, empty,
# false or anything else = off). Leave it off on API instances when you run dedicated
# workers with `npm run worker --workspace=backend`.
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=2000
JOB_HEARTBEAT_MS=15000
JOB_STALE_MS=300000
JOB_TTL_MS=604800000
# JOB_RECOVER_INTERVAL_MS=60000
# JOB_PRUNE_INTERVAL_MS=3600000

# Everything that writes on its own is OFF unless its variable is exactly "true"
# (src/config/switches.js): a deployment that says nothing starts nothing. Missing,
# empty, false, 1, yes, on and typos are all off. All are off under test.
#
# A process runs the schedulers only when it holds leadership (SCHEDULERS_ENABLED=true)
# AND the scheduler's own switch is true. For one local development process that does
# everything, uncomment the lines you want:
# SCHEDULERS_ENABLED=true               # this process may hold scheduler leadership
# BILLING_SCHEDULER_ENABLED=true        # expires lapsed trials / cancelled subscriptions, trial reminders (every organisation)
# NOTIFICATION_SCHEDULER_ENABLED=true   # pending e-mail and push delivery, daily due-date scan (every organisation)
# DAILY_LOG_SCHEDULER_ENABLED=true      # weather fill + daily log distribution
# REPORT_SCHEDULER_ENABLED=true         # scheduled report delivery, portfolio refresh
# WORKFLOW_SCHEDULER_ENABLED=true       # workflow step escalation
# ACCOUNTING_SCHEDULER_ENABLED=true     # accounting payment polling
# EXCEPTIONS_SCHEDULER_ENABLED=true     # PC-7b nightly exception re-evaluation tick (one job per active project);
#                                       # runs only when EXCEPTIONS_ENGINE_ENABLED=true as well
# EXPO_PUSH_ENABLED=true                # push delivery through the Expo push service
# EXCEPTIONS_NIGHTLY_HOUR_UTC=7         # the UTC hour the tick runs in (0-23; 7 = 02:00 Chicago), once per UTC day, never at start-up
# EXCEPTIONS_ENGINE_ENABLED=false       # the whole PC-7b exception engine. OFF unless this is exactly "true": missing,
#                                       # empty or any other value = no event trigger, no tick, the exceptions.evaluate
#                                       # handler stands down and the notifier registers nothing. Switching it on makes
#                                       # the engine evaluate EVERY organisation in the database; it cannot be narrowed.
# ACCOUNTING_POLL_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Rate limits (window in ms, max requests per window)
# ---------------------------------------------------------------------------
# RATE_LIMIT_API_WINDOW_MS / RATE_LIMIT_API_MAX
# RATE_LIMIT_AUTH_WINDOW_MS / RATE_LIMIT_AUTH_MAX
# RATE_LIMIT_LOGIN_WINDOW_MS / RATE_LIMIT_LOGIN_MAX
# RATE_LIMIT_REFRESH_WINDOW_MS / RATE_LIMIT_REFRESH_MAX
# RATE_LIMIT_UPLOAD_WINDOW_MS / RATE_LIMIT_UPLOAD_MAX
# RATE_LIMIT_AI_WINDOW_MS / RATE_LIMIT_AI_MAX
# RATE_LIMIT_BILLING_WINDOW_MS / RATE_LIMIT_BILLING_MAX
# RATE_LIMIT_STRIPE_WEBHOOK_WINDOW_MS / RATE_LIMIT_STRIPE_WEBHOOK_MAX

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# The first provider with a key wins unless AI_PROVIDER names one:
# anthropic | openai | gemini. Without a key every AI feature degrades to its
# deterministic result and says so, rather than failing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here
# AI_MODEL=                             # overrides the provider's default model
# AI_VISION=off                         # keeps prompts text-only
# AI_TRANSCRIPTION=off                  # disables voice notes (needs OPENAI_API_KEY)
# AI_TRANSCRIPTION_MODEL=whisper-1
# AI_RETRY_BASE_MS=1000

# Per-feature limits.
# AI_MAX_PHOTOS=8                       # photos per daily-log draft
# AI_PHOTO_BATCH=10                     # photos per batch analysis
# AI_PHOTO_AUTO=on                      # analyse photos as they are uploaded
# AI_DRAWING_PAGES=8                    # sheets per title-block read (1-12)
# AI_CONTRACT_WINDOWS=8                 # text windows per clause extraction
# AI_SPEC_CHARS=12000                   # spec section window for conflicts
# AI_SPEC_SHEETS=6                      # drawings compared per spec section

# Document embeddings for semantic search (optional; keyword search works
# without it): openai | gemini | voyage, with the matching key.
# EMBEDDINGS_PROVIDER=
# VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# Without a bucket, files go to local disk — the right thing for development.
# A configured bucket selects S3; FILE_STORAGE_DRIVER=local forces local disk
# even when a bucket is set. Production refuses to boot without a bucket, and
# refuses static keys: there the task role supplies credentials.
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_LOCAL_DIR=./uploads
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=us-east-2
# Only to try S3 from this machine with your own short-lived credentials:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# FILE_PRESIGNED_URL_TTL_SECONDS=300
# FILE_UPLOAD_TMP_DIR=
# SITE_REPORT_UPLOAD_DIR=
# WORKFLOW_UPLOAD_DIR=

# IFC model upload ceiling and the element cap per model.
# BIM_MAX_BYTES=314572800               # 300 MB
# BIM_MAX_ELEMENTS=250000

# ---------------------------------------------------------------------------
# Outbound email
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER picks the transport (ses | webhook | log). Unset, it is webhook
# when a webhook URL is set and log otherwise — locally, mail is written to the
# API log. SES settings are under "Running on AWS" below.
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Inbound email (reply to a notification and it lands on the record)
# ---------------------------------------------------------------------------
# The domain your mail provider routes to POST /api/v1/public/inbound-email.
# INBOUND_EMAIL_DOMAIN=inbox.example.com
# Not at launch: production refuses INBOUND_EMAIL_DOMAIN until inbound mail has
# a receiving path. When it is enabled, INBOUND_EMAIL_SECRET is required too.
# Signs the reply-to addresses. Outside production it falls back to JWT_SECRET.
# To rotate, move the old value to INBOUND_EMAIL_SECRET_PREVIOUS so replies to
# older mail still land.
# INBOUND_EMAIL_SECRET=
# Shared token the provider sends as ?token=, X-Inbound-Token or basic auth.
# INBOUND_EMAIL_WEBHOOK_TOKEN=
# Mailgun signs instead; set its signing key to verify that way.
# INBOUND_MAILGUN_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Single sign-on and two-factor authentication
# ---------------------------------------------------------------------------
# Encrypts TOTP secrets. Required in production. Outside production it falls
# back to INTEGRATION_SECRET_KEY then JWT_SECRET. To rotate, move the old value
# to MFA_SECRET_KEY_PREVIOUS: each secret is re-sealed under the new key the
# next time its owner signs in.
# MFA_SECRET_KEY=
# MFA_ISSUER=OctaPM                     # the name shown in the authenticator app
# Must match the redirect URI registered with the identity provider. Defaults
# to `${API_BASE_URL}/api/v1/auth/sso/callback`, which is where the route lives.
# SSO_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Web push (PWA notifications)
# ---------------------------------------------------------------------------
# Generate with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Public API, webhooks and accounting connectors
# ---------------------------------------------------------------------------
# Encrypts stored OAuth tokens. Required in production. To rotate, move the old
# value to INTEGRATION_SECRET_KEY_PREVIOUS.
# INTEGRATION_SECRET_KEY=
# Webhooks reach public https addresses only. true lets a local receiver in:
# plain http and loopback (127.0.0.0/8, ::1) — never private, link-local or
# metadata addresses. Ignored when NODE_ENV=production.
# WEBHOOK_ALLOW_HTTP=false
# Defaults to `${API_BASE_URL}/api/v1/integrations/accounting/{provider}/callback`.
# ACCOUNTING_REDIRECT_URI=
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=sandbox               # sandbox | production
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Vendor portals
# ---------------------------------------------------------------------------
# How long an RFQ link stays valid. The token rotates on every reminder.
# RFQ_LINK_DAYS=45

# ---------------------------------------------------------------------------
# Weather feed (Open-Meteo, no key needed)
# ---------------------------------------------------------------------------
# WEATHER_FEED_ENABLED=true              # off unless exactly "true": no call to the weather provider otherwise
# WEATHER_FEED_FORECAST_URL=
# WEATHER_FEED_ARCHIVE_URL=
# WEATHER_FEED_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_change_me"
STRIPE_PRICE_INDIVIDUAL_MONTHLY="price_change_me"
STRIPE_PRICE_INDIVIDUAL_ANNUAL="price_change_me"
STRIPE_PRICE_BUSINESS_MONTHLY="price_change_me"
STRIPE_PRICE_BUSINESS_ANNUAL="price_change_me"

# ---------------------------------------------------------------------------
# Running on AWS (production and staging) — none of this is needed locally
# ---------------------------------------------------------------------------
# Shape: several identical API tasks behind a load balancer, one worker task
# from the same image, RDS Postgres, private S3, SES. Secrets come from Secrets
# Manager as environment variables; AWS credentials come from the task role and
# are never set by hand. With NODE_ENV=production the process refuses to boot
# when any rule below is broken, and says which.
#
# Release identity (baked into the image at build time)
# RELEASE_GIT_SHA=<40 hex characters>     # required
# RELEASE_BUILD_TIME=<ISO 8601>
# APP_ENV=production                      # production | staging (staging may use Stripe test keys)
#
# Database: TLS to RDS and a pool per process
# DATABASE_URL="postgresql://octapm_app:<password>@<rds-endpoint>:5432/octapm?sslmode=require&sslcert=/app/certs/rds-ca.pem&sslaccept=strict"
#   sslaccept=strict is not optional: without it Prisma accepts any certificate.
#   rds-ca.pem holds ONE root (Prisma reads only the first certificate of the
#   file); the image picks it from the RDS bundle by RDS_CA_CN at build time.
# DATABASE_CONNECTION_LIMIT=10            # API 10, worker 6; a connection_limit in the URL wins
# DATABASE_POOL_TIMEOUT_SECONDS=10
#
# Secrets (48+ random characters each, all different)
# JWT_SECRET= / JWT_REFRESH_SECRET=
# MFA_SECRET_KEY=                         # required in production: no fallback to other secrets there
# INTEGRATION_SECRET_KEY=                 # required in production
#
# Network edge
# TRUST_PROXY_HOPS=1                      # 1 = load balancer only, 2 = CloudFront then load balancer
# CORS_ALLOWED_ORIGINS=https://app.octapm.com
# WEB_APP_URL=https://app.octapm.com      # https, not local, origin only
# API_BASE_URL=https://api.octapm.com
#
# Email through SES (the task role needs ses:SendEmail)
# EMAIL_PROVIDER=ses                      # ses | webhook | log; unset = webhook when EMAIL_WEBHOOK_URL is set, else log
# EMAIL_FROM="OctaPM <no-reply@octapm.com>"
# SES_REGION=us-east-2
# SES_CONFIGURATION_SET=
#
# Files (the task role needs s3:PutObject and s3:GetObject on the bucket)
# FILE_STORAGE_S3_BUCKET=octapm-prod-uploads
# FILE_STORAGE_S3_REGION=us-east-2
# FILE_PRESIGNED_URL_TTL_SECONDS=300      # clamped to 60–3600
# AWS_EC2_METADATA_DISABLED=true          # Fargate has no instance metadata; skip the probe
#
# Shared state across tasks. Outside production each is `memory`; in
# production each is `postgres` and `memory` is refused.
# REALTIME_ADAPTER=postgres               # socket.io fan-out across tasks
# REALTIME_DATABASE_URL=                  # only if DATABASE_URL goes through RDS Proxy (LISTEN needs a direct connection)
# RATE_LIMIT_STORE=postgres               # or redis when REDIS_URL is set
# AUTH_THROTTLE_STORE=postgres            # login lockout counters
#
# Which process does what. Nothing here has an "on" default: the worker service's
# configuration must name each thing it is to run, or it runs nothing (and exits).
# SCHEDULERS_ENABLED=false                # API tasks: unset or false. Worker: true. One leader runs them.
# JOB_WORKER_ENABLED=false                # API tasks: unset or false. Worker: true.
# SCHEDULER_LOCK_KEY=octapm-schedulers
# SCHEDULER_LEADER_HEARTBEAT_MS=15000
# On the worker, each scheduler it is to run, explicitly:
# BILLING_SCHEDULER_ENABLED=true
# NOTIFICATION_SCHEDULER_ENABLED=true
# DAILY_LOG_SCHEDULER_ENABLED=true
# REPORT_SCHEDULER_ENABLED=true
# WORKFLOW_SCHEDULER_ENABLED=true
# ACCOUNTING_SCHEDULER_ENABLED=true
# EXPO_PUSH_ENABLED=true                  # on every process that creates notifications (API and worker)
# WEATHER_FEED_ENABLED=true
#
# Graceful shutdown and the load balancer
# HTTP_KEEP_ALIVE_TIMEOUT_MS=65000        # longer than the load balancer's 60 s idle timeout
# SHUTDOWN_TIMEOUT_MS=25000               # API 25000 (ECS stopTimeout 30); worker 110000 (stopTimeout 120)
# HEALTH_DB_TIMEOUT_MS=2000               # /api/health/ready gives up on the database after this
# REQUEST_LOG_FORMAT=json                 # json | dev | off
#
# Sign-up
# PUBLIC_REGISTRATION=                    # leave unset. Production keeps sign-up closed whatever this says, and the
#                                         # boot check refuses "true" there (D-REG-1: sign-up does not verify the
#                                         # mailbox yet). Outside production it is open only under NODE_ENV
#                                         # development or test, or when set to "true". Everyone joins by
#                                         # invitation; the first administrator comes from
#                                         # `npm run admin:bootstrap --workspace=backend`
# BOOTSTRAP_LINK_MINUTES=30               # the first administrator's set-password link: 5–60, single use
# PASSWORD_RESET_TOKEN_MINUTES=60         # production refuses anything outside 5–1440
#
# Membership emergency switch
# AUTH_MEMBERSHIP_WRITE=                  # leave unset (on). "false" pauses everything that widens access
#                                         # (inviting, accepting, activating, role changes, admin/owner grants,
#                                         # project-team and party additions: 503 MEMBERSHIP_WRITES_SUSPENDED).
#                                         # Removing access (suspend, revoke an invitation, remove from a
#                                         # project, revoke admin) keeps working.
#
# Sole-owner recovery (support only; docs/operations/OWNER_RECOVERY_RUNBOOK.md)
# RECOVERY_OPERATOR_EMAILS=               # comma-separated sign-in e-mails of the support operators allowed to
#                                         # run `npm run ops:recover-owner`; each needs two-factor on. Empty =
#                                         # nobody can run it. Only that command reads it; the API never does.
#
# Must NOT be set in production (the boot check refuses them):
#   AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_SESSION_TOKEN, FILE_STORAGE_DRIVER=local,
#   FILE_STORAGE_S3_ENDPOINT, SES_ENDPOINT, ALLOW_DATA_SCRIPT, EMAIL_PROVIDER=log,
#   PUBLIC_REGISTRATION=true,
#   any *_STORE or REALTIME_ADAPTER set to memory, CLOUDFRONT_SHARED_SECRET with TRUST_PROXY_HOPS=1.
#
# Data scripts (seed, E2E reset, UAT fixtures) refuse to touch a database that
# is not on this machine, or any database under NODE_ENV=production, unless
# ALLOW_DATA_SCRIPT names it exactly as <host>/<database>.
# ALLOW_DATA_SCRIPT=
