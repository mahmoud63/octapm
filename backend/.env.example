# OctaPM backend environment
#
# Copy to backend/.env and fill in. Keys under "Required" must be set; every
# other section is optional and the feature it names simply stays off until you
# set it. Commented-out lines show the default the code uses.
#
# In production `config/security.js` refuses to boot unless DATABASE_URL,
# JWT_SECRET, JWT_REFRESH_SECRET, ANTHROPIC_API_KEY and CLOUDFRONT_SHARED_SECRET
# are set to non-placeholder values, the three secrets are at least 32
# characters and all different from each other, an https CORS origin is listed,
# and an S3 bucket is configured.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:password@localhost:5432/pmcopilots"
JWT_SECRET="your-secret-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
CLOUDFRONT_SHARED_SECRET="development-only-change-in-production"

# ---------------------------------------------------------------------------
# Server and URLs
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
# Where the browser app lives. Used to build every link in an email,
# notification, QR code and portal invitation.
WEB_APP_URL="http://localhost:5173"
# Public origin of this API. Every OAuth and SSO redirect URI is built from it.
# Either spelling works — with or without a trailing /api/v1.
API_BASE_URL="http://localhost:5000"
# APP_NAME="OctaPM"
# Number of proxy hops to trust for the client IP (behind a load balancer).
# TRUST_PROXY_HOPS=1

JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
# PASSWORD_RESET_TOKEN_MINUTES=60
# INVITATION_TOKEN_DAYS=7

# ---------------------------------------------------------------------------
# Shared state and background jobs
# ---------------------------------------------------------------------------
# REDIS_URL shares rate-limit counters across API instances; unset = in-memory.
REDIS_URL=""
REALTIME_EMIT_DELAY_MS=150
# Set JOB_WORKER_ENABLED=false on API instances when you run dedicated workers
# with `npm run worker --workspace=backend`.
JOB_WORKER_ENABLED=true
JOB_WORKER_CONCURRENCY=2
JOB_POLL_INTERVAL_MS=2000
JOB_HEARTBEAT_MS=15000
JOB_STALE_MS=300000
JOB_TTL_MS=604800000
# JOB_RECOVER_INTERVAL_MS=60000
# JOB_PRUNE_INTERVAL_MS=3600000

# Periodic schedulers. Each is on unless set to false; all are off under test.
# DAILY_LOG_SCHEDULER_ENABLED=true      # weather fill + daily log distribution
# REPORT_SCHEDULER_ENABLED=true         # scheduled report delivery
# WORKFLOW_SCHEDULER_ENABLED=true       # workflow step escalation
# ACCOUNTING_SCHEDULER_ENABLED=true     # accounting payment polling
# ACCOUNTING_POLL_INTERVAL_MS=900000

# ---------------------------------------------------------------------------
# Rate limits (window in ms, max requests per window)
# ---------------------------------------------------------------------------
# RATE_LIMIT_API_WINDOW_MS / RATE_LIMIT_API_MAX
# RATE_LIMIT_AUTH_WINDOW_MS / RATE_LIMIT_AUTH_MAX
# RATE_LIMIT_LOGIN_WINDOW_MS / RATE_LIMIT_LOGIN_MAX
# RATE_LIMIT_REFRESH_WINDOW_MS / RATE_LIMIT_REFRESH_MAX
# RATE_LIMIT_UPLOAD_WINDOW_MS / RATE_LIMIT_UPLOAD_MAX
# RATE_LIMIT_AI_WINDOW_MS / RATE_LIMIT_AI_MAX
# RATE_LIMIT_BILLING_WINDOW_MS / RATE_LIMIT_BILLING_MAX
# RATE_LIMIT_STRIPE_WEBHOOK_WINDOW_MS / RATE_LIMIT_STRIPE_WEBHOOK_MAX

# ---------------------------------------------------------------------------
# AI provider
# ---------------------------------------------------------------------------
# The first provider with a key wins unless AI_PROVIDER names one:
# anthropic | openai | gemini. Without a key every AI feature degrades to its
# deterministic result and says so, rather than failing.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GEMINI_API_KEY=your-key-here
# AI_MODEL=                             # overrides the provider's default model
# AI_VISION=off                         # keeps prompts text-only
# AI_TRANSCRIPTION=off                  # disables voice notes (needs OPENAI_API_KEY)
# AI_TRANSCRIPTION_MODEL=whisper-1
# AI_RETRY_BASE_MS=1000

# Per-feature limits.
# AI_MAX_PHOTOS=8                       # photos per daily-log draft
# AI_PHOTO_BATCH=10                     # photos per batch analysis
# AI_PHOTO_AUTO=on                      # analyse photos as they are uploaded
# AI_DRAWING_PAGES=8                    # sheets per title-block read (1-12)
# AI_CONTRACT_WINDOWS=8                 # text windows per clause extraction
# AI_SPEC_CHARS=12000                   # spec section window for conflicts
# AI_SPEC_SHEETS=6                      # drawings compared per spec section

# Document embeddings for semantic search (optional; keyword search works
# without it): openai | gemini | voyage, with the matching key.
# EMBEDDINGS_PROVIDER=
# VOYAGE_API_KEY=

# ---------------------------------------------------------------------------
# File storage
# ---------------------------------------------------------------------------
# A configured bucket selects S3; FILE_STORAGE_DRIVER=local forces local disk
# even when a bucket is set. Production refuses to boot without a bucket.
# FILE_STORAGE_DRIVER=local
# FILE_STORAGE_LOCAL_DIR=./uploads
FILE_STORAGE_S3_BUCKET=pmcopilots-uploads
FILE_STORAGE_S3_REGION=me-south-1
AWS_ACCESS_KEY_ID=your-key
AWS_SECRET_ACCESS_KEY=your-secret
# AWS_SESSION_TOKEN=
# FILE_PRESIGNED_URL_TTL_SECONDS=300
# FILE_UPLOAD_TMP_DIR=
# SITE_REPORT_UPLOAD_DIR=
# WORKFLOW_UPLOAD_DIR=

# IFC model upload ceiling and the element cap per model.
# BIM_MAX_BYTES=314572800               # 300 MB
# BIM_MAX_ELEMENTS=250000

# ---------------------------------------------------------------------------
# Outbound email
# ---------------------------------------------------------------------------
# Notifications and digests POST to this webhook; without it they are recorded
# in the app but never sent.
# EMAIL_WEBHOOK_URL=
# EMAIL_WEBHOOK_TOKEN=

# ---------------------------------------------------------------------------
# Inbound email (reply to a notification and it lands on the record)
# ---------------------------------------------------------------------------
# The domain your mail provider routes to POST /api/v1/public/inbound-email.
# INBOUND_EMAIL_DOMAIN=inbox.example.com
# Signs the reply-to addresses. Falls back to JWT_SECRET; set it separately so
# rotating one does not break the other.
# INBOUND_EMAIL_SECRET=
# Shared token the provider sends as ?token=, X-Inbound-Token or basic auth.
# INBOUND_EMAIL_WEBHOOK_TOKEN=
# Mailgun signs instead; set its signing key to verify that way.
# INBOUND_MAILGUN_SIGNING_KEY=

# ---------------------------------------------------------------------------
# Single sign-on and two-factor authentication
# ---------------------------------------------------------------------------
# Encrypts TOTP secrets. Falls back to INTEGRATION_SECRET_KEY then JWT_SECRET.
# Set it before anyone enrols: changing it later locks out every enrolled user.
# MFA_SECRET_KEY=
# MFA_ISSUER=OctaPM                     # the name shown in the authenticator app
# Must match the redirect URI registered with the identity provider. Defaults
# to `${API_BASE_URL}/api/v1/auth/sso/callback`, which is where the route lives.
# SSO_REDIRECT_URI=

# ---------------------------------------------------------------------------
# Web push (PWA notifications)
# ---------------------------------------------------------------------------
# Generate with `npx web-push generate-vapid-keys`.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# Public API, webhooks and accounting connectors
# ---------------------------------------------------------------------------
# Encrypts stored OAuth tokens. Required before connecting an accounting system.
# INTEGRATION_SECRET_KEY=
# WEBHOOK_ALLOW_HTTP=false              # true only for local webhook testing
# Defaults to `${API_BASE_URL}/api/v1/integrations/accounting/{provider}/callback`.
# ACCOUNTING_REDIRECT_URI=
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_ENVIRONMENT=sandbox               # sandbox | production
# XERO_CLIENT_ID=
# XERO_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Vendor portals
# ---------------------------------------------------------------------------
# How long an RFQ link stays valid. The token rotates on every reminder.
# RFQ_LINK_DAYS=45

# ---------------------------------------------------------------------------
# Weather feed (Open-Meteo, no key needed)
# ---------------------------------------------------------------------------
# WEATHER_FEED_ENABLED=true
# WEATHER_FEED_FORECAST_URL=
# WEATHER_FEED_ARCHIVE_URL=
# WEATHER_FEED_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Billing
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_change_me"
STRIPE_PRICE_INDIVIDUAL_MONTHLY="price_change_me"
STRIPE_PRICE_INDIVIDUAL_ANNUAL="price_change_me"
STRIPE_PRICE_BUSINESS_MONTHLY="price_change_me"
STRIPE_PRICE_BUSINESS_ANNUAL="price_change_me"
