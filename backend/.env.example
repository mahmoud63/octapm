DATABASE_URL="postgresql://postgres:password@localhost:5432/pmcopilots"
JWT_SECRET="your-secret-key-change-this"
JWT_REFRESH_SECRET="your-refresh-secret-change-this"
JWT_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"
PORT=5000
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
CORS_ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"
CLOUDFRONT_SHARED_SECRET="development-only-change-in-production"

# AI Provider (primary)
AI_PROVIDER=claude
ANTHROPIC_API_KEY=your-key-here

# AI Provider (fallback)
OPENAI_API_KEY=your-key-here

# File Storage
S3_BUCKET=pmcopilots-uploads
S3_REGION=me-south-1
S3_ACCESS_KEY=your-key
S3_SECRET_KEY=your-secret

# Billing
STRIPE_SECRET_KEY="sk_test_change_me"
STRIPE_WEBHOOK_SECRET="whsec_change_me"
STRIPE_PRICE_INDIVIDUAL_MONTHLY="price_change_me"
STRIPE_PRICE_INDIVIDUAL_ANNUAL="price_change_me"
STRIPE_PRICE_BUSINESS_MONTHLY="price_change_me"
STRIPE_PRICE_BUSINESS_ANNUAL="price_change_me"
