  charStart      Int      @default(0)
  charEnd        Int      @default(0)
  embedding      Float[]  @default([])
  createdAt      DateTime @default(now())

  org          Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentText DocumentText    @relation(fields: [documentTextId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([orgId])
  @@index([projectId, documentId])
  @@index([documentTextId])
}

// â”€â”€â”€ Comments, @mentions and record subscriptions (OCTA-COMM-COMMENT-009) â”€â”€â”€
model Comment {
  id         String    @id @default(uuid())
  orgId      String
  projectId  String
  recordType String
  recordId   String
  parentId   String?
  authorId   String?
  body       String
  editedAt   DateTime?
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org      Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  author   User?            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent   Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[]        @relation("CommentReplies")
  mentions CommentMention[]

  @@index([orgId])
  @@index([projectId, recordType, recordId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model CommentMention {
  id        String   @id @default(uuid())
  orgId     String
  commentId String
  userId    String
  createdAt DateTime @default(now())

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  comment Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation("CommentMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([orgId])
  @@index([userId])
}

model RecordSubscription {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  recordType String
  recordId   String
  userId     String
  reason     String   @default("manual") // manual, created, commented, mentioned, assigned
  muted      Boolean  @default(false) // explicit unfollow; automatic rules never re-follow a muted row
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  user    User         @relation("RecordSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordType, recordId, userId])
  @@index([orgId])
  @@index([projectId, recordType, recordId])
  @@index([userId, muted])
}

// â”€â”€â”€ Permission templates (per-tool levels + granular grants) â”€â”€â”€
model PermissionTemplate {
  id            String   @id @default(uuid())
  orgId         String
  name          String
  description   String?
  kind          String   @default("internal") // internal (own staff), external (collaborators)
  clientType    String? // gc, owner, consultant, subcontractor â€” which customer type this default suits
  baseRole      String? // internal role whose policy defines the "standard" level
  basePartyRole String? // party role whose policy defines the "standard" level (external templates)
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false) // seeded; cannot be deleted
  status        String   @default("active") // active, archived
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org             Organisation              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tools           PermissionTemplateTool[]
  grants          PermissionTemplateGrant[]
  userPermissions ProjectUserPermission[]
  projectParties  ProjectParty[]

  @@unique([orgId, name])
  @@unique([id, orgId]) // target for composite tenant foreign keys (M7)
  @@index([orgId, status])
  @@index([orgId, kind, clientType])
}

model PermissionTemplateTool {
  id         String @id @default(uuid())
  templateId String
  module     String // key from shared/permissions.json modules
  level      String @default("standard") // none, read_only, standard, admin

  template PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, module])
  @@index([templateId])
}

model PermissionTemplateGrant {
  id         String  @id @default(uuid())
  templateId String
  module     String
  action     String? // one of the policy actions
  transition String? // one of the module transitions
  key        String // "<module>|action:<action>" or "<module>|transition:<transition>"

  template PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

model ProjectUserPermission {
  id            String   @id @default(uuid())
  orgId         String
  projectId     String
  userId        String
  templateId    String?
  overridesJson Json     @default("{}") // { tools: { module: level }, grants: [key] }
  assignedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org      Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  user     User                @relation("ProjectUserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  template PermissionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  membership OrganizationMembership @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@index([orgId])
  @@index([userId])
  @@index([templateId])
}

// â”€â”€â”€ Background jobs (durable queue; claimed with SKIP LOCKED) â”€â”€â”€
model BackgroundJob {
  id           String    @id @default(uuid())
  orgId        String
  projectId    String?
  type         String // boq.parse, schedule.generate, schedule.import, document.extract, report.render, notification.deliver
  status       String    @default("queued") // queued, running, succeeded, failed, cancelled
  priority     Int       @default(0)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  payloadJson  Json      @default("{}")
  progressJson Json      @default("{}")
  resultJson   Json?
  errorCode    String?
  errorMessage String?
  errorJson    Json?
  requestedBy  String?
  lockedBy     String?
  lockedAt     DateTime?
  heartbeatAt  DateTime?
  runAfter     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  expiresAt    DateTime?
  // Scalar only, no relation: this table keeps rows of deleted organisations
  // (matrix doc §3.3) and never gets a tenant-side foreign key.
  membershipId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, runAfter, priority])
  @@index([orgId, projectId, createdAt])
  @@index([projectId, type, status])
  @@index([status, heartbeatAt])
  @@index([expiresAt])
}

// â”€â”€â”€ Outbound domain events (realtime fan-out and future webhooks) â”€â”€â”€
model OutboundEvent {
  id               String    @id @default(uuid())
  orgId            String
  projectId        String?
  type             String // record.changed, approval.decided, notification.created, job.progress
  entityType       String?
  entityId         String?
  action           String?
  actorId          String?
  occurredAt       DateTime  @default(now())
  payloadJson      Json      @default("{}")
  recipientUserIds Json      @default("[]")
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([type, createdAt])
}

// â”€â”€â”€ Checklist / template engine (OCTA-QA-TEMPLATE-014) â”€â”€â”€
// A template (company-wide when projectId is null, or per project) is a list
// of sections and items; an instance is one filled-in copy tied to an
// activity / location / drawing. ITP hold-point items block progress
// approval on their activity until they pass.
model FormTemplate {
  id               String   @id @default(uuid())
  orgId            String
  projectId        String?
  sourceTemplateId String?
  type             String   @default("inspection") // inspection, itp, form, talk
  name             String
  description      String?
  trade            String?
  version          Int      @default(1)
  status           String   @default("active") // draft, active, archived
  isSystem         Boolean  @default(false)
  settingsJson     Json     @default("{}") // { requireSignatures: ["inspector"], deficiencyTarget: "punch_item", instructions }
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org       Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?       @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  sections  FormSection[]
  items     FormItem[]
  instances FormInstance[]

  @@unique([id, orgId]) // target for composite tenant foreign keys (M7)
  @@index([orgId, projectId, type, status])
  @@index([projectId, status])
}

model FormSection {
  id          String  @id @default(uuid())
  templateId  String
  title       String
  description String?
  sortOrder   Int     @default(0)

  template FormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  items    FormItem[]

  @@index([templateId, sortOrder])
}

model FormItem {
  id                  String   @id @default(uuid())
  templateId          String
  sectionId           String
  sortOrder           Int      @default(0)
  label               String
  description         String?
  responseType        String   @default("pass_fail") // pass_fail, yes_no, checkbox, text, number, choice, date, photo, signature
  required            Boolean  @default(true)
  photoRequired       Boolean  @default(false)
  isHoldPoint         Boolean  @default(false)
  inspectionPointType String? // hold, witness, review
  optionsJson         Json? // choice: ["A","B"]; number: { min, max, unit }
  reference           String? // spec clause / drawing
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  template  FormTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section   FormSection        @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  responses FormItemResponse[]
  signatures Signature[]

  @@index([templateId])
  @@index([sectionId, sortOrder])
}

model FormInstance {
  id                String    @id @default(uuid())
  orgId             String
  projectId         String
  templateId        String
  templateVersion   Int       @default(1)
  number            Int
  ref               String // INS-001, ITP-001, FRM-001, TBT-001
  type              String
  title             String
  status            String    @default("scheduled") // scheduled, in_progress, complete, closed, void
  outcome           String? // pass, fail, incomplete
  activityId        String?
  locationId        String?
  sheetId           String?
  assigneeUserId    String?
  assigneeCompanyId String?
  inspectorUserId   String?
  approverUserId    String?
  ballInCourtUserId String?
  scheduledFor      DateTime?
  dueDate           DateTime?
  recurrenceJson    Json? // { every: "day"|"week"|"month", interval, until }
  startedAt         DateTime?
  completedAt       DateTime?
  completedBy       String?
  closedAt          DateTime?
  closedBy          String?
  reopenReason      String?
  summaryJson       Json? // { total, answered, passed, failed, na, deficient, holdPointsOpen }
  clientRequestId   String?
  clientCreatedAt   DateTime?
  deviceId          String?
  legacyItpId       String?   @unique
  createdBy         String?
  updatedBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org             Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  template        FormTemplate       @relation(fields: [templateId], references: [id], onDelete: Restrict)
  activity        Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  location        Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sheet           Sheet?             @relation(fields: [sheetId], references: [id], onDelete: SetNull)
  assigneeUser    User?              @relation("FormAssigneeUser", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  assigneeCompany Company?           @relation("FormAssigneeCompany", fields: [assigneeCompanyId], references: [id], onDelete: SetNull)
  inspectorUser   User?              @relation("FormInspectorUser", fields: [inspectorUserId], references: [id], onDelete: SetNull)
  approverUser    User?              @relation("FormApproverUser", fields: [approverUserId], references: [id], onDelete: SetNull)
  ballInCourtUser User?              @relation("FormBallInCourtUser", fields: [ballInCourtUserId], references: [id], onDelete: SetNull)
  responses       FormItemResponse[]
  signatures      Signature[]

  @@unique([projectId, ref])
  @@unique([projectId, clientRequestId])
  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, type, status])
  @@index([projectId, activityId, type])
  @@index([projectId, scheduledFor])
  @@index([templateId])
  @@index([assigneeUserId])
  @@index([ballInCourtUserId])
  @@index([assigneeCompanyId])
}

model FormItemResponse {
  id                   String    @id @default(uuid())
  instanceId           String
  itemId               String
  value                String? // pass|fail|na, yes|no|na, checked|unchecked, text, number, choice, ISO date
  numberValue          Float?
  note                 String?
  isDeficient          Boolean   @default(false)
  deficiencyRecordType String? // punch_item, observation
  deficiencyRecordId   String?
  answeredBy           String?
  answeredAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  instance FormInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  item     FormItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([instanceId, itemId])
  @@index([itemId])
  @@index([deficiencyRecordType, deficiencyRecordId])
}

model Signature {
  id            String   @id @default(uuid())
  orgId         String
  projectId     String
  recordType    String   @default("form_instance")
  recordId      String
  instanceId    String?
  itemId        String?
  role          String // inspector, approver, subcontractor, witness, attendee
  userId        String?
  signerName    String
  signerCompany String?
  documentId    String?
  signedAt      DateTime @default(now())
  ipAddress     String?
  userAgent     String?

  instance FormInstance?    @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  item     FormItem?        @relation(fields: [itemId], references: [id], onDelete: SetNull)
  user     User?            @relation("SignatureUser", fields: [userId], references: [id], onDelete: SetNull)
  document ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@index([recordType, recordId])
  @@index([projectId])
  @@index([instanceId])
}

// â”€â”€â”€ Submittal packages, workflow templates and steps (OCTA-PM-SUB-017) â”€â”€â”€
model SubmittalPackage {
  id             String    @id @default(uuid())
  orgId          String
  projectId      String
  number         Int
  ref            String // PKG-001
  name           String
  description    String?
  status         String    @default("open") // open, submitted, closed
  activityId     String?
  requiredOnSite DateTime?
  managerUserId  String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  activity    Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  managerUser User?        @relation("SubmittalPackageManager", fields: [managerUserId], references: [id], onDelete: SetNull)
  submittals  Submittal[]

  @@unique([projectId, ref])
  @@index([projectId, status])
  @@index([orgId])
}

// A review route: ordered steps, each sequential (one approver) or parallel
// (everyone must approve; the first rejection stops the step), assigned to
// users, party roles or project roles, with days allowed per step.
model SubmittalWorkflowTemplate {
  id          String   @id @default(uuid())
  orgId       String
  projectId   String?
  name        String
  description String?
  isDefault   Boolean  @default(false)
  status      String   @default("active") // active, archived
  stepsJson   Json     @default("[]") // [{ name, mode, days, assignees: [{ type: user|party_role|role, userId?, role? }] }]
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  submittals Submittal[]

  @@index([orgId, projectId, status])
}

model SubmittalStep {
  id             String    @id @default(uuid())
  submittalId    String
  revisionNumber Int       @default(0)
  sortOrder      Int       @default(0)
  name           String
  mode           String    @default("sequential") // sequential, parallel
  days           Int       @default(7)
  status         String    @default("pending") // pending, active, approved, rejected, skipped
  startedAt      DateTime?
  dueAt          DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  submittal   Submittal                 @relation(fields: [submittalId], references: [id], onDelete: Cascade)
  assignments SubmittalStepAssignment[]

  @@index([submittalId, revisionNumber, sortOrder])
  @@index([status, dueAt])
}

model SubmittalStepAssignment {
  id           String    @id @default(uuid())
  stepId       String
  userId       String
  role         String? // how the person was resolved: user, consultant, pmâ€¦
  status       String    @default("pending") // pending, approved, rejected, skipped
  responseCode String?
  comment      String?
  decidedAt    DateTime?
  createdAt    DateTime  @default(now())

  step SubmittalStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  user User          @relation("SubmittalStepAssignee", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([stepId, userId])
  @@index([userId, status])
}

// â”€â”€â”€ Daily log (OCTA-FLD-DAILY-022) â”€â”€â”€
/**
 * One log per project per calendar day. Sections are typed tables so manpower
 * and equipment are reportable across days; weather comes from the feed by
 * project coordinates or is entered by hand; the evening PDF goes to the
 * distribution list.
 */
model DailyLog {
  id                      String    @id @default(uuid())
  orgId                   String
  projectId               String
  date                    DateTime  @db.Date
  status                  String    @default("open") // open, submitted, approved
  weatherJson             Json?
  weatherSource           String? // feed, manual
  weatherFetchedAt        DateTime?
  summary                 String?
  submittedAt             DateTime?
  submittedBy             String?
  approvedAt              DateTime?
  approvedBy              String?
  distributedAt           DateTime?
  distributionJson        Json?
  pdfDocumentId           String?
  autoDistributeQueuedFor DateTime?
  createdBy               String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  org         Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  pdfDocument ProjectDocument? @relation("DailyLogPdf", fields: [pdfDocumentId], references: [id], onDelete: SetNull)
  manpower    DailyLogManpower[]
  equipment   DailyLogEquipment[]
  deliveries  DailyLogDelivery[]
  visitors    DailyLogVisitor[]
  delays      DailyLogDelay[]
  notes       DailyLogNote[]
  quantities  DailyLogQuantity[]
  quantityProgressEntries QuantityProgressEntry[]
  changeEvents ChangeEvent[]

  @@unique([projectId, date])
  @@index([orgId])
  @@index([projectId, status])
}

/** Crew on site: company Ã— trade Ã— head count Ã— hours per head. */
model DailyLogManpower {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  companyId       String?
  companyName     String?
  trade           String
  workers         Int       @default(0)
  hours           Float     @default(8)
  activityId      String?
  locationId      String?
  notes           String?
  status          String    @default("approved") // draft, submitted, approved, rejected
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, clientRequestId])
  @@index([dailyLogId])
  @@index([projectId, companyId])
  @@index([projectId, trade])
  @@index([projectId, activityId])
}

model DailyLogEquipment {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  companyId       String?
  equipmentId     String?
  name            String
  count           Int       @default(1)
  hoursOperated   Float     @default(0)
  hoursIdle       Float     @default(0)
  activityId      String?
  locationId      String?
  notes           String?
  status          String    @default("approved")
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, clientRequestId])
  @@index([dailyLogId])
  @@index([projectId, equipmentId])
  @@index([projectId, activityId])
}

model DailyLogDelivery {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  companyId       String?
  supplierName    String?
  description     String
  quantity        Float?
  unit            String?
  poRef           String?
  receivedBy      String?
  deliveredAt     DateTime?
  activityId      String?
  notes           String?
  status          String    @default("approved")
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

