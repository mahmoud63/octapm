  reviewerParty ProjectParty? @relation("RfiReviewerParty", fields: [reviewerPartyId], references: [id], onDelete: SetNull)
  approverParty ProjectParty? @relation("RfiApproverParty", fields: [approverPartyId], references: [id], onDelete: SetNull)
