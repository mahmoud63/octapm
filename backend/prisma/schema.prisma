// ─── Subscription & Billing ───
model Subscription {
  id                   String    @id @default(uuid())
  orgId                String    @unique
  plan                 String    @default("trial") // trial, individual, business, enterprise
  billingCycle         String? // monthly, annual
  status               String    @default("incomplete") // incomplete, trialing, active, past_due, canceled, expired
  seats                Int       @default(1)
  trialStartsAt        DateTime?
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  canceledAt           DateTime?
  aiGenerationsUsed    Int       @default(0)
  periodResetAt        DateTime?
  reminderDay5SentAt   DateTime?
  reminderDay7SentAt   DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org            Organisation    @relation(fields: [orgId], references: [id])
  paymentMethods PaymentMethod[]
  invoices       Invoice[]

  @@index([status])
  @@index([trialEndsAt])
}

model PaymentMethod {
  id                    String   @id @default(uuid())
  subscriptionId        String
  stripePaymentMethodId String
  brand                 String?
  last4                 String?
  expMonth              Int?
  expYear               Int?
  isDefault             Boolean  @default(true)
  createdAt             DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model Invoice {
  id              String   @id @default(uuid())
  subscriptionId  String
  description     String
  amount          Decimal  @default(0) @db.Decimal(18, 2)
  currency        String   @default("USD")
  status          String   @default("paid") // paid, failed
  periodLabel     String?
  stripeInvoiceId String?
  createdAt       DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
}

model EnterpriseLead {
  id        String   @id @default(uuid())
  orgId     String
  seatsBand String // lte_100, gt_100
  status    String   @default("new") // new, contacted, closed
  createdAt DateTime @default(now())

  org Organisation @relation(fields: [orgId], references: [id])

  @@index([orgId])
}

// ─── Locations (spatial key for field records) ───
model Location {
  id          String    @id @default(uuid())
  orgId       String
  projectId   String
  parentId    String?
  name        String
  code        String?
  kind        String    @default("area") // site, building, level, zone, room, area, external
  path        String // materialized path of ids: rootId/childId/grandchildId
  depth       Int       @default(0)
  sortOrder   Int       @default(0)
  status      String    @default("active") // active, archived
  description String?
  createdBy   String?
  updatedBy   String?
  archivedAt  DateTime?
  archivedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent   Location?    @relation("LocationChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children Location[]   @relation("LocationChildren")
  photos   Photo[]
  sheets   Sheet[]

  @@unique([projectId, code])
  @@index([orgId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, parentId, sortOrder])
  @@index([parentId])
  @@index([projectId, path])
}

// ─── Company workspace masters (OCTA-ADM-COMPANY-007) ───
// Defined once per organisation and reused on every project.
model CostCode {
  id          String   @id @default(uuid())
  orgId       String
  code        String
  name        String
  description String?
  category    String   @default("other") // labour, material, equipment, subcontract, indirect, overhead, contingency, other
  parentId    String?
  sortOrder   Int      @default(0)
  status      String   @default("active") // active, archived
  createdBy   String?
  updatedBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  parent   CostCode?    @relation("CostCodeChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children CostCode[]   @relation("CostCodeChildren")

  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([parentId])
}

model CompanyEquipment {
  id        String   @id @default(uuid())
  orgId     String
  name      String
  category  String?
  rateType  String   @default("daily") // hourly, daily
  rate      Decimal  @default(0) @db.Decimal(18, 2)
  notes     String?
  status    String   @default("active") // active, archived
  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org       Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  equipment Equipment[]

  @@unique([orgId, name])
  @@index([orgId, status])
}

model ProjectTemplate {
  id              String   @id @default(uuid())
  orgId           String
  name            String
  description     String?
  settingsJson    Json     @default("{}") // project field defaults (type, contractType, currency, calendar, retention, …)
  partiesJson     Json     @default("[]") // [{ role, companyId?, companyName?, accessLevel?, permissionTemplateId? }]
  foldersJson     Json     @default("[]") // ["Contract", "Drawings/IFC", …]
  locationsJson   Json     @default("[]") // [{ name, kind, code?, children: [...] }]
  assignmentsJson Json     @default("[]") // [{ userId, role, permissionTemplateId? }]
  isDefault       Boolean  @default(false)
  status          String   @default("active") // active, archived
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([orgId, name])
  @@index([orgId, status])
}

// ─── Unified attachments and photos (OCTA-DOC-ATTACH-006) ───
// One polymorphic link table for every record type; the file itself is a
// ProjectDocument, so a photo can be attached to many records.
model Attachment {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  recordType String
  recordId   String
  documentId String
  role       String   @default("attachment") // attachment, evidence, photo, reference
  caption    String?
  sortOrder  Int      @default(0)
  source     String   @default("upload") // upload, link, migrated_workflow, migrated_commercial, migrated_task, migrated_photos
  uploadedBy String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([recordType, recordId, documentId])
  @@index([orgId])
  @@index([projectId, recordType, recordId])
  @@index([projectId, documentId])
  @@index([documentId])
}

model Photo {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  documentId      String    @unique
  locationId      String?
  caption         String?
  tags            String[]  @default([])
  takenAt         DateTime?
  latitude        Float?
  longitude       Float?
  altitude        Float?
  cameraMake      String?
  cameraModel     String?
  width           Int?
  height          Int?
  orientation     Int?
  thumbnailKey    String? // ProjectDocument id of the generated thumbnail
  thumbnailStatus String    @default("pending") // pending, ready, unavailable, failed
  exifJson        Json?
  uploadedBy      String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org      Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  location Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId, takenAt])
  @@index([projectId, createdAt])
  @@index([projectId, locationId])
  @@index([projectId, thumbnailStatus])
}

// ─── Drawings tool: sets → sheets → revisions (OCTA-DWG-CORE-011) ───
model DrawingSet {
  id                   String    @id @default(uuid())
  orgId                String
  projectId            String
  setNumber            String
  name                 String
  description          String?
  discipline           String?
  purpose              String? // IFC, IFT, AS_BUILT, TENDER, SHOP
  status               String    @default("draft") // draft, processing, review, published, archived, failed
  sourceDocumentId     String?
  pageCount            Int?
  processedPages       Int       @default(0)
  detectionSummaryJson Json?
  receivedAt           DateTime?
  issuedAt             DateTime?
  uploadedBy           String?
  publishedAt          DateTime?
  publishedBy          String?
  jobId                String?
  error                String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org            Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceDocument ProjectDocument? @relation("DrawingSetSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  revisions      SheetRevision[]

  @@unique([projectId, setNumber])
  @@index([orgId])
  @@index([projectId, status])
  @@index([sourceDocumentId])
}

model Sheet {
  id                String    @id @default(uuid())
  orgId             String
  projectId         String
  number            String
  title             String
  discipline        String?
  locationId        String?
  status            String    @default("current") // current, obsolete
  obsoleteReason    String?
  currentRevisionId String?
  drawingRecordId   String? // legacy DrawingRecord this sheet was migrated from
  sortKey           String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org       Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  location  Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  revisions SheetRevision[]

  @@unique([projectId, number])
  @@index([orgId])
  @@index([projectId, status, sortKey])
  @@index([projectId, discipline])
  @@index([projectId, locationId])
  @@index([drawingRecordId])
}

model SheetRevision {
  id                 String    @id @default(uuid())
  orgId              String
  projectId          String
  sheetId            String?
  setId              String?
  documentId         String
  pageNumber         Int       @default(1)
  number             String?
  title              String?
  revision           String?
  discipline         String?
  status             String    @default("pending_review") // pending_review, published, superseded, rejected
  detectedNumber     String?
  detectedTitle      String?
  detectedRevision   String?
  detectedDiscipline String?
  confidence         Float     @default(0)
  confidenceJson     Json?
  textStatus         String    @default("none") // none, ready, no_text
  widthPt            Float?
  heightPt           Float?
  rotation           Int       @default(0)
  reviewedBy         String?
  reviewedAt         DateTime?
  publishedAt        DateTime?
  publishedBy        String?
  supersededById     String?
  supersededAt       DateTime?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org      Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sheet    Sheet?          @relation(fields: [sheetId], references: [id], onDelete: SetNull)
  set      DrawingSet?     @relation(fields: [setId], references: [id], onDelete: SetNull)
  document ProjectDocument @relation("SheetRevisionDocument", fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([setId, pageNumber])
  @@index([orgId])
  @@index([projectId, status])
  @@index([sheetId, status])
  @@index([documentId])
  @@index([supersededById])
}

// ─── Document text, chunks and embeddings (OCTA-DOC-TEXT-010) ───
model DocumentText {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  documentId      String    @unique
  status          String    @default("pending") // pending, ready, unsupported, failed
  extractor       String? // text, html, spreadsheet, docx, pptx, odf, pdf
  text            String?
  excerpt         String?
  wordCount       Int       @default(0)
  pageCount       Int?
  chunkCount      Int       @default(0)
  embeddingStatus String    @default("none") // none, pending, ready, failed, disabled
  embeddingModel  String?
  embeddingError  String?
  error           String?
  extractedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  // Generated in the migration: to_tsvector('english', left(text, 400000)); GIN indexed.
  searchVector    Unsupported("tsvector")?

  org      Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks   DocumentChunk[]

  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, embeddingStatus])
}

model DocumentChunk {
  id             String   @id @default(uuid())
  orgId          String
  projectId      String
  documentId     String
  documentTextId String
  index          Int
  text           String
  charStart      Int      @default(0)
  charEnd        Int      @default(0)
  embedding      Float[]  @default([])
  createdAt      DateTime @default(now())

  org          Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  document     ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentText DocumentText    @relation(fields: [documentTextId], references: [id], onDelete: Cascade)

  @@unique([documentId, index])
  @@index([orgId])
  @@index([projectId, documentId])
  @@index([documentTextId])
}

// ─── Comments, @mentions and record subscriptions (OCTA-COMM-COMMENT-009) ───
model Comment {
  id         String    @id @default(uuid())
  orgId      String
  projectId  String
  recordType String
  recordId   String
  parentId   String?
  authorId   String?
  body       String
  editedAt   DateTime?
  deletedAt  DateTime?
  deletedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org      Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author   User?            @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  parent   Comment?         @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies  Comment[]        @relation("CommentReplies")
  mentions CommentMention[]

  @@index([orgId])
  @@index([projectId, recordType, recordId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model CommentMention {
  id        String   @id @default(uuid())
  orgId     String
  commentId String
  userId    String
  createdAt DateTime @default(now())

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  comment Comment      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User         @relation("CommentMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([orgId])
  @@index([userId])
}

model RecordSubscription {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  recordType String
  recordId   String
  userId     String
  reason     String   @default("manual") // manual, created, commented, mentioned, assigned
  muted      Boolean  @default(false) // explicit unfollow; automatic rules never re-follow a muted row
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User         @relation("RecordSubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([recordType, recordId, userId])
  @@index([orgId])
  @@index([projectId, recordType, recordId])
  @@index([userId, muted])
}

// ─── Permission templates (per-tool levels + granular grants) ───
model PermissionTemplate {
  id            String   @id @default(uuid())
  orgId         String
  name          String
  description   String?
  kind          String   @default("internal") // internal (own staff), external (collaborators)
  clientType    String? // gc, owner, consultant, subcontractor — which customer type this default suits
  baseRole      String? // internal role whose policy defines the "standard" level
  basePartyRole String? // party role whose policy defines the "standard" level (external templates)
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false) // seeded; cannot be deleted
  status        String   @default("active") // active, archived
  createdBy     String?
  updatedBy     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org             Organisation              @relation(fields: [orgId], references: [id], onDelete: Cascade)
  tools           PermissionTemplateTool[]
  grants          PermissionTemplateGrant[]
  userPermissions ProjectUserPermission[]
  projectParties  ProjectParty[]

  @@unique([orgId, name])
  @@index([orgId, status])
  @@index([orgId, kind, clientType])
}

model PermissionTemplateTool {
  id         String @id @default(uuid())
  templateId String
  module     String // key from shared/permissions.json modules
  level      String @default("standard") // none, read_only, standard, admin

  template PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, module])
  @@index([templateId])
}

model PermissionTemplateGrant {
  id         String  @id @default(uuid())
  templateId String
  module     String
  action     String? // one of the policy actions
  transition String? // one of the module transitions
  key        String // "<module>|action:<action>" or "<module>|transition:<transition>"

  template PermissionTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([templateId, key])
  @@index([templateId])
}

model ProjectUserPermission {
  id            String   @id @default(uuid())
  orgId         String
  projectId     String
  userId        String
  templateId    String?
  overridesJson Json     @default("{}") // { tools: { module: level }, grants: [key] }
  assignedBy    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org      Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user     User                @relation("ProjectUserPermissionUser", fields: [userId], references: [id], onDelete: Cascade)
  template PermissionTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([projectId, userId])
  @@index([orgId])
  @@index([userId])
  @@index([templateId])
}

// ─── Background jobs (durable queue; claimed with SKIP LOCKED) ───
model BackgroundJob {
  id           String    @id @default(uuid())
  orgId        String
  projectId    String?
  type         String // boq.parse, schedule.generate, schedule.import, document.extract, report.render, notification.deliver
  status       String    @default("queued") // queued, running, succeeded, failed, cancelled
  priority     Int       @default(0)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3)
  payloadJson  Json      @default("{}")
  progressJson Json      @default("{}")
  resultJson   Json?
  errorCode    String?
  errorMessage String?
  errorJson    Json?
  requestedBy  String?
  lockedBy     String?
  lockedAt     DateTime?
  heartbeatAt  DateTime?
  runAfter     DateTime  @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, runAfter, priority])
  @@index([orgId, projectId, createdAt])
  @@index([projectId, type, status])
  @@index([status, heartbeatAt])
  @@index([expiresAt])
}

// ─── Outbound domain events (realtime fan-out and future webhooks) ───
model OutboundEvent {
  id               String    @id @default(uuid())
  orgId            String
  projectId        String?
  type             String // record.changed, approval.decided, notification.created, job.progress
  entityType       String?
  entityId         String?
  action           String?
  actorId          String?
  occurredAt       DateTime  @default(now())
  payloadJson      Json      @default("{}")
  recipientUserIds Json      @default("[]")
  deliveredAt      DateTime?
  createdAt        DateTime  @default(now())

  @@index([orgId, createdAt])
  @@index([projectId, createdAt])
  @@index([entityType, entityId])
  @@index([type, createdAt])
}
