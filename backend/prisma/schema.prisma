  dueAt       DateTime?
  respondedAt DateTime?
  escalatedAt DateTime?
  createdAt   DateTime  @default(now())

  org      Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  instance WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([instanceId, stepKey])
  @@index([userId, status])
  @@index([projectId, status, dueAt])
}

// â”€â”€â”€ Custom fields, fieldsets and record types (OCTA-PLAT-FIELDS-025) â”€â”€â”€â”€â”€â”€

model CustomFieldDefinition {
