  code         String
  name         String
  spec         String?
  unit         String
  category     String?
  supplier     String?
  leadWeeks    Int      @default(0)
  unitCost     Decimal  @default(0) @db.Decimal(18, 2)
  reorderPoint Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project           Project              @relation(fields: [projectId], references: [id])
  supplierRef       ProcurementSupplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  activityMaterials ActivityMaterial[]
  poLines           ProcurementPoLine[]

  @@index([projectId])
  @@index([supplierId])
  @@index([projectId, code])
}

// â”€â”€â”€ Inventory and warehouse (OCTA-INV-STOCK-050) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
//
// MaterialMaster above is a *project's* procurement list: what this job needs
// and from whom. Inventory is the other half â€” what the company physically
// holds, where it is, and what it is worth. The two meet at goods receipt.
//
// The ledger is the source of truth. StockBalance is a running total kept in
// step with it inside the same transaction, so a balance can always be proved
// from the movements that produced it.

/** What the company stocks. Org-level, optionally owned by one project. */
model InventoryItem {
  id                 String   @id @default(uuid())
  orgId              String
  projectId          String? // null = company-owned, available to every project
  sku                String
  barcode            String? // EAN/UPC/Code128 as printed on the label
  qrCode             String? // the token a scanner resolves; defaults to the sku
  name               String
  description        String?
  category           String?
  unit               String
  manufacturer       String?
  model              String?
  specification      String?
  preferredSupplierId String?
  unitCost           Decimal  @default(0) @db.Decimal(18, 4)
  averageCost        Decimal  @default(0) @db.Decimal(18, 4) // weighted average, moved on each receipt
  lastPurchasePrice  Decimal? @db.Decimal(18, 4)
  reorderLevel       Float    @default(0)
  minStock           Float    @default(0)
  maxStock           Float?
  leadTimeDays       Int      @default(0)
  isSerialised       Boolean  @default(false)
  isBatched          Boolean  @default(false)
  status             String   @default("active") // active, archived
  notes              String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org               Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project           Project?             @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  preferredSupplier ProcurementSupplier? @relation(fields: [preferredSupplierId], references: [id], onDelete: SetNull)
  balances          StockBalance[]
  transactions      StockTransaction[]
  transferLines     StockTransferLine[]
  countLines        InventoryCountLine[]
  poLines           ProcurementPoLine[]

  @@unique([orgId, sku])
  @@unique([orgId, barcode])
  @@index([orgId, status])
  @@index([orgId, projectId])
  @@index([orgId, category])
}

/** Somewhere stock is held. A central store, a project store, a site container. */
model Warehouse {
  id          String    @id @default(uuid())
  orgId       String
  projectId   String? // null = central, serving every project
  code        String
  name        String
  kind        String    @default("project") // central, project, site, temporary, equipment_yard
  address     String?
  managerId   String?
  status      String    @default("active") // active, archived
  notes       String?
  createdBy   String?
  updatedBy   String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org           Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project       Project?            @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  manager       User?               @relation("WarehouseManager", fields: [managerId], references: [id], onDelete: SetNull)
  locations     WarehouseLocation[]
  balances      StockBalance[]
  transactions  StockTransaction[]
  transfersOut  StockTransfer[]     @relation("TransferFrom")
  transfersIn   StockTransfer[]     @relation("TransferTo")
  counts        InventoryCount[]

  @@unique([orgId, code])
  @@index([orgId, status])
  @@index([orgId, projectId])
}

/**
 * Where inside a warehouse. Zone â†’ aisle â†’ rack â†’ shelf â†’ bin, held as a
 * materialized path so a whole branch can be read in one query â€” the same
 * shape the project Location tree uses.
 */
model WarehouseLocation {
  id          String    @id @default(uuid())
  orgId       String
  warehouseId String
  parentId    String?
  code        String
  name        String
  kind        String    @default("zone") // zone, aisle, rack, shelf, bin
  path        String // materialized path of ids: zoneId/aisleId/rackIdâ€¦
  depth       Int       @default(0)
  sortOrder   Int       @default(0)
  status      String    @default("active") // active, archived
  createdBy   String?
  updatedBy   String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org          Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  parent       WarehouseLocation?  @relation("WarehouseLocationChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children     WarehouseLocation[] @relation("WarehouseLocationChildren")
  balances     StockBalance[]
  transactions StockTransaction[]
  countLines   InventoryCountLine[]

  @@unique([warehouseId, code])
  @@index([orgId])
  @@index([warehouseId, status])
  @@index([warehouseId, path])
}

/**
 * How much of an item sits in one place, by state.
 *
 * `available` is not stored: it is onHand less what is reserved, and a stored
 * copy would be one more thing to get out of step with the ledger.
 */
model StockBalance {
  id          String   @id @default(uuid())
  orgId       String
  itemId      String
  warehouseId String
  locationId  String?
  onHand      Float    @default(0)
  reserved    Float    @default(0)
  inTransit   Float    @default(0)
  damaged     Float    @default(0)
  quarantined Float    @default(0)
  lastMovedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org       Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item      InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location  WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([itemId, warehouseId, locationId])
  @@index([orgId, itemId])
  @@index([warehouseId])
}

/**
 * Every movement of stock, ever. Append-only: a mistake is corrected with a
 * reversing entry, never by editing history, because this ledger is what a
 * material variance claim is argued from.
 */
model StockTransaction {
  id          String   @id @default(uuid())
  orgId       String
  itemId      String
  warehouseId String
  locationId  String?
  // receipt, issue, return, transfer_out, transfer_in, adjust, count,
  // damage, quarantine, release, reverse
  type        String
  quantity    Float // signed: what this movement did to onHand
  unitCost    Decimal  @default(0) @db.Decimal(18, 4)
  value       Decimal  @default(0) @db.Decimal(18, 2)
  balanceAfter Float   @default(0) // onHand at this location once this posted

  // Where it went, so a cost lands on the right thing.
  projectId          String?
  activityId         String?
  costCodeId         String?
  boqItemId          String?
  locationRefId      String? // the project Location it was installed at
  commitmentId       String?

  // Where it came from.
  poLineId        String?
  receiptLineId   String?
  transferId      String?
  countId         String?
  reversesId      String?

  batchNo    String?
  serialNo   String?
  expiryDate DateTime?
  reference  String?
  notes      String?
  performedBy String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  org         Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  item        InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  location    WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  project     Project?           @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: SetNull)
  activity    Activity?          @relation(fields: [activityId], references: [id], onDelete: SetNull)
  costCode    CostCode?          @relation(fields: [costCodeId], references: [id], onDelete: SetNull)
  boqItem     BoqItem?           @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  transfer    StockTransfer?     @relation(fields: [transferId], references: [id], onDelete: SetNull)
  count       InventoryCount?    @relation(fields: [countId], references: [id], onDelete: SetNull)
  reverses    StockTransaction?  @relation("StockReversal", fields: [reversesId], references: [id], onDelete: SetNull)
  reversedBy  StockTransaction[] @relation("StockReversal")

  @@index([orgId, occurredAt])
  @@index([itemId, occurredAt])
  @@index([warehouseId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([activityId])
  @@index([poLineId])
  @@index([transferId])
}

/** Stock moving between two warehouses, and in transit until it lands. */
model StockTransfer {
  id              String    @id @default(uuid())
  orgId           String
  ref             String
  fromWarehouseId String
  toWarehouseId   String
  status          String    @default("draft") // draft, in_transit, received, cancelled
  reason          String?
  notes           String?
  dispatchedAt    DateTime?
  dispatchedBy    String?
  receivedAt      DateTime?
  receivedBy      String?
  cancelledAt     DateTime?
  cancelledBy     String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  org           Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromWarehouse Warehouse           @relation("TransferFrom", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouse   Warehouse           @relation("TransferTo", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  lines         StockTransferLine[]
  transactions  StockTransaction[]

  @@unique([orgId, ref])
  @@index([orgId, status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferLine {
  id          String   @id @default(uuid())
  orgId       String
  transferId  String
  itemId      String
  quantity    Float    @default(0)
  receivedQty Float    @default(0)
  damagedQty  Float    @default(0)
  batchNo     String?
  serialNo    String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org      Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([itemId])
}

/** A stock take: what the system thinks is there against what someone counted. */
model InventoryCount {
  id          String    @id @default(uuid())
  orgId       String
  warehouseId String
  ref         String
  status      String    @default("open") // open, counting, posted, cancelled
  scope       String    @default("full") // full, cycle, spot
  notes       String?
  startedBy   String?
  startedAt   DateTime  @default(now())
  postedBy    String?
  postedAt    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  org          Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  warehouse    Warehouse            @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  lines        InventoryCountLine[]
  transactions StockTransaction[]

  @@unique([orgId, ref])
  @@index([orgId, status])
  @@index([warehouseId])
}

model InventoryCountLine {
  id         String   @id @default(uuid())
  orgId      String
  countId    String
  itemId     String
  locationId String?
  systemQty  Float    @default(0) // what the ledger said when the line was drawn
  countedQty Float?
  variance   Float    @default(0)
  countedBy  String?
  countedAt  DateTime?
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  count    InventoryCount     @relation(fields: [countId], references: [id], onDelete: Cascade)
  item     InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@unique([countId, itemId, locationId])
  @@index([countId])
  @@index([itemId])
}

// â”€â”€â”€ Equipment â”€â”€â”€
model Equipment {
  id                 String   @id @default(uuid())
  projectId          String
  companyEquipmentId String? // org-level master (CompanyEquipment)
  name               String
  rateType           String
  rate               Decimal  @default(0) @db.Decimal(18, 2)
  createdAt          DateTime @default(now())

  project           Project                  @relation(fields: [projectId], references: [id])
  companyEquipment  CompanyEquipment?        @relation(fields: [companyEquipmentId], references: [id], onDelete: SetNull)
  activityEquipment ActivityEquipment[]
  usages            ActivityEquipmentUsage[]

  @@index([projectId])
  @@index([companyEquipmentId])
}

model ActivityEquipment {
  id          String @id @default(uuid())
  activityId  String
  equipmentId String

  activity  Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@unique([activityId, equipmentId])
  @@index([activityId])
  @@index([equipmentId])
}

model ActivityEquipmentUsage {
  id              String    @id @default(uuid())
  projectId       String
  activityId      String
  equipmentId     String?
  dailyReportId   String?
  sourceLineIndex Int?
  equipmentName   String
  hours           Float     @default(0)
  rateType        String?
  rate            Decimal   @default(0) @db.Decimal(18, 2)
  costAmount      Decimal   @default(0) @db.Decimal(18, 2)
  usageDate       DateTime  @default(now())
  status          String    @default("approved")
  recordedBy      String?
  approvedBy      String?
  approvedAt      DateTime?
  notes           String?
  createdAt       DateTime  @default(now())

  project     Project      @relation(fields: [projectId], references: [id])
  activity    Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  equipment   Equipment?   @relation(fields: [equipmentId], references: [id], onDelete: SetNull)
  dailyReport DailyReport? @relation(fields: [dailyReportId], references: [id], onDelete: SetNull)

  @@unique([dailyReportId, sourceLineIndex])
  @@index([projectId])
  @@index([activityId])
  @@index([equipmentId])
  @@index([dailyReportId])
  @@index([projectId, activityId])
  @@index([projectId, usageDate])
  @@index([projectId, status])
}

model ActivityMaterial {
  id                   String    @id @default(uuid())
  projectId            String
  activityId           String
  materialMasterId     String?
  supplierId           String?
  procurementPackageId String?
  code                 String?
  name                 String
  spec                 String?
  unit                 String
  qty                  Float     @default(0)
  plannedQty           Float     @default(0)
  requiredDate         DateTime?
  requiredTiming       String    @default("activity_start")
  needOffsetDays       Int       @default(0)
  leadWeeks            Int       @default(0)
  bufferDays           Int       @default(14)
  orderByDate          DateTime?
  receivedQty          Float     @default(0)
  issuedQty            Float     @default(0)
  consumedQty          Float     @default(0)
  wasteQty             Float     @default(0)
  status               String    @default("planned") // planned, ordered, partial, received, issued, consumed, cancelled
  notes                String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project            Project                    @relation(fields: [projectId], references: [id])
  activity           Activity                   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  materialMaster     MaterialMaster?            @relation(fields: [materialMasterId], references: [id], onDelete: SetNull)
  supplier           ProcurementSupplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  procurementPackage ProcurementPackage?        @relation(fields: [procurementPackageId], references: [id], onDelete: SetNull)
  poLines            ProcurementPoLine[]
  receiptLines       DeliveryReceiptLine[]
  usages             ActivityMaterialUsage[]
  leadTimeAlerts     ProcurementLeadTimeAlert[]

  @@index([projectId])
  @@index([activityId])
  @@index([projectId, activityId])
  @@index([materialMasterId])
  @@index([supplierId])
  @@index([procurementPackageId])
  @@index([projectId, status])
  @@index([projectId, requiredDate])
}

model ActivityMaterialUsage {
  id                 String   @id @default(uuid())
  projectId          String
  activityId         String
  activityMaterialId String
  poLineId           String?
  receiptLineId      String?
  dailyReportId      String?
  usedQty            Float    @default(0)
  wasteQty           Float    @default(0)
  usageDate          DateTime @default(now())
  installedLocation  String?
  recordedBy         String?
  notes              String?
  createdAt          DateTime @default(now())

  project          Project              @relation(fields: [projectId], references: [id])
  activity         Activity             @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityMaterial ActivityMaterial     @relation(fields: [activityMaterialId], references: [id], onDelete: Cascade)
  poLine           ProcurementPoLine?   @relation(fields: [poLineId], references: [id], onDelete: SetNull)
  receiptLine      DeliveryReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull)
  dailyReport      DailyReport?         @relation(fields: [dailyReportId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([activityId])
  @@index([activityMaterialId])
  @@index([poLineId])
  @@index([receiptLineId])
  @@index([dailyReportId])
  @@index([projectId, usageDate])
}

model ProcurementLeadTimeAlert {
  id                   String    @id @default(uuid())
  projectId            String
  activityId           String?
  packageId            String?
  orderId              String?
  poLineId             String?
  activityMaterialId   String?
  severity             String
  reason               String
  status               String    @default("open") // open, acknowledged, resolved
  daysAtRisk           Int       @default(0)
  needDate             DateTime?
  orderByDate          DateTime?
  expectedDeliveryDate DateTime?
  acknowledgedBy       String?
  acknowledgedAt       DateTime?
  resolvedBy           String?
  resolvedAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project          Project             @relation(fields: [projectId], references: [id])
  activity         Activity?           @relation(fields: [activityId], references: [id], onDelete: SetNull)
  package          ProcurementPackage? @relation(fields: [packageId], references: [id], onDelete: SetNull)
  order            ProcurementOrder?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  poLine           ProcurementPoLine?  @relation(fields: [poLineId], references: [id], onDelete: Cascade)
  activityMaterial ActivityMaterial?   @relation(fields: [activityMaterialId], references: [id], onDelete: Cascade)

  @@unique([projectId, poLineId])
  @@unique([projectId, activityMaterialId])
  @@unique([projectId, packageId])
  @@index([projectId])
  @@index([activityId])
  @@index([packageId])
  @@index([orderId])
  @@index([poLineId])
  @@index([activityMaterialId])
  @@index([projectId, severity, status])
}

model ResourceAllocation {
