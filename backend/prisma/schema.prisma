// â”€â”€â”€ Bid management (OCTA-PRE-BID-027) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model BidPackage {
  id                  String    @id @default(uuid())
  orgId               String
  projectId           String
  number              Int
  ref                 String // BP-001
  title               String
  description         String?
  instructions        String?
  status              String    @default("draft") // draft, open, closed, awarded, cancelled
  dueAt               DateTime?
  questionsDueAt      DateTime?
  currency            String    @default("USD")
  boqSections         String[]  @default([])
  commitmentType      String    @default("subcontract") // subcontract, purchase_order
  // The procurement package these quotes are being sought for, when the
  // enquiry was started from Procurement rather than Commercial. Nullable:
  // subcontract bidding has no procurement package behind it. Comparing
  // supplier quotes for materials is the same job as levelling subcontract
  // bids, so it uses the same engine rather than a second one
  // (OCTA-PROC-QUOTES-084).
  procurementPackageId String?
  settingsJson        Json      @default("{}")
  createdBy           String?
  updatedBy           String?
  publishedAt         DateTime?
  closedAt            DateTime?
  awardedAt           DateTime?
  awardedBidId        String?
  awardedCommitmentId String?
  softAwardBidId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organisation Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  lines        BidPackageLine[]
  addenda      BidAddendum[]
  invitations  BidInvitation[]
  questions    BidQuestion[]
  bids         Bid[]
  scopeMatrix  ScopeMatrix?
  procurementPackage ProcurementPackage? @relation(fields: [procurementPackageId], references: [id], onDelete: SetNull)

  @@unique([projectId, ref])
  @@index([orgId, status])
  @@index([projectId, status])
  @@index([procurementPackageId])
}

model BidPackageLine {
  id           String   @id @default(uuid())
  orgId        String
  packageId    String
  lineNumber   Int
  boqItemId    String?
  section      String?
  code         String?
  description  String
  unit         String?
  qty          Decimal  @default(1) @db.Decimal(18, 3)
  estimateRate Decimal? @db.Decimal(18, 2) // internal only, never shown to bidders
  budgetLineId String?
  costCodeId   String?
  activityId   String?
  sortOrder    Int      @default(0)
