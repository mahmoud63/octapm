  @@unique([recordId, fieldId])
  @@index([projectId, recordType])
  @@index([orgId, recordType, recordId])
  @@index([valueJson(ops: JsonbPathOps)], type: Gin)
}

// â”€â”€â”€ Public API keys, webhooks and accounting connectors (OCTA-INT-API-026) â”€

