model AssistantMessage {
  id             String   @id @default(uuid())
  orgId          String
  conversationId String
  role           String // user, assistant
  content        String
  citationsJson  Json     @default("[]")
  actionsJson    Json     @default("[]")
  sourcesJson    Json     @default("[]")
