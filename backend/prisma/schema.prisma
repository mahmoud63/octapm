// ─── Project-controls structure (PC-1) ───────────────────────────────────────
// The WBS answers "what part of the scope?" for every BOQ row and activity.
// A node is project-owned and carries orgId with a composite foreign key to
// Project(id, orgId), so Postgres itself refuses a node filed under another
// organisation's project. `path` is a materialised path of ids like Location;
// a move rewrites the subtree's path and depth. A node flagged `isPackage`
// is a work package: the scope one party delivers under one commitment
// (control-model doc §1, decision 3) — no separate entity exists for it.
model WbsNode {
  id           String    @id @default(uuid())
  projectId    String
  orgId        String
  parentId     String?
  code         String
  name         String
  path         String
  depth        Int       @default(0)
  sortOrder    Int       @default(0)
  source       String    @default("manual") // manual, import, ai
  externalId   String? // P6 wbs_id / MSP outline code as imported
  isPackage    Boolean   @default(false)
  ownerPartyId String?
  commitmentId String?
  status       String    @default("active") // active, archived
  createdBy    String?
  updatedBy    String?
  archivedAt   DateTime?
  archivedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  parent   WbsNode?     @relation("WbsNodeChildren", fields: [parentId], references: [id], onDelete: Restrict)
  children WbsNode[]    @relation("WbsNodeChildren")
  activities Activity[]
  boqItems   BoqItem[]
  changeOrders      ChangeOrder[]
  projectExceptions ProjectException[]

  @@unique([projectId, code])
  @@index([orgId])
  @@index([projectId, path])
  @@index([projectId, parentId, sortOrder])
  @@index([projectId, externalId])
  @@index([parentId])
}

// Units of measure are an organisation master: the codes a bill may be
// priced in, with the spellings that mean the same thing ("M3", "cu.m").
// BoqItem.unit keeps what was typed; BoqItem.unitCode is the match here.
model UnitOfMeasure {
  id          String   @id @default(uuid())
  orgId       String
  code        String
  name        String
  aliasesJson Json     @default("[]")
  dimension   String   @default("count") // length, area, volume, mass, time, count, money
  isSystem    Boolean  @default(false)
  status      String   @default("active") // active, archived
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, code])
  @@index([orgId, status])
}

// â”€â”€â”€ Company workspace masters (OCTA-ADM-COMPANY-007) â”€â”€â”€
// Defined once per organisation and reused on every project.
model CostCode {
  id          String   @id @default(uuid())
  orgId       String
