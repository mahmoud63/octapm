  orgId     String 

  project Project @relation(fields: [projectId, orgId], references: [id, orgId])
  user    User    @relation(fields: [userId], references: [id])
  membership OrganizationMembership @relation(fields: [orgId, userId], references: [orgId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([projectId, userId])
  @@index([userId, projectId])
  @@index([orgId, userId])
