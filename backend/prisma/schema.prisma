  project         Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  reportingPeriod ReportingPeriod? @relation(fields: [reportingPeriodId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId, takenAt])
}

// â”€â”€â”€ Commitments: subcontracts and purchase orders with a schedule of values (OCTA-FIN-COMMIT-020) â”€â”€â”€

model Commitment {
  id                 String    @id @default(uuid())
  orgId              String
  projectId          String
  number             Int
  ref                String
  type               String    @default("subcontract") // subcontract, purchase_order
  title              String
  description        String?
  vendorCompanyId    String?
  projectPartyId     String?
  supplierId         String?
  status             String    @default("draft") // draft, pending, approved, executed, closed, void
  currency           String    @default("USD")
  retentionRate      Float     @default(5)
  paymentTerms       String?
  startDate          DateTime?
  endDate            DateTime?
  insuranceJson      Json      @default("[]") // [{ type, required, documentId, expiresAt, note }]
  executedDocumentId String?
  executedAt         DateTime?
  executedBy         String?
  submittedAt        DateTime?
  submittedBy        String?
  approvedAt         DateTime?
  approvedBy         String?
  closedAt           DateTime?
  closedBy           String?
  voidReason         String?
  notes              String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org               Organisation            @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project           Project                 @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  vendorCompany     Company?                @relation("CommitmentVendor", fields: [vendorCompanyId], references: [id], onDelete: SetNull)
  projectParty      ProjectParty?           @relation(fields: [projectPartyId], references: [id], onDelete: SetNull)
  supplier          ProcurementSupplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  executedDocument  ProjectDocument?        @relation("CommitmentExecutedDocument", fields: [executedDocumentId], references: [id], onDelete: SetNull)
  lines             CommitmentSovLine[]
  changeOrders      CommitmentChangeOrder[]
  procurementOrders ProcurementOrder[]
  payApps           SubPayApp[]
  changeEventLines  ChangeEventLine[]
  rfqs              Rfq[]
  scopeMatrix       ScopeMatrix?
  closeout          SubcontractCloseout?
  evaluation        SubcontractorEvaluation?

  @@unique([projectId, ref])
  @@unique([projectId, type, number])
  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, type])
  @@index([vendorCompanyId])
  @@index([projectPartyId])
}

/** Schedule of values: every line points at a cost code (and budget line) and an activity. */
model CommitmentSovLine {
  id           String   @id @default(uuid())
  orgId        String
  projectId    String
  commitmentId String
  lineNumber   Int
  description  String
  costCodeId   String?
  budgetLineId String?
  boqItemId    String?
  activityId   String?
  unit         String?
  qty          Float    @default(1)
  rate         Decimal  @default(0) @db.Decimal(18, 2)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  notes        String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  commitment Commitment   @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  costCode   CostCode?    @relation(fields: [costCodeId, orgId], references: [id, orgId], onDelete: SetNull)
  budgetLine BudgetLine?  @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  boqItem    BoqItem?     @relation(fields: [boqItemId], references: [id], onDelete: SetNull)
  activity   Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)
  payAppLines SubPayAppLine[]

  @@unique([commitmentId, lineNumber])
  @@index([orgId])
  @@index([projectId, commitmentId])
  @@index([projectId, activityId])
  @@index([budgetLineId])
  @@index([costCodeId])
  @@index([boqItemId])
}

/** A change to a commitment; approved values add to the commitment and the committed cost. */
model CommitmentChangeOrder {
  id                 String    @id @default(uuid())
  orgId              String
  projectId          String
  commitmentId       String
  number             Int
  ref                String
  title              String
  description        String?
  status             String    @default("draft") // draft, pending, approved, rejected, void
  value              Decimal   @default(0) @db.Decimal(18, 2)
  primeChangeOrderId String?
  linesJson          Json      @default("[]") // [{ description, costCodeId, budgetLineId, activityId, amount }]
  submittedAt        DateTime?
  submittedBy        String?
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  rejectedReason     String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org              Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project          Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  commitment       Commitment   @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
