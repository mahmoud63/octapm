  ballInCourtUser User?    @relation("RfiBallInCourtUser", fields: [ballInCourtUserId], references: [id], onDelete: SetNull)
  assigneeCompany Company? @relation("RfiAssigneeCompany", fields: [assigneeCompanyId], references: [id], onDelete: SetNull)

  @@unique([projectId, ref])
  @@index([projectId])
  @@index([projectId, status, archivedAt])
  @@index([projectId, status, createdAt])
  @@index([projectId, priority, createdAt])
  @@index([projectId, dueDate])
  @@index([projectId, updatedAt])
  @@index([ownerPartyId])
  @@index([reviewerPartyId])
  @@index([approverPartyId])
