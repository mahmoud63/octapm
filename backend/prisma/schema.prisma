// â”€â”€â”€ Contract intelligence (OCTA-AI-CONTRACT-032) â”€â”€â”€
/**
 * The contract's key periods and clauses for one project: the form (FIDIC,
 * NEC, JCTâ€¦), notice / particulars / response periods, the contract
 * documents and the clauses extracted from them (confirmed by a person).
 */
model ContractProfile {
  id                   String    @id @default(uuid())
  orgId                String
  projectId            String    @unique
  form                 String    @default("custom") // fidic_1999, fidic_2017, nec4, jct_2016, aia_a201, custom
  delayNoticeDays      Int       @default(28)
  claimParticularsDays Int       @default(42)
  variationNoticeDays  Int       @default(28)
  responseDays         Int       @default(42)
  paymentDays          Int?
  defectsLiabilityDays Int?
  ldCapPct             Float?
  documentIds          Json      @default("[]")
  clausesJson          Json      @default("[]")
  extractedAt          DateTime?
  extractedModel       String?
  confirmedBy          String?
  confirmedAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, orgId])
  @@index([orgId])
}

// â”€â”€â”€ Subcontractor prequalification (OCTA-SUB-PREQUAL-057) â”€â”€â”€
/**
 * One assessment per vendor company, held at the organisation rather than the
 * project: a subcontractor is qualified once and that answer is reused on
 * every project they are invited to.
 *
 * The status a person records is draft, under_review, approved,
 * conditionally_approved or rejected. "Expired" is never stored â€” it is read
 * from validUntil and from the criteria that carry their own expiry, so a
 * qualification granted on a licence that lapses stops counting on the day it
 * lapses rather than on the day somebody notices.
 */
model VendorPrequalification {
  id               String    @id @default(uuid())
  orgId            String
  companyId        String    @unique
  status           String    @default("draft")
  score            Decimal?  @db.Decimal(5, 2)
  recommendation   String? // what the score suggested, kept so a decision against it is visible
  validUntil       DateTime?
  singleAwardLimit Decimal?  @db.Decimal(18, 2)
  conditions       String?
  decisionNote     String?
  submittedAt      DateTime?
  decidedAt        DateTime?
  decidedBy        String?
  createdBy        String?
  updatedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org      Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  criteria PrequalCriterion[]

  @@index([orgId, status])
  @@index([orgId, validUntil])
}

/**
 * One scored line of the assessment. The weights sum to 100, each line is
 * scored out of maxScore, and the qualification score is the weighted total.
 * A line that carries an expiry (insurance, trade licences) also caps the
 * qualification: cover that lapses in March cannot qualify anybody in April.
 */
model PrequalCriterion {
  id         String    @id @default(uuid())
  orgId      String
  prequalId  String
  key        String
  label      String
  category   String    @default("capability")
  weight     Int       @default(10)
  maxScore   Int       @default(5)
  score      Int?
  required   Boolean   @default(true)
  tracksExpiry Boolean @default(false)
  reference  String?
  expiresAt  DateTime?
  note       String?
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  prequalification VendorPrequalification @relation(fields: [prequalId], references: [id], onDelete: Cascade)
  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([prequalId, key])
  @@index([prequalId])
}

// â”€â”€â”€ Subcontractor performance evaluation (OCTA-SUB-PERF-058) â”€â”€â”€
/**
 * How a subcontractor actually performed on one subcontract, and â€” averaged
 * across their subcontracts â€” the history that informs the next time they bid.
 *
 * The counterpart to prequalification. Prequalification asks whether a company
 * can do the work; this asks whether they did. Most of the answer is already
 * in the records â€” the NCRs, the punch list, the safety incidents, the change
 * orders and the closeout handover all name the company they were raised
 * against â€” so most of the score is read rather than rated, and only the two
 * things the system genuinely cannot know are left to a person.
 */
model SubcontractorEvaluation {
  id           String    @id @default(uuid())
  orgId        String
  projectId    String
  commitmentId String    @unique
  companyId    String?
  status       String    @default("draft") // draft, final
  score        Decimal?  @db.Decimal(5, 2)
  wouldReuse   Boolean?
  summary      String?
  evaluatedBy  String?
  evaluatedAt  DateTime?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organisation          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project               @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  commitment Commitment            @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  criteria   EvaluationCriterion[]

  @@index([orgId, companyId, status])
  @@index([projectId])
}

/**
 * One line of the evaluation.
 *
 * A derived line carries no stored score â€” it is recomputed from the records
 * on every read. A row exists for it only to override that reading, which
 * needs a reason: three non-conformances on a forty-storey frame are not
 * three non-conformances on a fit-out, and the count alone cannot tell them
 * apart.
 */
model EvaluationCriterion {
  id             String   @id @default(uuid())
  orgId          String
  evaluationId   String
  key            String
  label          String
  category       String   @default("delivery")
  weight         Int      @default(10)
  maxScore       Int      @default(5)
  score          Int?
  overrideReason String?
  note           String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  evaluation SubcontractorEvaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  org Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([evaluationId, key])
  @@index([evaluationId])
}

// â”€â”€â”€ Cost ledger (OCTA-FIN-LEDGER-059) â”€â”€â”€
/**
 * Every actual cost, once, with its origin attached.
 *
 * Before this table `CostRecord.actual` and `BudgetLine.actual` were
 * incremented at four call sites and could not be reconstructed from anything â€”
 * so a missing contributor was invisible, which is exactly how subcontractor
 * pay applications and material issues came to be absent from actual cost.
 *
 * The ledger is the truth. `CostRecord.actual` and `BudgetLine.actual` remain
 * as materialised projections for query speed, and can be rebuilt from here at
 * any time.
 *
 * `sourceKey` is what makes a posting idempotent: one economic event produces
 * one entry, so a retry, a double click, a repeated webhook or a concurrent
 * approval cannot post twice. Undoing a posting writes a negative entry with
 * `reversalOfId` â€” history is never deleted.
 */
model CostLedgerEntry {
  id           String   @id @default(uuid())
  orgId        String
  projectId    String
  // `${sourceType}:${sourceId}:${sourceLineId ?? "header"}` â€” unique per org.
  // A plain unique over nullable columns would not hold, because Postgres
  // treats NULLs as distinct.
  sourceKey    String
  // direct_cost, timesheet, equipment, sub_pay_app, material_issue, manual,
  // legacy_opening_balance
  sourceType   String
  sourceId     String
  sourceLineId String?
  // Which migration run created this entry, for `legacy_opening_balance` rows
  // (OCTA-FIN-MIGRATE-062). An opening balance is not a transaction and must
  // never pretend to be one — this says which run put it there, so a batch can
  // be found, audited or reversed as a unit.
  batchId      String?
  // Where the cost lands. activityId drives earned value; budgetLineId drives
  // the budget register; both are resolved at posting time and stored, so the
  // entry stays reconcilable even if the source record is later re-pointed.
  activityId   String?
  costCodeId   String?
  budgetLineId String?
  commitmentId String?
  costType     String   @default("other") // labour, material, equipment, subcontract, indirect, overhead, contingency, other
  // Signed. Positive is cost; negative is a reversal.
  amount       Decimal  @db.Decimal(18, 2)
  quantity     Float?
  unitCost     Decimal? @db.Decimal(18, 4)
  // The economic date â€” when the cost was incurred, not when it was keyed in.
  // Drives `CostRecord.actualThroughDate` and therefore official AC.
  incurredOn   DateTime
  postedAt     DateTime @default(now())
  postedBy     String?
  reversalOfId String?
  note         String?
  createdAt    DateTime @default(now())

  org        Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  activity   Activity?        @relation(fields: [activityId], references: [id], onDelete: SetNull)
  budgetLine BudgetLine?      @relation(fields: [budgetLineId], references: [id], onDelete: SetNull)
  reversalOf CostLedgerEntry? @relation("CostLedgerReversal", fields: [reversalOfId], references: [id], onDelete: SetNull)
  reversedBy CostLedgerEntry[] @relation("CostLedgerReversal")

  @@unique([orgId, sourceKey])
  @@index([projectId, incurredOn])
  @@index([projectId, sourceType])
  @@index([batchId])
  @@index([projectId, activityId])
  @@index([projectId, budgetLineId])
  @@index([commitmentId])
}

/**
 * The next number for one family of human-readable references.
 *
 * Every register in OctaPM numbered itself `count + 1`, which is only ever
 * right while nothing has been deleted: delete one row and the next create
 * asks for a number that already exists, and dies on the unique index with a
 * 500. Twenty-two call sites did this (OCTA-API-REFNUM-111).
 *
 * `MAX(existing) + 1` fixes the gap but not the race — two creates reading the
 * same maximum still produce the same reference. This counter is incremented
 * by a single atomic statement instead, so two concurrent callers cannot be
 * handed the same number whether or not either sits in a transaction. It is
 * seeded from the highest reference already issued the first time a scope is
 * used, so references that exist today keep their numbers.
 *
 * `scope` names the family and what it is counted within, e.g.
 * "project:<uuid>:VO" or "org:<uuid>:TRF".
 */
model ReferenceCounter {
  scope     String   @id
  next      Int
  updatedAt DateTime @updatedAt
}

// ─── Shared state for running several API tasks at once ───
// Everything below used to live in one process's memory. With more than one
// API task behind a load balancer, memory is per task: a socket on task B
// never heard an event raised on task A, and a login lockout on A meant
// nothing on B. These tables are the one place every task agrees on.
// They carry no org_id or activity_id: they sit below tenancy (a sign-in
// attempt has no organisation yet) and hold no project data.

/**
 * Payloads too large for a Postgres NOTIFY (8,000 bytes), parked here for the
 * socket.io Postgres adapter to fetch by id. The adapter owns this table: it
 * queries it by this exact, unquoted name and deletes rows after 30 seconds.
 */
model SocketIoAttachment {
  id        BigInt   @id @default(autoincrement())
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  payload   Bytes?

  @@map("socket_io_attachments")
}

/**
 * Failed sign-in counts, by email and by address — the same thresholds the
 * in-memory lockout applies, held where every task can see them.
 * `scope` is "email" or "ip".
 */
model AuthThrottle {
  scope        String
  key          String
  failures     Int       @default(0)
  backoffUntil DateTime?
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt

  @@id([scope, key])
  @@index([updatedAt])
}

/**
 * Fixed-window request counters for the rate limiter. The migration creates
 * the table UNLOGGED: a counter is worth nothing after a crash, and skipping
 * the write-ahead log keeps a hit to one cheap upsert.
 */
model RateLimitBucket {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}

/// AI usage ledger (AI-1): one row per model call, written only by the AI gateway
/// (services/ai/gateway.js). Telemetry, not a business record: no foreign keys, so it
/// survives record deletion; never holds prompt or answer content.
model AiRun {
  id           String   @id @default(uuid())
  orgId        String?
  projectId    String?
  userId       String?
  apiClientId  String?
  jobId        String?
  actorKind    String // human | api_key | job | system | anonymous
  feature      String // e.g. assistant.ask, ai.attention, rfi.draft
  provider     String?
  model        String?
  status       String // ok | failed | disabled | blocked
  errorClass   String?
  inputTokens  Int?
  outputTokens Int?
  costMicros   Int? // estimated USD, micro-units (services/ai/pricing.js)
  latencyMs    Int      @default(0)
  retries      Int      @default(0)
  requestId    String?
  route        String?
  createdAt    DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, feature, createdAt])
  @@index([projectId, createdAt])
}