generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// â”€â”€â”€ Organisation & Users â”€â”€â”€
model Organisation {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("standard")
  status    String   @default("active")
  // Single sign-on (OCTA-SEC-AUTH-040): one OpenID Connect provider per organisation.
  ssoEnabled         Boolean   @default(false)
  ssoProvider        String?   // oidc
  ssoIssuer          String?
  ssoClientId        String?
  ssoClientSecretEnc String?
  ssoDomainsJson     Json      @default("[]")
  ssoAutoProvision   Boolean   @default(false) // retired: SSO never creates an identity or a membership (D-ID-1 Q1)
  ssoDefaultRole     String    @default("site_engineer")
  ssoRequired        Boolean   @default(false)
  ssoUpdatedAt       DateTime?
  mfaRequired        Boolean   @default(false)
  // Workspace identity (enterprise programme, M1). A personal workspace is an
  // organisation with kind "personal"; nothing else about it differs. The slug
  // is the URL handle for deep links; it stays nullable until M3 has backfilled
  // it from the name (13 organisations share one name, so a suffix is needed),
  // and Postgres treats NULLs as distinct so the unique index already holds
  // wherever a slug is present.
  kind               String    @default("company") // personal | company
  slug               String?   @unique
  createdByUserId    String?   // who created the workspace; ownership itself lives on the membership
  // Workspace defaults (ENT-6, acceptance §16): what a new project of this
  // workspace starts with when its creator names no currency or time zone.
  // Only a default — Project.currency and Project.timezone stay the values
  // of record, and changing these never rewrites an existing project.
  defaultCurrency    String    @default("USD") // ISO 4217
  defaultTimezone    String?   // IANA zone name; null = none chosen (a project then has none either)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  memberships         OrganizationMembership[]
  extraServicesConfigs ExtraServicesConfig[]
  ssoTickets          SsoTicket[]
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  invitationTokens    InvitationToken[]
  authAuditEvents     AuthAuditEvent[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  pushSubscriptions   PushSubscription[]
  companies           Company[]
  companyMemberships  CompanyMembership[]
  projects            Project[]
  meetings            Meeting[]
  meetingAttendees    MeetingAttendee[]
  meetingAgendaItems  MeetingAgendaItem[]
  meetingDecisions    MeetingDecision[]
  meetingActionItems  MeetingActionItem[]
  meetingDistributions MeetingDistribution[]
  meetingComments     MeetingComment[]
  tasks               Task[]
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  taskHistoryEvents   TaskHistory[]
  projectDocuments    ProjectDocument[]
  userSettings        UserSetting[]
  subscription        Subscription?
  enterpriseLeads     EnterpriseLead[]
  locations           Location[]
  wbsNodes            WbsNode[]
  unitsOfMeasure      UnitOfMeasure[]
  permissionTemplates PermissionTemplate[]
  projectUserPermissions ProjectUserPermission[]
  attachments         Attachment[]
  photos              Photo[]
  costCodes           CostCode[]
  projectCostCodes    ProjectCostCode[]
  budgetLines         BudgetLine[]
  budgetLineChanges   BudgetLineChange[]
  budgetSnapshots     BudgetSnapshot[]
  commitments         Commitment[]
  commitmentSovLines  CommitmentSovLine[]
  commitmentChangeOrders CommitmentChangeOrder[]
  subPayApps          SubPayApp[]
  dailyLogs           DailyLog[]
  reportDefinitions   ReportDefinition[]
  ganttLayouts        GanttLayout[]
  inventoryItems      InventoryItem[]
  warehouses          Warehouse[]
  warehouseLocations  WarehouseLocation[]
  stockBalances       StockBalance[]
  stockTransactions   StockTransaction[]
  stockTransfers      StockTransfer[]
  stockTransferLines  StockTransferLine[]
  inventoryCounts     InventoryCount[]
  inventoryCountLines InventoryCountLine[]
  reportSchedules     ReportSchedule[]
  reportRuns          ReportRun[]
  projectHealthSnapshots ProjectHealthSnapshot[]
  workflowTemplates   WorkflowTemplate[]
  workflowInstances   WorkflowInstance[]
  workflowStepAssignments WorkflowStepAssignment[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldsets     CustomFieldset[]
  projectFieldsets    ProjectFieldset[]
  recordTypeDefinitions RecordTypeDefinition[]
  customFieldValues   CustomFieldValue[]
  apiClients          ApiClient[]
  webhookSubscriptions WebhookSubscription[]
  webhookDeliveries   WebhookDelivery[]
  accountingConnections AccountingConnection[]
  accountingCodeMappings AccountingCodeMapping[]
  accountingSyncs     AccountingSync[]
  bidPackages         BidPackage[]
  assistantConversations AssistantConversation[]
  contractProfiles    ContractProfile[]
  sheetReferences     SheetReference[]
  specSections        SpecSection[]
  workers             Worker[]
  crews               Crew[]
  timesheets          Timesheet[]
  timeEntries         TimeEntry[]
  changeEvents        ChangeEvent[]
  changeEventLines    ChangeEventLine[]
  rfqs                Rfq[]
  directCosts         DirectCost[]
  directCostLines     DirectCostLine[]
  directCostPayments  DirectCostPayment[]
  lookaheads          Lookahead[]
  lookaheadItems      LookaheadItem[]
  conversations       Conversation[]
