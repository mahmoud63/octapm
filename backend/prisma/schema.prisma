  id               String   @id @default(uuid())
  projectId        String
  recordType       String
  recordId         String
  correspondenceId String
  relationType     String   @default("supporting") // supporting, notice, response
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project        Project        @relation(fields: [projectId], references: [id])
  correspondence Correspondence @relation(fields: [correspondenceId], references: [id], onDelete: Cascade)

  @@unique([recordType, recordId, correspondenceId])
  @@index([projectId])
  @@index([projectId, recordType, recordId])
  @@index([correspondenceId])
}

model CommercialAttachmentRef {
  id          String   @id @default(uuid())
  projectId   String
  recordType  String
  recordId    String
  documentId  String?
  fileName    String?
  fileUrl     String?
  storageKey  String?
  mimeType    String?
  sizeBytes   Int?
  sha256      String?
  scanStatus  String?
  description String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project         Project          @relation(fields: [projectId], references: [id])
  projectDocument ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([projectId, recordType, recordId])
  @@index([documentId])
}

model DailyReport {
  id              String    @id @default(uuid())
  projectId       String
  activityId      String
  engineerId      String
  date            DateTime
  shift           String    @default("day")
  pctProgress     Float     @default(0)
  weatherJson     Json?
  manpowerJson    Json? // array of { trade, workers, hours }
  materialsJson   Json? // array of { materialId, name, qty, unit }
  equipmentJson   Json? // array of { equipmentId, name, hours }
  issuesJson      Json?
  photosJson      Json? // array of photo evidence metadata
  notes           String?
  clientRequestId String?
  clientCreatedAt DateTime?
  deviceId        String?
  status          String    @default("submitted") // draft, submitted, approved, rejected
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project              Project                  @relation(fields: [projectId], references: [id])
  activity             Activity                 @relation(fields: [activityId], references: [id])
  engineer             User                     @relation(fields: [engineerId], references: [id])
  progressSubmissions  ProgressSubmission[]
  deliveryReceipts     DeliveryReceipt[]
  deliveryReceiptLines DeliveryReceiptLine[]
  materialUsages       ActivityMaterialUsage[]
  equipmentUsages      ActivityEquipmentUsage[]

  @@unique([projectId, clientRequestId])
  @@index([projectId])
  @@index([activityId])
  @@index([engineerId])
  @@index([projectId, date])
  @@index([projectId, status])
}

// ─── Site Operations ───
model SiteDiary {
  id              String    @id @default(uuid())
  projectId       String
  engineerId      String?
  date            DateTime
  shift           String    @default("day")
  weather         String?
  weatherJson     Json?
  workers         Int       @default(0)
  visitors        String?
  workDone        String?
  issues          String?
  issuesJson      Json?
  instructions    String?
  manpowerJson    Json?
  materialsJson   Json?
  equipmentJson   Json?
  photosJson      Json?
  notes           String?
  clientRequestId String?
  clientCreatedAt DateTime?
  deviceId        String?
  status          String    @default("draft") // draft, submitted, approved, rejected
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project  Project @relation(fields: [projectId], references: [id])
  engineer User?   @relation(fields: [engineerId], references: [id], onDelete: SetNull)

  @@unique([projectId, clientRequestId])
  @@index([projectId])
  @@index([engineerId])
  @@index([projectId, date])
  @@index([projectId, status])
