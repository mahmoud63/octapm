model BidInvitation {
  id              String    @id @default(uuid())
  orgId           String
  packageId       String
  vendorCompanyId String?
  companyName     String
  contactName     String?
  contactEmail    String
  tokenHash       String    @unique
  expiresAt       DateTime
  status          String    @default("invited") // invited, viewed, declined, submitted, withdrawn
  invitedAt       DateTime  @default(now())
  viewedAt        DateTime?
  lastAccessAt    DateTime?
  declinedReason  String?
  remindersSent   Int       @default(0)
  createdBy       String?
