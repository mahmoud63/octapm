// ─── Activities (THE CORE — everything links here) ───
model Activity {
  id                String    @id @default(uuid())
  projectId         String
  name              String
  activityCode      String?
  p6ActivityId      String?
  wbsCode           String?
  calendarId        String?
  category          String?
  startDate         DateTime?
  endDate           DateTime?
  duration          Int       @default(0)
  originalDuration  Int?
  remainingDuration Int?
  physComplete      Float?
  earlyStart        Int?
  earlyFinish       Int?
  baselineStart     Int?
  baselineFinish    Int?
  lateStart         Int?
  lateFinish        Int?
  totalFloat        Int?
  budget            Decimal   @default(0) @db.Decimal(18, 2)
  isMilestone       Boolean   @default(false)
  isCritical        Boolean   @default(false)
  predecessors      String? // comma-separated: "ACT-01 FS, ACT-02 SS+2"
  batchId           String? // for chunked generation: B1, B2, etc.
  isActive          Boolean   @default(true)
  retiredAt         DateTime?
  retiredBy         String?
  retiredReason     String?
  retiredRevisionId String?
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project                Project                    @relation(fields: [projectId], references: [id])
  progress               ActivityProgress[]
  costRecords            CostRecord[]
  longLeadItems          LongLeadItem[]
  procurementPackages    ProcurementPackage[]
  changeOrders           ChangeOrder[]
  changeOrderLinks       ChangeOrderActivityLink[]
  itpRecords             ItpRecord[]
  procurementOrders      ProcurementOrder[]
  procurementPoLines     ProcurementPoLine[]
  deliveryReceiptLines   DeliveryReceiptLine[]
  materialUsages         ActivityMaterialUsage[]
  equipmentUsages        ActivityEquipmentUsage[]
  leadTimeAlerts         ProcurementLeadTimeAlert[]
  ncrRecords             NcrRecord[]
  defectRecords          DefectRecord[]
  safetyIncidents        SafetyIncident[]
  materialTests          MaterialTest[]
  rfis                   Rfi[]
  submittals             Submittal[]
  drawingRecords         DrawingRecord[]
  correspondences        Correspondence[]
  workflowLinks          WorkflowActivityLink[]
  riskLinks              RiskActivityLink[]
  dailyReports           DailyReport[]
  assignments            ActivityAssignment[]
  materials              ActivityMaterial[]
  activityEquipment      ActivityEquipment[]
  resourceAllocations    ResourceAllocation[]
  boqActivitySuggestions BoqActivity[]
  boqAllocations         ActivityBoqAllocation[]
  costLoadings           ActivityCostLoading[]
  progressMethod         ActivityProgressMethod?
  progressSubmissions    ProgressSubmission[]
  ipcProgressLinks       IpcItemProgressLink[]
  subValuationLinks      SubValuationActivityLink[]
  eotClaimLinks          EotClaimActivityLink[]
  weatherDelayLinks      WeatherDelayActivityLink[]
  meetings               Meeting[]
  meetingAttendees       MeetingAttendee[]
  meetingAgendaItems     MeetingAgendaItem[]
  meetingDecisions       MeetingDecision[]
  meetingActionItems     MeetingActionItem[]
  meetingDistributions   MeetingDistribution[]
  meetingComments        MeetingComment[]
  tasks                  Task[]
  predecessorLinks       ActivityDependency[]       @relation("ActivityDependencySuccessor")
  successorLinks         ActivityDependency[]       @relation("ActivityDependencyPredecessor")

  @@index([projectId])
  @@index([projectId, isActive])
  @@index([projectId, isActive, sortOrder])
  @@index([projectId, isActive, category])
  @@index([projectId, isCritical])
  @@index([projectId, activityCode])
  @@index([projectId, p6ActivityId])
  @@index([projectId, wbsCode])
}

model ActivityDependency {
  id                     String   @id @default(uuid())
  projectId              String
  predecessorId          String
  successorId            String
  relationshipType       String   @default("FS") // FS, SS, FF, SF
  lagDays                Int      @default(0) // negative values represent lead
  source                 String   @default("manual") // manual, import, ai, migration
  importSource           String?
