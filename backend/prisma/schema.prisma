model ProcurementOrder {
  id              String    @id @default(uuid())
  projectId       String
  activityId      String?
  packageId       String?
  supplierId      String?
  commitmentId    String? // the purchase-order commitment this PO draws down (OCTA-FIN-COMMIT-020)
  ref             String
  item            String
  supplier        String?
  // The commercial lifecycle. Fulfilment lives on warehouseStatus and billing
  // on invoiceStatus, because an order that is fully delivered and half
  // invoiced cannot pick one of those as "the" status. The API derives a
  // single lifecycleStatus from all three for anyone who wants one word
  // (OCTA-COM-PO-053).
  status          String    @default("planned") // planned, draft, pending_approval, approved, issued, acknowledged, closed, cancelled
  // not_invoiced, partially_invoiced, fully_invoiced
  invoiceStatus   String    @default("not_invoiced")
  invoicedAmount  Decimal   @default(0) @db.Decimal(18, 2)
  subtotal        Decimal   @default(0) @db.Decimal(18, 2)
  taxRate         Float     @default(0)
  taxAmount       Decimal   @default(0) @db.Decimal(18, 2)
  deliveryLocationId String?
  deliveryAddress String?
  deliveryTerms   String?
  paymentTerms    String?
  submittedAt     DateTime?
  submittedBy     String?
  approvedAt      DateTime?
  approvedBy      String?
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectedReason  String?
  // The supplier confirming the order, and under their own reference.
  acknowledgedAt  DateTime?
  acknowledgedBy  String?
  acknowledgedRef String?
  cancelledAt     DateTime?
  cancelledBy     String?
  cancelReason    String?
  closedAt        DateTime?
  closedBy        String?
  leadWeeks       Int       @default(0)
  requiredTiming  String    @default("activity_start") // activity_start, activity_finish
  needOffsetDays  Int       @default(0)
  bufferDays      Int       @default(14)
  value           Decimal   @default(0) @db.Decimal(18, 2)
  currency        String    @default("USD")
  orderDate       DateTime?
  requiredBy      DateTime?
  promisedDate    DateTime?
  deliveryDate    DateTime?
  warehouseStatus String    @default("not_received") // not_received, partial, received, issued
  receivedAt      DateTime?
  issuedAt        DateTime?
  buyer           String?
  notes           String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  project              Project                    @relation(fields: [projectId], references: [id])
  activity             Activity?                  @relation(fields: [activityId], references: [id], onDelete: SetNull)
  package              ProcurementPackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  supplierRef          ProcurementSupplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  commitment           Commitment?                @relation(fields: [commitmentId], references: [id], onDelete: SetNull)
  deliveryLocation     Location?                  @relation("PurchaseOrderDeliveryLocation", fields: [deliveryLocationId], references: [id], onDelete: SetNull)
  lines                ProcurementPoLine[]
  deliveryReceipts     DeliveryReceipt[]
  leadTimeAlerts       ProcurementLeadTimeAlert[]
  deliveryReceiptLines DeliveryReceiptLine[]
  supplierInvoices     DirectCost[]

  @@index([projectId])
  @@index([activityId])
  @@index([packageId])
  @@index([supplierId])
  @@index([commitmentId])
  @@index([deliveryLocationId])
  @@index([projectId, status])
  @@index([projectId, warehouseStatus])
  @@index([projectId, invoiceStatus])
}

model ProcurementPoLine {
  id                 String    @id @default(uuid())
  projectId          String
  orderId            String
  packageId          String?
  supplierId         String?
  activityId         String
  // Cost coding at the moment the order is raised (OCTA-FIN-POLINE-060).
  // Optional, because a line for a service or a re-charge need not hit the
  // budget — but a line that will become project cost should say where while
  // the buyer still knows. Without these the coding was typed for the first
  // time on the supplier invoice, by finance, who were not the buyer.
  costCodeId         String?
  budgetLineId       String?
  boqItemId          String?
  activityMaterialId String?
  materialMasterId   String?
  // Which stocked item this line becomes on goods receipt. Set the first time
  // the line is received, so the mapping is remembered for later deliveries.
  inventoryItemId    String?
  lineNumber         Int
  itemCode           String?
  description        String
  spec               String?
  unit               String
  orderedQty         Float     @default(0)
  receivedQty        Float     @default(0)
  rejectedQty        Float     @default(0)
  issuedQty          Float     @default(0)
  consumedQty        Float     @default(0)
  unitCost           Decimal   @default(0) @db.Decimal(18, 2)
  status             String    @default("ordered") // draft, ordered, partial, received, issued, consumed, cancelled
  leadWeeks          Int       @default(0)
  requiredTiming     String    @default("activity_start")
  needOffsetDays     Int       @default(0)
  bufferDays         Int       @default(14)
  requiredDate       DateTime?
  promisedDate       DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  project          Project                    @relation(fields: [projectId], references: [id])
  order            ProcurementOrder           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  package          ProcurementPackage?        @relation(fields: [packageId], references: [id], onDelete: SetNull)
  supplier         ProcurementSupplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  activity         Activity                   @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityMaterial ActivityMaterial?          @relation(fields: [activityMaterialId], references: [id], onDelete: SetNull)
  materialMaster   MaterialMaster?            @relation(fields: [materialMasterId], references: [id], onDelete: SetNull)
  receiptLines     DeliveryReceiptLine[]
  usages           ActivityMaterialUsage[]
  leadTimeAlerts   ProcurementLeadTimeAlert[]
  inventoryItem    InventoryItem?             @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)
  invoiceLines     DirectCostLine[]

  @@unique([orderId, lineNumber])
  @@index([inventoryItemId])
  @@index([projectId])
  @@index([orderId])
  @@index([packageId])
  @@index([supplierId])
  @@index([activityId])
  @@index([costCodeId])
  @@index([budgetLineId])
  @@index([activityMaterialId])
  @@index([projectId, status])
  @@index([projectId, requiredDate])
  @@index([projectId, promisedDate])
}

