model DefectRecord {
  id            String    @id @default(uuid())
  projectId     String
  activityId    String?
  ref           String
  title         String
  trade         String?
  location      String?
  severity      String    @default("minor") // minor, major, critical
  status        String    @default("open") // open, in_progress, closed
  owner         String?
  reviewer      String?
  approver      String?
  assignee      String?
  ownerUserId       String?
  reviewerUserId    String?
  approverUserId    String?
  assigneeUserId    String?
  assigneeCompanyId String?
  ballInCourtUserId String?
