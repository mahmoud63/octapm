/**
 * PC-7b change intelligence (docs/project-controls/OCTAPM_CHANGE_INTELLIGENCE.md §1, §6-§7): one REVIEWED
 * exception — an overrun or a data-quality gap the engine found by reading figures through the services
 * that own them. A row is DERIVED and rebuildable: it never feeds a figure anywhere (not CostRecord.forecast,
 * not BudgetLine.forecast, not EAC), never creates a Change Order and never changes a budget or a schedule.
 * `measured` and `limit` are the two figures compared, each with the basis string of the owning figure
 * (`measuredBasis`, `limitBasis`), so an exception always says where its numbers came from. The only way
 * forward from an exception is a person: review it, snooze it, or raise a Change Event from it
 * (`changeEventId` here, `ChangeEvent.exceptionId` there — the handoff, §2).
 *
 * Tenancy as ENT-3: (projectId, orgId) → Project(id, orgId) and orgId → Organisation, so a cross-tenant row is
 * refused by PostgreSQL; `orgId` also serves the org-wide "open exceptions" read of the workspace dashboard
 * (§35 rule 2). costCodeId uses the master key (costCodeId, orgId) → CostCode(id, orgId); its SET NULL nulls
 * costCodeId only (hand-written column-list form in the migration, as ENT-3 did for ChangeEventLine).
 *
 * OPEN-ROW UNIQUENESS — not expressible in Prisma, enforced by the database: migration
 * 20261005060000_project_exceptions creates the partial unique index
 *   "ProjectException_open_subject_key" ON ("projectId", "kind", "subjectType", "subjectId",
 *     COALESCE("secondarySubjectType", ''), COALESCE("secondarySubjectId", '')) WHERE "resolvedAt" IS NULL
 * so a subject has at most one OPEN row per kind (the engine upserts on it), NULL secondary subjects collide
 * with each other instead of slipping past the index, and a resolved row never blocks a new open one.
 *
 * ON DELETE: org / project Cascade (the tenant owns its rows); wbsNode, location, costCode, changeEvent
 * SetNull (group keys and the handoff link the row outlives — it is rebuilt on the next engine pass).
 */
model ProjectException {
  id                   String    @id @default(uuid())
  orgId                String
  projectId            String
  kind                 String // §1 overrun kinds and §7 data-quality kinds, e.g. quantity_over_allocation
  severity             String // info, warning, critical
  subjectType          String // boq_item, allocation, activity, budget_line, commitment, certificate_item, project …
  subjectId            String
  secondarySubjectType String?
  secondarySubjectId   String?
  wbsNodeId            String?
  locationId           String?
  costCodeId           String?
  measured             Decimal   @db.Decimal(18, 3)
  limit                Decimal   @db.Decimal(18, 3)
  unitCode             String?
  measuredBasis        String // basis of the measured figure as its owning service states it
  limitBasis           String // basis of the limit figure as its owning service states it
  detectedAt           DateTime  @default(now())
  lastSeenAt           DateTime  @default(now())
  resolvedAt           DateTime?
  resolvedReason       String?
  changeEventId        String?
  snoozedUntil         DateTime?
  snoozedBy            String?
  reviewedAt           DateTime?
  reviewedBy           String?
  reviewNote           String?
  dataJson             Json      @default("{}")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org          Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project       @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  wbsNode      WbsNode?      @relation(fields: [wbsNodeId], references: [id], onDelete: SetNull)
  location     Location?     @relation(fields: [locationId], references: [id], onDelete: SetNull)
  costCode     CostCode?     @relation(fields: [costCodeId, orgId], references: [id, orgId], onDelete: SetNull)
  changeEvent  ChangeEvent?  @relation("ProjectExceptionChangeEvent", fields: [changeEventId], references: [id], onDelete: SetNull)
  raisedEvents ChangeEvent[] @relation("ChangeEventSourceException")

  @@index([projectId, kind, resolvedAt])
  @@index([orgId, resolvedAt])
  @@index([projectId, subjectType, subjectId])
  @@index([changeEventId])
  @@index([wbsNodeId])
  @@index([locationId])
  @@index([costCodeId])
}

