  criticality          String?
  risk                 String?
  status               String    @default("not_ordered") // not_ordered, ordered, delivered
  supplier             String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project             Project              @relation(fields: [projectId], references: [id])
  activity            Activity?            @relation(fields: [activityId], references: [id], onDelete: SetNull)
  procurementPackage  ProcurementPackage?  @relation(fields: [procurementPackageId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([activityId])
  @@index([procurementPackageId])
  @@index([projectId, status])
  @@index([projectId, warehouseStatus])
}

