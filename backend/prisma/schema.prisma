  managerUser       User?            @relation("PunchManagerUser", fields: [managerUserId], references: [id], onDelete: SetNull)
  finalApproverUser User?            @relation("PunchFinalApproverUser", fields: [finalApproverUserId], references: [id], onDelete: SetNull)
