model User {
  id           String    @id @default(uuid())
  orgId        String
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("site_engineer") // super_admin, pm, planning_eng, qs, cost_controller, procurement, warehouse, site_engineer, finance
  isCompanyAdmin Boolean @default(false) // org-wide project visibility + permission/user administration
  status       String    @default("active")
  lastLogin    DateTime?
  // Two-factor and SSO (OCTA-SEC-AUTH-040)
  mfaEnabled          Boolean   @default(false)
  mfaSecretEnc        String?
  mfaPendingSecretEnc String?
  mfaEnrolledAt       DateTime?
  mfaBackupCodesJson  Json      @default("[]")
  mfaLastTotpStep     Int? // newest 30-second step a TOTP code was accepted for; that step or an earlier one is a replay
  ssoSubject          String? // legacy global link, no longer read or written: SSO links live on the membership (D-ID-1 Q2)
  ssoProvider         String?
  ssoLinkedAt         DateTime?
  // Bumped by every credential event (a completed reset, an identity closed, an
  // admin second-factor reset, a closed account reopened). Tokens carry it as
  // `cep`; one minted before the bump is refused everywhere (D-ID-1 Q6).
  credentialEpoch     Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org                     Organisation         @relation(fields: [orgId], references: [id])
  ssoTickets              SsoTicket[]
  projectAssignments      ProjectAssignment[]
  projectPermissions      ProjectUserPermission[] @relation("ProjectUserPermissionUser")
  activityAssignments     ActivityAssignment[]
  refreshSessions         RefreshSession[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         InvitationToken[]    @relation("InvitationInvitedBy")
  acceptedInvitations     InvitationToken[]    @relation("InvitationAcceptedBy")
  authAuditEvents         AuthAuditEvent[]     @relation("AuthAuditUser")
  authoredAuthAuditEvents AuthAuditEvent[]     @relation("AuthAuditActor")
  settings                UserSetting?
  dailyReports            DailyReport[]
  siteDiaries             SiteDiary[]
  notifications           Notification[]      @relation("NotificationRecipient")
  actedNotifications      Notification[]      @relation("NotificationActor")
  notificationPrefs       NotificationPreference[]
  pushSubscriptions       PushSubscription[]
  workerProfiles          Worker[]
  companyMemberships      CompanyMembership[]
  projectPartyMemberships ProjectPartyMember[]
  chairedMeetings         Meeting[]              @relation("MeetingChair")
  createdMeetings         Meeting[]              @relation("MeetingCreatedBy")
  updatedMeetings         Meeting[]              @relation("MeetingUpdatedBy")
  distributedMeetings     Meeting[]              @relation("MeetingDistributedBy")
  meetingAttendees        MeetingAttendee[]      @relation("MeetingAttendeeUser")
  meetingAgendaItems      MeetingAgendaItem[]    @relation("MeetingAgendaPresenter")
  meetingDecisions        MeetingDecision[]      @relation("MeetingDecisionDecidedBy")
  meetingActionItems      MeetingActionItem[]    @relation("MeetingActionOwner")
  meetingDistributionRecipients MeetingDistribution[] @relation("MeetingDistributionRecipient")
  sentMeetingDistributions      MeetingDistribution[] @relation("MeetingDistributionSender")
  meetingComments         MeetingComment[]       @relation("MeetingCommentAuthor")
  assignedTasks           Task[]              @relation("TaskAssignee")
  createdTasks            Task[]              @relation("TaskCreatedBy")
  updatedTasks            Task[]              @relation("TaskUpdatedBy")
  closedTasks             Task[]              @relation("TaskClosedBy")
  taskComments            TaskComment[]       @relation("TaskCommentAuthor")
  taskAttachments         TaskAttachment[]    @relation("TaskAttachmentUploader")
  taskHistoryEvents       TaskHistory[]       @relation("TaskHistoryActor")
  authoredComments        Comment[]           @relation("CommentAuthor")
  conversationMemberships ConversationMember[]
  conversationMessages    ConversationMessage[] @relation("ConversationMessageAuthor")
  commentMentions         CommentMention[]    @relation("CommentMentionUser")
  recordSubscriptions     RecordSubscription[] @relation("RecordSubscriptionUser")

  // Accountability references (OCTA-DATA-REFS-004): owner / reviewer / approver /
  // assignee / ball-in-court per record type.
  riskOwner               Risk[]              @relation("RiskOwnerUser")
  riskReviewer            Risk[]              @relation("RiskReviewerUser")
  riskApprover            Risk[]              @relation("RiskApproverUser")
  riskAssignee            Risk[]              @relation("RiskAssigneeUser")
  riskBallInCourt         Risk[]              @relation("RiskBallInCourtUser")
  ncrOwner                NcrRecord[]         @relation("NcrOwnerUser")
  ncrReviewer             NcrRecord[]         @relation("NcrReviewerUser")
  ncrApprover             NcrRecord[]         @relation("NcrApproverUser")
  ncrAssignee             NcrRecord[]         @relation("NcrAssigneeUser")
  ncrBallInCourt          NcrRecord[]         @relation("NcrBallInCourtUser")
  itpOwner                ItpRecord[]         @relation("ItpOwnerUser")
  itpReviewer             ItpRecord[]         @relation("ItpReviewerUser")
  itpApprover             ItpRecord[]         @relation("ItpApproverUser")
  itpAssignee             ItpRecord[]         @relation("ItpAssigneeUser")
  itpBallInCourt          ItpRecord[]         @relation("ItpBallInCourtUser")
  defectOwner             DefectRecord[]      @relation("DefectOwnerUser")
  defectReviewer          DefectRecord[]      @relation("DefectReviewerUser")
  defectApprover          DefectRecord[]      @relation("DefectApproverUser")
  defectAssignee          DefectRecord[]      @relation("DefectAssigneeUser")
  defectBallInCourt       DefectRecord[]      @relation("DefectBallInCourtUser")
  punchAssignee           PunchItem[]         @relation("PunchAssigneeUser")
  punchManager            PunchItem[]         @relation("PunchManagerUser")
  punchFinalApprover      PunchItem[]         @relation("PunchFinalApproverUser")
  punchBallInCourt        PunchItem[]         @relation("PunchBallInCourtUser")
  formAssignee            FormInstance[]      @relation("FormAssigneeUser")
  formInspector           FormInstance[]      @relation("FormInspectorUser")
  formApprover            FormInstance[]      @relation("FormApproverUser")
  formBallInCourt         FormInstance[]      @relation("FormBallInCourtUser")
  rfiManaged              Rfi[]               @relation("RfiManagerUser")
  rfiAssignments          RfiAssignee[]       @relation("RfiAssigneeUser")
  rfiResponses            RfiResponse[]       @relation("RfiResponseAuthor")
  submittalsManaged       Submittal[]         @relation("SubmittalManagerUser")
  submittalPackagesManaged SubmittalPackage[] @relation("SubmittalPackageManager")
  submittalStepAssignments SubmittalStepAssignment[] @relation("SubmittalStepAssignee")
  signatures              Signature[]         @relation("SignatureUser")
  safetyOwner             SafetyIncident[]    @relation("SafetyOwnerUser")
  safetyReviewer          SafetyIncident[]    @relation("SafetyReviewerUser")
  safetyApprover          SafetyIncident[]    @relation("SafetyApproverUser")
  safetyAssignee          SafetyIncident[]    @relation("SafetyAssigneeUser")
  safetyBallInCourt       SafetyIncident[]    @relation("SafetyBallInCourtUser")
  materialTestOwner       MaterialTest[]      @relation("MaterialTestOwnerUser")
  materialTestReviewer    MaterialTest[]      @relation("MaterialTestReviewerUser")
  materialTestApprover    MaterialTest[]      @relation("MaterialTestApproverUser")
  materialTestAssignee    MaterialTest[]      @relation("MaterialTestAssigneeUser")
  materialTestBallInCourt MaterialTest[]      @relation("MaterialTestBallInCourtUser")
  rfiOwner                Rfi[]               @relation("RfiOwnerUser")
  rfiReviewer             Rfi[]               @relation("RfiReviewerUser")
  rfiApprover             Rfi[]               @relation("RfiApproverUser")
  rfiAssignee             Rfi[]               @relation("RfiAssigneeUser")
  rfiBallInCourt          Rfi[]               @relation("RfiBallInCourtUser")
  submittalOwner          Submittal[]         @relation("SubmittalOwnerUser")
  submittalReviewer       Submittal[]         @relation("SubmittalReviewerUser")
  submittalApprover       Submittal[]         @relation("SubmittalApproverUser")
  submittalAssignee       Submittal[]         @relation("SubmittalAssigneeUser")
  submittalBallInCourt    Submittal[]         @relation("SubmittalBallInCourtUser")
  drawingOwner            DrawingRecord[]     @relation("DrawingOwnerUser")
  drawingReviewer         DrawingRecord[]     @relation("DrawingReviewerUser")
  drawingApprover         DrawingRecord[]     @relation("DrawingApproverUser")
  drawingAssignee         DrawingRecord[]     @relation("DrawingAssigneeUser")
  drawingBallInCourt      DrawingRecord[]     @relation("DrawingBallInCourtUser")
  transmittalOwner        Transmittal[]       @relation("TransmittalOwnerUser")
  transmittalReviewer     Transmittal[]       @relation("TransmittalReviewerUser")
  transmittalApprover     Transmittal[]       @relation("TransmittalApproverUser")
  transmittalAssignee     Transmittal[]       @relation("TransmittalAssigneeUser")
  transmittalBallInCourt  Transmittal[]       @relation("TransmittalBallInCourtUser")
  correspondenceOwner     Correspondence[]    @relation("CorrespondenceOwnerUser")
  correspondenceReviewer  Correspondence[]    @relation("CorrespondenceReviewerUser")
  correspondenceApprover  Correspondence[]    @relation("CorrespondenceApproverUser")
  correspondenceAssignee  Correspondence[]    @relation("CorrespondenceAssigneeUser")
  correspondenceBallInCourt Correspondence[]  @relation("CorrespondenceBallInCourtUser")

  apiClients   ApiClient[]
  memberships  OrganizationMembership[]
  assistantConversations AssistantConversation[]
  managedWarehouses Warehouse[] @relation("WarehouseManager")
  @@index([orgId])
  @@index([email])
}

// â”€â”€â”€ Projects â”€â”€â”€
model UserSetting {
  id                String    @id @default(uuid())
  orgId             String
  userId            String    @unique
  profileUsername   String?
  profileBio        String?
  profileUrls       Json      @default("[]")
  dateOfBirth       DateTime?
  language          String    @default("en")
  appearanceTheme   String    @default("dark")
  appearanceFont    String    @default("inter")
  displayItems      Json      @default("[\"dashboard\",\"projects\",\"tasks\",\"users\",\"help-center\"]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, userId])
}

enum ProjectPartyRole {
  owner
  consultant
  contractor
  subcontractor
}

model Company {
  id                 String   @id @default(uuid())
  orgId              String
  name               String
  // `name` folded to how it would be typed by somebody who was not being
  // careful (OCTA-ADM-DEDUPE-061): lowercase, punctuation resolved, spaces
  // collapsed. Matching happens on this, so "ABC Steel LLC" and
  // "abc steel llc" resolve to the same company instead of becoming two —
  // and a duplicate carries no prequalification, no history and no insurance.
  //
  // Indexed, not unique: an existing directory may already hold duplicates,
  // and a unique index would make the migration fail on exactly the databases
  // that need this most. Merging existing ones is a person's decision, served
  // by the duplicate report.
  nameKey            String?
  legalName          String?
  tradeName          String?
  registrationNumber String?
  taxNumber          String?
  type               String   @default("external")
  email              String?
  phone              String?
  website            String?
  address            String?
  contactName        String?
  // Vendor profile (OCTA-ADM-COMPANY-007): a company defined once and reused
  // as a supplier on every project.
  isVendor           Boolean  @default(false)
  trades             String[] @default([])
  vendorProfileJson  Json     @default("{}")
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org              Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships      CompanyMembership[]
  prequalification VendorPrequalification?
  projectParties   ProjectParty[]
  invitationTokens InvitationToken[]
  procurementSuppliers ProcurementSupplier[]
  commitments          Commitment[]        @relation("CommitmentVendor")
  primeContracts       PrimeContract[]     @relation("PrimeContractClient")
  workers              Worker[]
  crews                Crew[]
  rfqs                 Rfq[]               @relation("RfqVendor")
  directCosts          DirectCost[]        @relation("DirectCostVendor")
  // Attribution of legacy free-text valuations, where the name resolved.
  subValuations        SubValuation[]      @relation("SubValuationCompany")
  riskAssignments           Risk[]           @relation("RiskAssigneeCompany")
  ncrAssignments            NcrRecord[]      @relation("NcrAssigneeCompany")
  itpAssignments            ItpRecord[]      @relation("ItpAssigneeCompany")
  defectAssignments         DefectRecord[]   @relation("DefectAssigneeCompany")
  punchAssignments          PunchItem[]      @relation("PunchAssigneeCompany")
  formAssignments           FormInstance[]   @relation("FormAssigneeCompany")
  safetyAssignments         SafetyIncident[] @relation("SafetyAssigneeCompany")
  materialTestAssignments   MaterialTest[]   @relation("MaterialTestAssigneeCompany")
  rfiAssignments            Rfi[]            @relation("RfiAssigneeCompany")
  submittalAssignments      Submittal[]      @relation("SubmittalAssigneeCompany")
  drawingAssignments        DrawingRecord[]  @relation("DrawingAssigneeCompany")
  transmittalAssignments    Transmittal[]    @relation("TransmittalAssigneeCompany")
  correspondenceAssignments Correspondence[] @relation("CorrespondenceAssigneeCompany")

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, isVendor])
  @@index([orgId, nameKey])
}

model CompanyMembership {
  id        String   @id @default(uuid())
  orgId     String
  companyId String
  userId    String
  role      String   @default("member")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org                 Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectPartyMembers ProjectPartyMember[]

  @@unique([companyId, userId])
  @@index([orgId])
  @@index([orgId, userId])
  @@index([companyId])
  @@index([userId])
}

model Project {
  id                    String    @id @default(uuid())
  orgId                 String
  name                  String
  type                  String?
  location              String?
  clientName            String?
  consultantName        String?
  contractorName        String?
  contractType          String?
  contractNumber        String?
  startDate             DateTime?
  endDate               DateTime?
  completionDate        DateTime?
  baselineDate          DateTime?
  dataDate              DateTime?
  revisedCompletionDate DateTime?
  duration              Int?
  durationUnit          String    @default("months")
  contractValue         Decimal?  @db.Decimal(18, 2)
  defaultRetentionRate  Float?
  ldRatePerDay          Decimal   @default(0) @db.Decimal(18, 2)
  weatherAllowanceDays  Int       @default(20)
  // Site coordinates and daily-log preferences (OCTA-FLD-DAILY-022)
  latitude              Float?
  longitude             Float?
  timezone              String?
  dailyLogSettingsJson  Json      @default("{}")
  projectCalendar       String?
  reportingCutoffDay    Int?
  // Inbound email (OCTA-COMM-CONV-042): p-<token>@<INBOUND_EMAIL_DOMAIN> reaches this project's inbox.
  inboundEmailToken     String?   @unique
  inboundEmailAutoLog   Boolean   @default(false)
  currency              String    @default("USD")
  status                String    @default("active")
  templateId            String? // ProjectTemplate the project was created from
  documentFoldersJson   Json      @default("[]") // predefined document folder paths
  archivedAt            DateTime?
  archivedBy            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org                           Organisation                   @relation(fields: [orgId], references: [id])
  template                      ProjectTemplate?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
