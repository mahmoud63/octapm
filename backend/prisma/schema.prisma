// â”€â”€â”€ Budget by cost code (OCTA-FIN-COSTCODE-019) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/** The subset of the organisation's cost codes a project budgets against. */
model ProjectCostCode {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  costCodeId String
  status     String   @default("active") // active, archived
  sortOrder  Int      @default(0)
  createdBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  costCode CostCode     @relation(fields: [costCodeId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, costCodeId])
  @@index([orgId])
  @@index([projectId, status])
}

/**
 * One budget line per cost code and cost type. Revised budget = original +
 * every BudgetLineChange (approved change orders, revisions, transfers).
 */
model BudgetLine {
  id             String   @id @default(uuid())
  orgId          String
  projectId      String
  costCodeId     String
  costType       String   @default("other") // labour, material, equipment, subcontract, indirect, overhead, contingency, other
  description    String?
  originalBudget Decimal  @default(0) @db.Decimal(18, 2)
  committed      Decimal  @default(0) @db.Decimal(18, 2)
  committedFromCommitments Decimal @default(0) @db.Decimal(18, 2) // posted from executed commitments (OCTA-FIN-COMMIT-020)
  actual         Decimal  @default(0) @db.Decimal(18, 2)
  forecast       Decimal? @db.Decimal(18, 2)
  status         String   @default("active") // active, archived
  sortOrder      Int      @default(0)
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org         Organisation                   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project                        @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  costCode    CostCode                       @relation(fields: [costCodeId, orgId], references: [id, orgId], onDelete: Restrict)
  changes     BudgetLineChange[]
  allocations BudgetLineActivityAllocation[]
  changeOrders ChangeOrder[]
  sovLines    CommitmentSovLine[]
  changeEventLines ChangeEventLine[]
  directCostLines  DirectCostLine[]
  costLedgerEntries CostLedgerEntry[]

  @@unique([projectId, costCodeId, costType])
  @@index([orgId])
  @@index([projectId, status])
  @@index([costCodeId])
}

/** Ledger of amounts added to or moved between budget lines. */
model BudgetLineChange {
  id                String   @id @default(uuid())
  orgId             String
  projectId         String
  budgetLineId      String
  kind              String // change_order, revision, transfer_in, transfer_out
  amount            Decimal  @default(0) @db.Decimal(18, 2)
  changeOrderId     String?
  counterpartLineId String?
  note              String?
  createdBy         String?
  createdAt         DateTime @default(now())

  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  budgetLine  BudgetLine   @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  changeOrder ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId, budgetLineId])
  @@index([projectId, changeOrderId])
}

/** Share of a budget line carried by an activity (weights sum to â‰¤ 100 per line). */
model BudgetLineActivityAllocation {
  id           String   @id @default(uuid())
  projectId    String
  budgetLineId String
  activityId   String
  weight       Float    @default(0)
  amount       Decimal  @default(0) @db.Decimal(18, 2)
  source       String   @default("manual") // manual, boq, even
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project    Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  budgetLine BudgetLine @relation(fields: [budgetLineId], references: [id], onDelete: Cascade)
  activity   Activity   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([budgetLineId, activityId])
  @@index([projectId, activityId])
}

/** Frozen copy of the budget (lines, allocations, reconciliation) â€” one per locked reporting period. */
model BudgetSnapshot {
  id                 String   @id @default(uuid())
  orgId              String
  projectId          String
  reportingPeriodId  String?  @unique
  label              String
  takenBy            String?
  takenAt            DateTime @default(now())
