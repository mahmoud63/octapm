  @@index([orgId, status])
}

model ProjectTemplate {
  id              String   @id @default(uuid())
  orgId           String
  name            String
  description     String?
  settingsJson    Json     @default("{}") // project field defaults (type, contractType, currency, calendar, retention, â€¦)
  partiesJson     Json     @default("[]") // [{ role, companyId?, companyName?, accessLevel?, permissionTemplateId? }]
  foldersJson     Json     @default("[]") // ["Contract", "Drawings/IFC", â€¦]
  locationsJson   Json     @default("[]") // [{ name, kind, code?, children: [...] }]
