  changeOrderLinks  ChangeOrderAllocationLink[]
  ipcProgressLinks  IpcItemProgressLink[]
  subValuationLinks SubValuationAllocationLink[]

  // Active pair uniqueness is enforced by the partial unique index
  // ActivityBoqAllocation_active_pair_key in SQL migrations because Prisma
  // schema cannot express partial unique indexes with isActive = true.
  @@index([projectId])
  @@index([boqItemId])
  @@index([activityId])
  @@index([projectId, boqItemId, activityId])
  @@index([projectId, status])
}

