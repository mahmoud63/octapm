  origin             String    @default("manual") // manual, rfi, submittal, daily_log, observation, meeting, other
  sourceRecordType   String?
  sourceRecordId     String? // kept for any source without a typed column below
  // PC-7b §126 typed traceability: at most the source(s) the event was raised from; all SetNull.
  rfiId               String?
  dailyLogId          String?
  ncrId               String? // → NcrRecord
  punchItemId         String? // → PunchItem (punch items and observations)
  drawingRevisionId   String? // → SheetRevision
  submittalId         String?
  meetingActionItemId String?
  exceptionId         String? // → ProjectException the event was raised from (the handoff, §2)
  status             String    @default("open") // open, pricing, priced, converted, closed, void
  activityId         String?
  locationId         String?
  romAmount          Decimal   @default(0) @db.Decimal(18, 2)
  scheduleImpactDays Int       @default(0)
  ownerChange        Boolean   @default(true)
  changeOrderId      String?
  convertedAt        DateTime?
  closedAt           DateTime?
  closedBy           String?
  voidReason         String?
  notes              String?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org         Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  activity    Activity?         @relation(fields: [activityId], references: [id], onDelete: SetNull)
  location    Location?         @relation(fields: [locationId], references: [id], onDelete: SetNull)
  changeOrder ChangeOrder?      @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)
  rfi                Rfi?               @relation(fields: [rfiId], references: [id], onDelete: SetNull)
  dailyLog           DailyLog?          @relation(fields: [dailyLogId], references: [id], onDelete: SetNull)
  ncr                NcrRecord?         @relation(fields: [ncrId], references: [id], onDelete: SetNull)
  punchItem          PunchItem?         @relation(fields: [punchItemId], references: [id], onDelete: SetNull)
  drawingRevision    SheetRevision?     @relation(fields: [drawingRevisionId], references: [id], onDelete: SetNull)
  submittal          Submittal?         @relation(fields: [submittalId], references: [id], onDelete: SetNull)
