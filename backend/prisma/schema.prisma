  deliveryJson   Json?
  error          String?
  requestedBy    String?
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())

  org      Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report   ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)
  schedule ReportSchedule?  @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  @@index([reportId, createdAt])
  @@index([orgId, createdAt])
}

