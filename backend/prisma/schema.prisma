  orgId           String
  projectId       String
  sheetId         String
  sheetRevisionId String? // revision the pin was dropped on
  x               Float // 0..1 of page width
  y               Float // 0..1 of page height
  recordType      String // rfi, defect, photo, punch_item, observation, â€¦
  recordId        String
  label           String?
  color           String?
  createdBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  sheet   Sheet        @relation(fields: [sheetId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, sheetId])
  @@index([projectId, recordType, recordId])
}

// â”€â”€â”€ Drawing intelligence (OCTA-AI-DWG-035) â”€â”€â”€
/** A cross-reference found on a sheet ("SEE S-201", "DETAIL 3/A-501"), resolved to the target sheet when it exists. */
model SheetReference {
  id            String   @id @default(uuid())
  orgId         String
  projectId     String
  sheetId       String
  revisionId    String?
  targetNumber  String
  targetSheetId String?
  count         Int      @default(1)
  samplesJson   Json     @default("[]")
  source        String   @default("text") // text, vision, manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project     Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  sheet       Sheet        @relation("SheetReferenceFrom", fields: [sheetId], references: [id], onDelete: Cascade)
  targetSheet Sheet?       @relation("SheetReferenceTo", fields: [targetSheetId], references: [id], onDelete: SetNull)

  @@unique([sheetId, targetNumber])
  @@index([orgId])
  @@index([projectId, targetSheetId])
}

// â”€â”€â”€ Specifications (OCTA-AI-SPEC-036) â”€â”€â”€
/** A section of a specification document found in its extracted text (CSI MasterFormat or generic numbering). */
model SpecSection {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  documentId String
  code       String // as printed, e.g. "03 30 00" or "5.3"
  codeKey    String // comparable form, e.g. "033000" or "5.3"
  division   String? // "03"
  title      String
  charStart  Int
  charEnd    Int
  pageFrom   Int?
  pageTo     Int?
  wordCount  Int      @default(0)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org      Organisation    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project         @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  document ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, charStart])
  @@index([orgId])
  @@index([projectId, codeKey])
  @@index([projectId, division])
}

// â”€â”€â”€ Timesheets and crews (OCTA-FLD-TIME-037) â”€â”€â”€
/** A person whose time is recorded â€” company-level, optionally a platform user. */
model Worker {
  id                 String   @id @default(uuid())
  orgId              String
  companyId          String?
  userId             String?
  name               String
  employeeNumber     String?
  trade              String?
  classification     String?
  hourlyRate         Decimal? @db.Decimal(18, 2)
  overtimeMultiplier Float    @default(1.5)
  status             String   @default("active") // active, inactive
  notes              String?
  createdBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org         Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  crewMembers CrewMember[]
  timeEntries TimeEntry[]

  @@unique([orgId, employeeNumber])
  @@index([orgId, status])
  @@index([companyId])
  @@index([userId])
}

/** A project crew: a named group of workers with default cost code / activity. */
model Crew {
  id                String   @id @default(uuid())
  orgId             String
  projectId         String
  name              String
  companyId         String?
  partyId           String?
  foremanUserId     String?
  defaultCostCodeId String?
  defaultActivityId String?
  status            String   @default("active") // active, inactive
  createdBy         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  members        CrewMember[]
  timesheets     Timesheet[]
  lookaheadItems LookaheadItem[]

  @@unique([projectId, name])
  @@index([orgId])
  @@index([projectId, status])
}

model CrewMember {
  id        String   @id @default(uuid())
  crewId    String
  workerId  String
  role      String   @default("member") // member, foreman
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  crew   Crew   @relation(fields: [crewId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([crewId, workerId])
  @@index([workerId])
}

/**
 * An uploaded IFC model (OCTA-BIM-IFC-043). Geometry is not stored â€” the
 * spatial breakdown, the elements and their properties and quantities are.
 */
model BimModel {
  id             String    @id @default(uuid())
  orgId          String
  projectId      String
  name           String
  discipline     String? // architectural, structural, mechanical, electrical, plumbing, civil, coordination, other
  documentId     String?
  ifcSchema      String? // IFC4, IFC2X3
  status         String    @default("processing") // processing, ready, failed
  version        Int       @default(1)
  // The code and date the revision was issued under (e.g. "C03", 2026-10-01); R01, R02… by upload order when not given.
  revisionCode   String?
  revisionDate   DateTime?
  isCurrent      Boolean   @default(true)
  supersededById String?
  ifcProjectName String?
  siteName       String?
  buildingName   String?
  unitsJson      Json      @default("{}")
  headerJson     Json      @default("{}")
  spatialJson    Json      @default("[]")
  warningsJson   Json      @default("[]")
  typeSummaryJson Json     @default("[]")
  elementCount   Int       @default(0)
  entityCount    Int       @default(0)
  storeyCount    Int       @default(0)
  linkedCount    Int       @default(0)
  parsedAt       DateTime?
  jobId          String?
  error          String?
  notes          String?
  uploadedBy     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org            Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  sourceDocument ProjectDocument? @relation("BimModelSource", fields: [documentId], references: [id], onDelete: SetNull)
  elements       BimElement[]
  links          BimElementLink[]

  @@unique([projectId, name, version])
  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, isCurrent])
}

/** One physical element (or space) of a model, with its base quantities. */
model BimElement {
  id             String   @id @default(uuid())
  orgId          String
  projectId      String
  modelId        String
  globalId       String
  ifcType        String
  name           String?
  description    String?
  objectType     String?
  predefinedType String?
  tag            String?
  typeName       String?
  storeyName     String?
  storeyGlobalId String?
  elevation      Float?
  spatialPath    String?
  materialsJson  Json     @default("[]")
  propertiesJson Json     @default("{}")
  netVolume      Float?
  grossVolume    Float?
  netArea        Float?
  grossArea      Float?
  length         Float?
  width          Float?
  height         Float?
  perimeter      Float?
  weight         Float?
  quantityCount  Float?
  searchText     String?
  linkCount      Int      @default(0)
  createdAt      DateTime @default(now())

  org     Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project          @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  model   BimModel         @relation(fields: [modelId], references: [id], onDelete: Cascade)
  links   BimElementLink[]

  @@unique([modelId, globalId])
  @@index([orgId])
  @@index([modelId, ifcType])
  @@index([modelId, storeyGlobalId])
  @@index([projectId, ifcType])
  @@index([projectId, globalId])
}

/** A model element tied to the rest of the project: an activity (4D), a location, a BOQ item, an issue. */
model BimElementLink {
  id           String   @id @default(uuid())
  orgId        String
  projectId    String
  modelId      String
  elementId    String
  recordType   String // activity, location, boq_item, punch_item, observation, rfi, ncr, task
  recordId     String
  relationType String   @default("represents") // represents, affects, reference
  notes        String?
  // Quantity provenance of a BOQ link (BIM/5D, BIM-5): which measured property
  // of the element, its raw value, the conversion and the converted quantity
  // in the BOQ item's unit, and how the link was made. Null on other links.
  quantityField String? // netVolume, grossVolume, netArea, grossArea, length, perimeter, weight, quantityCount
  rawQuantity   Float?
  factor        Float?
  quantity      Float?
  unit          String?
  method        String   @default("manual") // manual, bulk, rule, suggested
  createdBy    String?
  createdAt    DateTime @default(now())

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  model   BimModel     @relation(fields: [modelId], references: [id], onDelete: Cascade)
  element BimElement   @relation(fields: [elementId], references: [id], onDelete: Cascade)

  @@unique([elementId, recordType, recordId])
  @@index([orgId])
  @@index([projectId, recordType, recordId])
  @@index([modelId, recordType])
}

/**
 * A BOQ item's contract measurement rule for model quantities (BIM/5D,
 * BIM-5): which measured property of an element is the BOQ quantity, which
 * element types may be measured against the item, the conversion into the
 * item's unit and the rounding. Deterministic: OctaPM, never the AI, decides
 * whether an element is measured the contractual way.
 */
model BimMeasurementRule {
  id              String   @id @default(uuid())
  orgId           String
  projectId       String
  boqItemId       String
  quantityField   String // netVolume, grossVolume, netArea, grossArea, length, perimeter, weight, quantityCount
  allowedTypes    Json     @default("[]") // IFC entity types, e.g. ["IFCCOLUMN","IFCSLAB"]; [] = any
  factor          Float    @default(1)
  rounding        Int      @default(3)
  unit            String?
  includeText     String? // an element's name/type must contain this (case-insensitive)
  excludeText     String? // ... and must not contain this
  notes           String?
  createdBy       String?
  updatedBy       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  boqItem BoqItem      @relation(fields: [boqItemId], references: [id], onDelete: Cascade)

  @@unique([projectId, boqItemId])
  @@index([orgId])
}

/**
 * A model change under commercial review (BIM/5D, BIM-7/BIM-11): one element
 * added, removed or changed between two revisions of a model. Never a
 * contractual change by itself: it may be ignored, associated with an
 * existing change event, or turned into a DRAFT change event by a person.
 */
model BimChangeReview {
  id            String    @id @default(uuid())
  orgId         String
  projectId     String
  modelName     String
  fromModelId   String
  toModelId     String
  globalId      String
  kind          String // added, removed, modified
  status        String    @default("open") // open, ignored, associated, draft_created
  changeEventId String?
  note          String?
  decidedBy     String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([toModelId, globalId])
  @@index([orgId])
  @@index([projectId, status])
}

// ─── Project closeout / turnover (CLOSEOUT V1, 2026-10-11) ─────────────────

/**
 * The project's closeout: the three completion milestones, each recorded by a
 * person with a date and note — never set by the system. Readiness is derived
 * on read from the punch list, inspections, NCRs, submittals, RFIs, drawings,
 * subcontract closeouts, changes and IPCs; only a waiver of a derived check
 * is stored (checkWaiversJson: key -> { reason, by, at }).
 */
model ProjectCloseout {
  id                        String    @id @default(uuid())
  orgId                     String
  projectId                 String    @unique
  // in_progress, substantially_complete, handed_over, final_complete
  status                    String    @default("in_progress")
  substantialCompletionAt   DateTime?
  substantialCompletionBy   String?
  substantialCompletionNote String?
  handoverAt                DateTime?
  handoverBy                String?
  handoverNote              String?
  finalCompletionAt         DateTime?
  finalCompletionBy         String?
  finalCompletionNote       String?
  checkWaiversJson          Json      @default("{}")
  createdBy                 String?
  updatedBy                 String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, orgId])
  @@index([orgId])
}

/**
 * One turnover deliverable handed to the owner: as-builts, O&M manuals,
 * warranties, test and commissioning certificates, training, spares, keys,
 * authority certificates, lien waivers. Submitted with evidence by the
 * responsible party, accepted or rejected by a reviewer; a required one can
 * be waived or marked not applicable only with a reason.
 */
model CloseoutDeliverable {
  id                   String    @id @default(uuid())
  orgId                String
  projectId            String
  number               Int
  ref                  String
  category             String
  title                String
  description          String?
  required             Boolean   @default(true)
  // outstanding, submitted, accepted, rejected, waived, not_applicable
  status               String    @default("outstanding")
  responsibleCompanyId String?
  responsibleUserId    String?
  activityId           String?
  locationId           String?
  dueDate              DateTime?
  warrantyStart        DateTime?
  warrantyMonths       Int?
  warrantyEnd          DateTime?
  documentIdsJson      Json      @default("[]")
  submittedAt          DateTime?
  submittedBy          String?
  reviewedAt           DateTime?
  reviewedBy           String?
  reviewComment        String?
  waivedReason         String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  activity Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([projectId, ref])
  @@unique([projectId, number])
  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, category])
  @@index([activityId])
}

// ─── External review / consultant portal (CONSULTANT V1, 2026-10-11) ──────

/**
 * One record (RFI, submittal, progress report, ITP, NCR corrective action,
 * closeout deliverable) formally issued to a consultant party for review. The
 * one engine every module uses: the source record stays where it is; what was
 * issued, when, to whom and what came back live in the review cycles, each
 * preserved on its own. `status` decides who holds the action:
 * submitted / under_review → consultant; returned / revising / responded →
 * contractor; acknowledged / closed / withdrawn → nobody.
 */
model ExternalSubmission {
  id                String    @id @default(uuid())
  orgId             String
  projectId         String
  number            Int
  ref               String
  sourceType        String
  sourceId          String
  sourceRef         String?
  title             String
  activityId        String?
  partyId           String
  responsibleUserId String
  // submitted, under_review, returned, revising, responded, acknowledged, closed, withdrawn
  status            String    @default("submitted")
  revision          Int       @default(1)
  currentCycle      Int       @default(1)
  dueAt             DateTime
  decision          String?
  firstSubmittedAt  DateTime
  lastSubmittedAt   DateTime
  lastRespondedAt   DateTime?
  closedAt          DateTime?
  closedBy          String?
  closeReason       String?
  createdBy         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org        Organisation                  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project                       @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  party      ProjectParty                  @relation(fields: [partyId], references: [id], onDelete: Restrict)
  activity   Activity?                     @relation(fields: [activityId], references: [id], onDelete: SetNull)
  cycles     ExternalReviewCycle[]
  recipients ExternalSubmissionRecipient[]
  messages   ExternalReviewMessage[]

  @@unique([projectId, number])
  @@unique([projectId, ref])
  @@index([orgId])
  @@index([projectId, status])
  @@index([projectId, sourceType, sourceId])
  @@index([partyId, status])
  @@index([responsibleUserId, status])
  @@index([activityId])
}

/**
 * One issue of a submission and its answer, never rewritten: what was issued
 * (snapshot and files), when (submittedAt starts the review clock), the due
 * date, who it was with, when the reviewer first opened it, the decision with
 * its comments and when, and when the contractor acknowledged it.
 */
model ExternalReviewCycle {
  id                    String    @id @default(uuid())
  orgId                 String
  projectId             String
  submissionId          String
  cycle                 Int
  revision              Int
  partyId               String
  responsibleUserId     String
  coverNote             String?
  snapshotJson          Json      @default("{}")
  issuedDocumentIdsJson Json      @default("[]")
  submittedBy           String?
  submittedAt           DateTime
  dueAt                 DateTime
  firstOpenedAt         DateTime?
  firstOpenedBy         String?
  // open, responded, withdrawn
  status                String    @default("open")
  decision              String?
  decisionLabel         String?
  responseComment       String?
  respondedAt           DateTime?
  respondedBy           String?
  acknowledgedAt        DateTime?
  acknowledgedBy        String?
  withdrawnAt           DateTime?
  withdrawnBy           String?
  withdrawReason        String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org        Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project            @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  submission ExternalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, cycle])
  @@index([orgId])
  @@index([projectId, status])
}

/** Who a submission is addressed to: the responsible reviewer and the people copied. */
model ExternalSubmissionRecipient {
  id           String    @id @default(uuid())
  submissionId String
  userId       String
  partyId      String?
  // responsible, cc
  role         String
  addedBy      String?
  addedAt      DateTime  @default(now())
  removedAt    DateTime?

  submission ExternalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, userId])
  @@index([userId])
}

/**
 * Correspondence on a submission. `shared` is seen by the contractor and the
 * consultant participants; `internal` only by the contractor's own people —
 * never by a party.
 */
model ExternalReviewMessage {
  id           String   @id @default(uuid())
  orgId        String
  projectId    String
  submissionId String
  cycle        Int
  authorId     String?
  // contractor, consultant
  authorSide   String
  // shared, internal
  visibility   String   @default("shared")
  body         String
  createdAt    DateTime @default(now())

  org        Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project            @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  submission ExternalSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([submissionId, createdAt])
  @@index([orgId])
}

/**
 * A progress report the contractor issues (monthly by default): its period,
 * text and files, revised by number. What was issued for review is kept in
 * the external review cycles.
 */
model ProgressReport {
  id         String    @id @default(uuid())
  orgId      String
  projectId  String
  number     Int
  ref        String
  kind       String    @default("monthly")
  period     String
  title      String
  summary    String?
  // draft, issued
  status     String    @default("draft")
  revision   Int       @default(1)
  activityId String?
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  org      Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  activity Activity?    @relation(fields: [activityId], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@unique([projectId, ref])
  @@index([orgId])
  @@index([activityId])
}

/**
 * Conversations (OCTA-COMM-CONV-042): direct, group and per-record message threads
 * inside the organisation, optionally scoped to a project.
 */
model Conversation {
  id                 String    @id @default(uuid())
  orgId              String
  projectId          String?
  kind               String    @default("group") // direct, group, record
  title              String?
  directKey          String? // "<projectId|org>:<userA>:<userB>" â€” one direct thread per pair per scope
  recordType         String?
  recordId           String?
  recordTitle        String?
  lastMessageAt      DateTime?
  lastMessagePreview String?
  messageCount       Int       @default(0)
  archivedAt         DateTime?
  archivedBy         String?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org           Organisation          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project       Project?              @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  members       ConversationMember[]
  messages      ConversationMessage[]
  inboundEmails InboundEmail[]

  @@unique([orgId, directKey])
  @@index([orgId, lastMessageAt])
  @@index([projectId, kind])
  @@index([orgId, recordType, recordId])
}

model ConversationMember {
  id             String    @id @default(uuid())
  orgId          String
  conversationId String
  userId         String
  role           String    @default("member") // member, admin
  lastReadAt     DateTime?
  starred        Boolean   @default(false)
  muted          Boolean   @default(false)
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?

  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([orgId])
  @@index([userId, leftAt])
}

model ConversationMessage {
  id                String    @id @default(uuid())
  orgId             String
  conversationId    String
  authorId          String?
  kind              String    @default("text") // text, system, email
  body              String
  mentionsJson      Json      @default("[]") // [{ userId, name }]
  linkedRecordType  String?
  linkedRecordId    String?
  linkedRecordTitle String?
  linkedProjectId   String?
  inboundEmailId    String?
  editedAt          DateTime?
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime  @default(now())

  org          Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?        @relation("ConversationMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([conversationId, createdAt])
  @@index([authorId])
}

/** An email received on a project inbox, a reply-to-record or a reply-to-conversation address (OCTA-COMM-CONV-042). */
model InboundEmail {
  id               String    @id @default(uuid())
  orgId            String
  projectId        String?
  provider         String
  messageId        String?
  inReplyTo        String?
  referencesJson   Json      @default("[]")
  fromEmail        String
  fromName         String?
  toJson           Json      @default("[]")
  ccJson           Json      @default("[]")
  subject          String
  textBody         String
  htmlBody         String?
  replyText        String? // the new text without the quoted thread
  attachmentsJson  Json      @default("[]")
  receivedAt       DateTime  @default(now())
  status           String    @default("received") // received, posted, logged, linked, ignored, unmatched, rejected
  target           String? // project, record, conversation
