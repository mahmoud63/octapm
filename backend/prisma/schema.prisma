model DailyLogVisitor {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  name            String
  company         String?
  purpose         String?
  arrivedAt       DateTime?
  leftAt          DateTime?
  notes           String?
  status          String    @default("approved")
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, clientRequestId])
  @@index([dailyLogId])
}

/** Lost time; `source = weather_feed` rows are suggestions raised by the weather job. */
model DailyLogDelay {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  type            String    @default("other") // weather, access, design, material, labour, equipment, inspection, utility, other
  description     String
  hoursLost       Float     @default(0)
  activityId      String?
  locationId      String?
  source          String    @default("manual") // manual, weather_feed
  weatherDelayId  String?
  notes           String?
  status          String    @default("approved")
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, clientRequestId])
  @@index([dailyLogId])
  @@index([projectId, type])
  @@index([projectId, activityId])
}

model DailyLogNote {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  kind            String    @default("general") // general, safety, instruction, inspection, issue
  text            String
  activityId      String?
  locationId      String?
  status          String    @default("approved")
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog DailyLog @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  @@unique([projectId, clientRequestId])
  @@index([dailyLogId])
  @@index([projectId, kind])
}

/**
 * The daily log's seventh section (PC-6, OCTAPM_PROGRESS_MEASUREMENT.md §4):
 * a quantity of a BOQ item installed on an activity that day, as the site
 * recorded it. Same columns, status semantics, party column, composite tenant
 * key and indexes as the six sections above, but with Prisma relations to the
 * things it names. It is a site record only: submitting the log mints a
 * QuantityProgressEntry (`source = daily_log`, `status = submitted`) that the
 * progress approvers make official — this row never is the installed figure.
 *
 * ON DELETE: dailyLog / org / project Cascade exactly like the siblings (a
 * section row is part of its log). activity and boqItem Restrict: the row is
 * a signed site record on the log's PDF, and the entry it minted keeps the
 * same keys — a hard delete of the activity or item is refused rather than
 * quietly emptying a submitted log. allocation and location SetNull as on
 * QuantityProgressEntry (hints, not the truth).
 */
model DailyLogQuantity {
  id              String    @id @default(uuid())
  orgId           String
  projectId       String
  dailyLogId      String
  partyId         String?
  activityId      String
  boqItemId       String
  allocationId    String?
  locationId      String?
  quantity        Decimal   @db.Decimal(18, 3)
  unitCode        String
  notes           String?
  status          String    @default("approved") // draft, submitted, approved, rejected — the section row's own review state, never progress
  createdBy       String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedAt      DateTime?
  rejectionReason String?
  clientRequestId String?
  sortOrder       Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  dailyLog        DailyLog               @relation(fields: [dailyLogId], references: [id], onDelete: Cascade)
  org             Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project         Project                @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  activity        Activity               @relation(fields: [activityId], references: [id], onDelete: Restrict)
  boqItem         BoqItem                @relation(fields: [boqItemId], references: [id], onDelete: Restrict)
  allocation      ActivityBoqAllocation? @relation(fields: [allocationId], references: [id], onDelete: SetNull)
  location        Location?              @relation(fields: [locationId], references: [id], onDelete: SetNull)
  progressEntries QuantityProgressEntry[]

  @@unique([projectId, clientRequestId])
  @@index([dailyLogId])
  @@index([projectId, activityId])
  @@index([projectId, boqItemId])
  @@index([allocationId])
  @@index([locationId])
}

// â”€â”€â”€ Report builder & portfolio (OCTA-RPT-BUILDER-023) â”€â”€â”€
/** A saved report: a source, the columns to show, filters, sort, grouping and chart. */
model ReportDefinition {
  id             String    @id @default(uuid())
  orgId          String
  projectId      String? // null = every project the viewer can see
  name           String
  description    String?
  source         String
  columnsJson    Json      @default("[]")
  filtersJson    Json      @default("[]")
  sortJson       Json?
  groupBy        String?
  aggregatesJson Json      @default("[]")
  chartJson      Json?
  visibility     String    @default("private") // private, project, org
  createdBy      String?
  updatedBy      String?
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org       Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project   Project?         @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  schedules ReportSchedule[]
  runs      ReportRun[]

  @@index([orgId, projectId])
  @@index([orgId, createdBy])
  @@index([orgId, visibility])
}

/**
 * A saved Gantt arrangement: timescale, zoom, where the splitter rests, whether
 * the baseline and the resource histogram are shown, and which WBS rows are
 * collapsed. The equivalent of a P6 layout.
 *
 * `private` is the author's own; `project` shares it with everyone who can open
 * the project. Layouts name collapsed rows of one schedule, so they stay
 * project-scoped rather than offering an org-wide variant that would not
 * travel meaningfully.
 */
model GanttLayout {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  name       String
  visibility String   @default("private") // private, project
  layoutJson Json
  createdBy  String?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)

  // One name per author per project, so "save" updates rather than duplicates.
  @@unique([projectId, createdBy, name])
  @@index([orgId, projectId])
  @@index([orgId, createdBy])
}

/** When a report renders itself and who gets it. */
model ReportSchedule {
  id             String    @id @default(uuid())
  orgId          String
  reportId       String
  frequency      String    @default("weekly") // daily, weekly, monthly
  dayOfWeek      Int       @default(1) // 0 = Sunday
  dayOfMonth     Int       @default(1)
  hour           Int       @default(7)
  minute         Int       @default(0)
  timezone       String    @default("UTC")
  format         String    @default("pdf") // pdf, xlsx, both
  recipientsJson Json      @default("{}") // { userIds, roles, emails }
  enabled        Boolean   @default(true)
  nextRunAt      DateTime?
  lastRunAt      DateTime?
  lastStatus     String?
  lastError      String?
  createdBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  org    Organisation     @relation(fields: [orgId], references: [id], onDelete: Cascade)
  report ReportDefinition @relation(fields: [reportId], references: [id], onDelete: Cascade)
  runs   ReportRun[]

  @@index([enabled, nextRunAt])
  @@index([reportId])
}

/** One rendering of a report, with the files it produced and how it was delivered. */
model ReportRun {
  id             String    @id @default(uuid())
  orgId          String
  reportId       String
  scheduleId     String?
  status         String    @default("queued") // queued, running, succeeded, failed
  trigger        String    @default("manual") // manual, schedule
