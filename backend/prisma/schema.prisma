  @@index([orgId, tool, status])
}

model CustomFieldValue {
  id         String   @id @default(uuid())
  orgId      String
  projectId  String
  recordType String
  recordId   String
  fieldId    String
  valueJson  Json?
  updatedBy  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  organisation Organisation          @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project      Project               @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
