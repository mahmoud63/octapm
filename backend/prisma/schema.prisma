  ipAddress    String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  membershipId String?   // the membership acceptance created or activated (M3 backfill for accepted rows)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectParty ProjectParty? @relation(fields: [projectPartyId], references: [id], onDelete: SetNull)
  invitedBy  User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  membership OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([companyId])
  @@index([projectPartyId])
  @@index([membershipId])
  @@index([orgId, email])
  @@index([orgId, status])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
}

