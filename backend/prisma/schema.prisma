// â”€â”€â”€ The client contract (OCTA-COM-PRIME-051) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/**
 * The commercial envelope of the contract with the client.
 *
 * One per project. The BOQ is the schedule of values â€” this holds what the BOQ
 * cannot: what was originally agreed, what approved client change orders have
 * done to it, and the terms that turn certified work into a sum of money
 * (retention, advance and its recovery, tax, payment days).
 *
 * revisedValue is stored rather than computed on read because every downstream
 * figure â€” over-certification limits, forecast, cash flow â€” compares against
 * it, and they must all see the same number at the same moment.
 */
model PrimeContract {
  id                     String    @id @default(uuid())
  orgId                  String
  projectId              String    @unique
  ref                    String
  title                  String
  clientCompanyId        String?
  contractType           String    @default("lump_sum") // lump_sum, remeasured, cost_plus, gmp
  currency               String    @default("USD")
  originalValue          Decimal   @default(0) @db.Decimal(18, 2)
  // Where originalValue came from (owner decisions 1 + 4, 2026-09-29):
  // project_value (the project's established contract value, taken when the
  // contract was first built), contract_entry (entered or confirmed through
  // the authorised contract process), boq_fallback (the automatic BOQ total,
  // used when the project had no value), unestablished (a historical row whose
  // source cannot be reliably shown). NULL predates this column: treat it as
  // unestablished.
  originalValueSource    String?
  approvedChangesValue   Decimal   @default(0) @db.Decimal(18, 2)
  pendingChangesValue    Decimal   @default(0) @db.Decimal(18, 2)
  revisedValue           Decimal   @default(0) @db.Decimal(18, 2)
  retentionRate          Float     @default(5)
  // Retention stops accruing once it reaches this share of the contract value.
  retentionCapRate       Float?
  advanceRate            Float     @default(0)
  advanceAmount          Decimal   @default(0) @db.Decimal(18, 2)
  advancePaidAmount      Decimal   @default(0) @db.Decimal(18, 2)
  // Share of each gross certificate withheld to pay the advance back.
  advanceRecoveryRate    Float     @default(0)
  advanceRecoveredAmount Decimal   @default(0) @db.Decimal(18, 2)
  // Share of stored-material value that may be certified before installation.
  materialsOnSiteRate    Float     @default(100)
  taxRate                Float     @default(0)
  paymentTermsDays       Int       @default(30)
  startDate              DateTime?
  completionDate         DateTime?
  status                 String    @default("active") // draft, active, closed
  notes                  String?
  createdBy              String?
  updatedBy              String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  org           Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project       Project                @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  clientCompany Company?               @relation("PrimeContractClient", fields: [clientCompanyId], references: [id], onDelete: SetNull)
  advances      PrimeContractAdvance[]

  @@unique([projectId, orgId])
  @@unique([orgId, ref])
  @@index([orgId])
  @@index([clientCompanyId])
}

/**
 * The advance-payment ledger: what the client paid up front, and every
 * recovery taken out of a certificate since.
 *
 * Append-only, like the stock ledger, so the outstanding advance is always the
 * sum of its rows rather than a counter somebody can quietly edit.
 */
model PrimeContractAdvance {
  id            String   @id @default(uuid())
  orgId         String
  projectId     String
  contractId    String
  reference     String
  kind          String   @default("payment") // payment, recovery
  amount        Decimal  @default(0) @db.Decimal(18, 2)
  certificateId String?
  occurredAt    DateTime @default(now())
  note          String?
  createdBy     String?
  createdAt     DateTime @default(now())

  org      Organisation  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project       @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  contract PrimeContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@unique([projectId, reference])
  @@index([orgId])
  @@index([contractId, kind])
  @@index([certificateId])
}

model Risk {
  id                  String    @id @default(uuid())
  projectId           String
  ref                 String
  description         String
  probability         String    @default("medium") // low, medium, high
  impact              String    @default("medium") // low, medium, high
  severity            String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  mitigation          String?
  responsePlan        String?
  residualProbability String    @default("medium")
  residualImpact      String    @default("medium")
  residualSeverity    String    @default("MEDIUM")
  residualDescription String?
  phase               String?
  owner               String?
  ownerUserId         String?
