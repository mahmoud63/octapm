/**
 * Quantity progress (PC-6, OCTAPM_PROGRESS_MEASUREMENT.md §3): one installed
 * quantity of one BOQ item on one activity on one day. It is un-official until
 * `status = approved`; the installed quantity of an item or activity is always
 * Σ approved entries — nothing stores an "installed" figure on BoqItem,
 * Activity or ActivityBoqAllocation, so received, issued, installed, certified
 * and paid stay five separate truths. EV keeps reading ActivityProgress only:
 * approving a quantity-method ProgressSubmission approves the entries it
 * bundles (`submissionId`) and writes the resulting pct through the existing
 * writer. `source` + `submissionId` / `dailyLogId` / `dailyLogQuantityId` are
 * the PROGRESS SOURCE provenance of every figure.
 *
 * Tenancy: project + organisation with the ENT-3 composite key
 * (projectId, orgId) → Project(id, orgId), like the DailyLog sections and
 * BudgetLine — a row of another organisation's project is refused by the
 * database, not by code.
 *
 * ON DELETE, each chosen deliberately:
 *   org / project      Cascade  — the tenant owns its rows (every P+O table).
 *   activity, boqItem  Restrict — an entry is source data for an official
 *                                 figure; it must never vanish silently with
 *                                 a hard delete. Same as ActivityProgress →
 *                                 Activity, and the activity delete already
 *                                 answers P2003 with 409 ACTIVITY_IN_USE.
 *   allocation         SetNull  — the mapping row is replaceable (rejected,
 *                                 superseded); the activity + item pair is
 *                                 the truth, the allocation only a hint.
 *   location           SetNull  — as ProgressSubmission.location.
 *   submission         SetNull  — as ActivityProgress.submission: the entry
 *                                 outlives the bundle that approved it.
 *   dailyLog,
 *   dailyLogQuantity   SetNull  — an approved entry is progress, not a
 *                                 daily-log line; removing the log must not
 *                                 remove approved progress (source + date
 *                                 keep the provenance readable).
 */
model QuantityProgressEntry {
  id                 String    @id @default(uuid())
  orgId              String
  projectId          String
  activityId         String
  boqItemId          String
  allocationId       String?
  locationId         String?
  unitCode           String
  quantity           Decimal   @db.Decimal(18, 3)
  date               DateTime  @db.Date // the calendar day the work was done
  source             String    @default("manual") // submission, daily_log, manual, import
  submissionId       String? // the ProgressSubmission that bundles (and approves) it
  dailyLogId         String?
  dailyLogQuantityId String?
  status             String    @default("draft") // draft, submitted, approved, rejected
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionReason    String?
  clientRequestId    String? // idempotent replay (offline outbox)
  note               String?
  createdBy          String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org              Organisation           @relation(fields: [orgId], references: [id], onDelete: Cascade)
