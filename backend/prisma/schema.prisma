generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organisation & Users ───
model Organisation {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("standard")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users               User[]
  refreshSessions     RefreshSession[]
  passwordResetTokens PasswordResetToken[]
  invitationTokens    InvitationToken[]
  authAuditEvents     AuthAuditEvent[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  companies           Company[]
  companyMemberships  CompanyMembership[]
  projects            Project[]
  meetings            Meeting[]
  meetingAttendees    MeetingAttendee[]
  meetingAgendaItems  MeetingAgendaItem[]
  meetingDecisions    MeetingDecision[]
  meetingActionItems  MeetingActionItem[]
  meetingDistributions MeetingDistribution[]
  meetingComments     MeetingComment[]
  tasks               Task[]
  taskComments        TaskComment[]
  taskAttachments     TaskAttachment[]
  taskHistoryEvents   TaskHistory[]
  projectDocuments    ProjectDocument[]
  userSettings        UserSetting[]
  subscription        Subscription?
  enterpriseLeads     EnterpriseLead[]
  locations           Location[]
  permissionTemplates PermissionTemplate[]
  projectUserPermissions ProjectUserPermission[]
  attachments         Attachment[]
  photos              Photo[]
  costCodes           CostCode[]
  companyEquipment    CompanyEquipment[]
  projectTemplates    ProjectTemplate[]
  comments            Comment[]
  commentMentions     CommentMention[]
  recordSubscriptions RecordSubscription[]
  documentTexts       DocumentText[]
  documentChunks      DocumentChunk[]
  drawingSets         DrawingSet[]
  sheets              Sheet[]
  sheetRevisions      SheetRevision[]
}

model User {
  id           String    @id @default(uuid())
  orgId        String
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("site_engineer") // super_admin, pm, planning_eng, qs, cost_controller, procurement, warehouse, site_engineer, finance
  isCompanyAdmin Boolean @default(false) // org-wide project visibility + permission/user administration
  status       String    @default("active")
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org                     Organisation         @relation(fields: [orgId], references: [id])
  projectAssignments      ProjectAssignment[]
  projectPermissions      ProjectUserPermission[] @relation("ProjectUserPermissionUser")
  activityAssignments     ActivityAssignment[]
  refreshSessions         RefreshSession[]
  passwordResetTokens     PasswordResetToken[]
  sentInvitations         InvitationToken[]    @relation("InvitationInvitedBy")
  acceptedInvitations     InvitationToken[]    @relation("InvitationAcceptedBy")
  authAuditEvents         AuthAuditEvent[]     @relation("AuthAuditUser")
  authoredAuthAuditEvents AuthAuditEvent[]     @relation("AuthAuditActor")
  settings                UserSetting?
  dailyReports            DailyReport[]
  siteDiaries             SiteDiary[]
  notifications           Notification[]      @relation("NotificationRecipient")
  actedNotifications      Notification[]      @relation("NotificationActor")
  notificationPrefs       NotificationPreference[]
  companyMemberships      CompanyMembership[]
  projectPartyMemberships ProjectPartyMember[]
  chairedMeetings         Meeting[]              @relation("MeetingChair")
  createdMeetings         Meeting[]              @relation("MeetingCreatedBy")
  updatedMeetings         Meeting[]              @relation("MeetingUpdatedBy")
  distributedMeetings     Meeting[]              @relation("MeetingDistributedBy")
  meetingAttendees        MeetingAttendee[]      @relation("MeetingAttendeeUser")
  meetingAgendaItems      MeetingAgendaItem[]    @relation("MeetingAgendaPresenter")
  meetingDecisions        MeetingDecision[]      @relation("MeetingDecisionDecidedBy")
  meetingActionItems      MeetingActionItem[]    @relation("MeetingActionOwner")
  meetingDistributionRecipients MeetingDistribution[] @relation("MeetingDistributionRecipient")
  sentMeetingDistributions      MeetingDistribution[] @relation("MeetingDistributionSender")
  meetingComments         MeetingComment[]       @relation("MeetingCommentAuthor")
  assignedTasks           Task[]              @relation("TaskAssignee")
  createdTasks            Task[]              @relation("TaskCreatedBy")
  updatedTasks            Task[]              @relation("TaskUpdatedBy")
  closedTasks             Task[]              @relation("TaskClosedBy")
  taskComments            TaskComment[]       @relation("TaskCommentAuthor")
  taskAttachments         TaskAttachment[]    @relation("TaskAttachmentUploader")
  taskHistoryEvents       TaskHistory[]       @relation("TaskHistoryActor")
  authoredComments        Comment[]           @relation("CommentAuthor")
  commentMentions         CommentMention[]    @relation("CommentMentionUser")
  recordSubscriptions     RecordSubscription[] @relation("RecordSubscriptionUser")

  // Accountability references (OCTA-DATA-REFS-004): owner / reviewer / approver /
  // assignee / ball-in-court per record type.
  riskOwner               Risk[]              @relation("RiskOwnerUser")
  riskReviewer            Risk[]              @relation("RiskReviewerUser")
  riskApprover            Risk[]              @relation("RiskApproverUser")
  riskAssignee            Risk[]              @relation("RiskAssigneeUser")
  riskBallInCourt         Risk[]              @relation("RiskBallInCourtUser")
  ncrOwner                NcrRecord[]         @relation("NcrOwnerUser")
  ncrReviewer             NcrRecord[]         @relation("NcrReviewerUser")
  ncrApprover             NcrRecord[]         @relation("NcrApproverUser")
  ncrAssignee             NcrRecord[]         @relation("NcrAssigneeUser")
  ncrBallInCourt          NcrRecord[]         @relation("NcrBallInCourtUser")
  itpOwner                ItpRecord[]         @relation("ItpOwnerUser")
  itpReviewer             ItpRecord[]         @relation("ItpReviewerUser")
  itpApprover             ItpRecord[]         @relation("ItpApproverUser")
  itpAssignee             ItpRecord[]         @relation("ItpAssigneeUser")
  itpBallInCourt          ItpRecord[]         @relation("ItpBallInCourtUser")
  defectOwner             DefectRecord[]      @relation("DefectOwnerUser")
  defectReviewer          DefectRecord[]      @relation("DefectReviewerUser")
  defectApprover          DefectRecord[]      @relation("DefectApproverUser")
  defectAssignee          DefectRecord[]      @relation("DefectAssigneeUser")
  defectBallInCourt       DefectRecord[]      @relation("DefectBallInCourtUser")
  safetyOwner             SafetyIncident[]    @relation("SafetyOwnerUser")
  safetyReviewer          SafetyIncident[]    @relation("SafetyReviewerUser")
  safetyApprover          SafetyIncident[]    @relation("SafetyApproverUser")
  safetyAssignee          SafetyIncident[]    @relation("SafetyAssigneeUser")
  safetyBallInCourt       SafetyIncident[]    @relation("SafetyBallInCourtUser")
  materialTestOwner       MaterialTest[]      @relation("MaterialTestOwnerUser")
  materialTestReviewer    MaterialTest[]      @relation("MaterialTestReviewerUser")
  materialTestApprover    MaterialTest[]      @relation("MaterialTestApproverUser")
  materialTestAssignee    MaterialTest[]      @relation("MaterialTestAssigneeUser")
  materialTestBallInCourt MaterialTest[]      @relation("MaterialTestBallInCourtUser")
  rfiOwner                Rfi[]               @relation("RfiOwnerUser")
  rfiReviewer             Rfi[]               @relation("RfiReviewerUser")
  rfiApprover             Rfi[]               @relation("RfiApproverUser")
  rfiAssignee             Rfi[]               @relation("RfiAssigneeUser")
  rfiBallInCourt          Rfi[]               @relation("RfiBallInCourtUser")
  submittalOwner          Submittal[]         @relation("SubmittalOwnerUser")
  submittalReviewer       Submittal[]         @relation("SubmittalReviewerUser")
  submittalApprover       Submittal[]         @relation("SubmittalApproverUser")
  submittalAssignee       Submittal[]         @relation("SubmittalAssigneeUser")
  submittalBallInCourt    Submittal[]         @relation("SubmittalBallInCourtUser")
  drawingOwner            DrawingRecord[]     @relation("DrawingOwnerUser")
  drawingReviewer         DrawingRecord[]     @relation("DrawingReviewerUser")
  drawingApprover         DrawingRecord[]     @relation("DrawingApproverUser")
  drawingAssignee         DrawingRecord[]     @relation("DrawingAssigneeUser")
  drawingBallInCourt      DrawingRecord[]     @relation("DrawingBallInCourtUser")
  transmittalOwner        Transmittal[]       @relation("TransmittalOwnerUser")
  transmittalReviewer     Transmittal[]       @relation("TransmittalReviewerUser")
  transmittalApprover     Transmittal[]       @relation("TransmittalApproverUser")
  transmittalAssignee     Transmittal[]       @relation("TransmittalAssigneeUser")
  transmittalBallInCourt  Transmittal[]       @relation("TransmittalBallInCourtUser")
  correspondenceOwner     Correspondence[]    @relation("CorrespondenceOwnerUser")
  correspondenceReviewer  Correspondence[]    @relation("CorrespondenceReviewerUser")
  correspondenceApprover  Correspondence[]    @relation("CorrespondenceApproverUser")
  correspondenceAssignee  Correspondence[]    @relation("CorrespondenceAssigneeUser")
  correspondenceBallInCourt Correspondence[]  @relation("CorrespondenceBallInCourtUser")

  @@index([orgId])
  @@index([email])
}

// ─── Projects ───
model UserSetting {
  id                String    @id @default(uuid())
  orgId             String
  userId            String    @unique
  profileUsername   String?
  profileBio        String?
  profileUrls       Json      @default("[]")
  dateOfBirth       DateTime?
  language          String    @default("en")
  appearanceTheme   String    @default("dark")
  appearanceFont    String    @default("inter")
  displayItems      Json      @default("[\"dashboard\",\"projects\",\"tasks\",\"users\",\"help-center\"]")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([orgId, userId])
}

enum ProjectPartyRole {
  owner
  consultant
  contractor
  subcontractor
}

model Company {
  id                 String   @id @default(uuid())
  orgId              String
  name               String
  legalName          String?
  tradeName          String?
  registrationNumber String?
  taxNumber          String?
  type               String   @default("external")
  email              String?
  phone              String?
  website            String?
  address            String?
  contactName        String?
  // Vendor profile (OCTA-ADM-COMPANY-007): a company defined once and reused
  // as a supplier on every project.
  isVendor           Boolean  @default(false)
  trades             String[] @default([])
  vendorProfileJson  Json     @default("{}")
  status             String   @default("active")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  org              Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  memberships      CompanyMembership[]
  projectParties   ProjectParty[]
  invitationTokens InvitationToken[]
  procurementSuppliers ProcurementSupplier[]
  riskAssignments           Risk[]           @relation("RiskAssigneeCompany")
  ncrAssignments            NcrRecord[]      @relation("NcrAssigneeCompany")
  itpAssignments            ItpRecord[]      @relation("ItpAssigneeCompany")
  defectAssignments         DefectRecord[]   @relation("DefectAssigneeCompany")
  safetyAssignments         SafetyIncident[] @relation("SafetyAssigneeCompany")
  materialTestAssignments   MaterialTest[]   @relation("MaterialTestAssigneeCompany")
  rfiAssignments            Rfi[]            @relation("RfiAssigneeCompany")
  submittalAssignments      Submittal[]      @relation("SubmittalAssigneeCompany")
  drawingAssignments        DrawingRecord[]  @relation("DrawingAssigneeCompany")
  transmittalAssignments    Transmittal[]    @relation("TransmittalAssigneeCompany")
  correspondenceAssignments Correspondence[] @relation("CorrespondenceAssigneeCompany")

  @@unique([orgId, name])
  @@index([orgId])
  @@index([orgId, status])
  @@index([orgId, isVendor])
}

model CompanyMembership {
  id        String   @id @default(uuid())
  orgId     String
  companyId String
  userId    String
  role      String   @default("member")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org                 Organisation         @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectPartyMembers ProjectPartyMember[]

  @@unique([companyId, userId])
  @@index([orgId])
  @@index([orgId, userId])
  @@index([companyId])
  @@index([userId])
}

model Project {
  id                    String    @id @default(uuid())
  orgId                 String
  name                  String
  type                  String?
  location              String?
  clientName            String?
  consultantName        String?
  contractorName        String?
  contractType          String?
  contractNumber        String?
  startDate             DateTime?
  endDate               DateTime?
  completionDate        DateTime?
  baselineDate          DateTime?
  dataDate              DateTime?
  revisedCompletionDate DateTime?
  duration              Int?
  durationUnit          String    @default("months")
  contractValue         Decimal?  @db.Decimal(18, 2)
  defaultRetentionRate  Float?
  ldRatePerDay          Decimal   @default(0) @db.Decimal(18, 2)
  weatherAllowanceDays  Int       @default(20)
  projectCalendar       String?
  reportingCutoffDay    Int?
  currency              String    @default("USD")
  status                String    @default("active")
  templateId            String? // ProjectTemplate the project was created from
  documentFoldersJson   Json      @default("[]") // predefined document folder paths
  archivedAt            DateTime?
  archivedBy            String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org                           Organisation                   @relation(fields: [orgId], references: [id])
  template                      ProjectTemplate?               @relation(fields: [templateId], references: [id], onDelete: SetNull)
  assignments                   ProjectAssignment[]
  parties                       ProjectParty[]
  invitationTokens              InvitationToken[]
  authAuditEvents               AuthAuditEvent[]
  boqRevisions                  BoqRevision[]
  boqItems                      BoqItem[]
  boqActivities                 BoqActivity[]
  activityBoqAllocations        ActivityBoqAllocation[]
  activities                    Activity[]
  activityDependencies          ActivityDependency[]
  scheduleRevisions             ScheduleRevision[]
  costRecords                   CostRecord[]
  burnRateEntries               BurnRateEntry[]
  risks                         Risk[]
  riskActivityLinks             RiskActivityLink[]
  longLeadItems                 LongLeadItem[]
  procurementSuppliers          ProcurementSupplier[]
  procurementPackages           ProcurementPackage[]
  procurementPoLines            ProcurementPoLine[]
  deliveryReceipts              DeliveryReceipt[]
  deliveryReceiptLines          DeliveryReceiptLine[]
  activityMaterialUsages        ActivityMaterialUsage[]
  activityEquipmentUsages       ActivityEquipmentUsage[]
  procurementLeadTimeAlerts     ProcurementLeadTimeAlert[]
  changeOrders                  ChangeOrder[]
  changeOrderActivityLinks      ChangeOrderActivityLink[]
  changeOrderAllocationLinks    ChangeOrderAllocationLink[]
  ipcItems                      IpcItem[]
  ipcItemProgressLinks          IpcItemProgressLink[]
  ipcCertificates               IpcCertificate[]
  ipcInvoices                   IpcInvoice[]
  ipcPayments                   IpcPayment[]
  ipcRetentionReleases          IpcRetentionRelease[]
  subValuations                 SubValuation[]
  subValuationActivityLinks     SubValuationActivityLink[]
  subValuationAllocationLinks   SubValuationAllocationLink[]
  budgetRevisions               BudgetRevision[]
  reportingPeriods              ReportingPeriod[]
  activityCostLoadings          ActivityCostLoading[]
  evPeriodSnapshots             EvPeriodSnapshot[]
  activityProgressMethods       ActivityProgressMethod[]
  progressSubmissions           ProgressSubmission[]
  cashFlowEntries               CashFlowEntry[]
  eotClaims                     EotClaim[]
  eotClaimActivityLinks         EotClaimActivityLink[]
  eotClaimWeatherDelayLinks     EotClaimWeatherDelayLink[]
  weatherDelays                 WeatherDelay[]
  weatherDelayActivityLinks     WeatherDelayActivityLink[]
  procurementOrders             ProcurementOrder[]
  materialMaster                MaterialMaster[]
  equipment                     Equipment[]
  itpRecords                    ItpRecord[]
  ncrRecords                    NcrRecord[]
  defectRecords                 DefectRecord[]
  safetyIncidents               SafetyIncident[]
  materialTests                 MaterialTest[]
  rfis                          Rfi[]
  submittals                    Submittal[]
  drawingRecords                DrawingRecord[]
  transmittals                  Transmittal[]
  correspondences               Correspondence[]
  workflowAttachments           WorkflowAttachment[]
  workflowStatusHistory         WorkflowStatusHistory[]
  approvalWorkflowEvents        ApprovalWorkflowEvent[]
  workflowActivityLinks         WorkflowActivityLink[]
  documentRevisions             DocumentRevision[]
  projectDocuments              ProjectDocument[]
  commercialCorrespondenceLinks CommercialCorrespondenceLink[]
  commercialAttachmentRefs      CommercialAttachmentRef[]
  dailyReports                  DailyReport[]
  siteDiary                     SiteDiary[]
  weeklyReports                 WeeklyReport[]
  resourceAllocations           ResourceAllocation[]
  activityMaterials             ActivityMaterial[]
  meetings                      Meeting[]
  meetingAttendees              MeetingAttendee[]
  meetingAgendaItems            MeetingAgendaItem[]
  meetingDecisions              MeetingDecision[]
  meetingActionItems            MeetingActionItem[]
  meetingDistributions          MeetingDistribution[]
  meetingComments               MeetingComment[]
  tasks                         Task[]
  taskComments                  TaskComment[]
  taskAttachments               TaskAttachment[]
  taskHistoryEvents             TaskHistory[]
  notifications                 Notification[]
  locations                     Location[]
  userPermissions               ProjectUserPermission[]
  attachments                   Attachment[]
  photos                        Photo[]
  comments                      Comment[]
  recordSubscriptions           RecordSubscription[]
  documentTexts                 DocumentText[]
  documentChunks                DocumentChunk[]
  drawingSets                   DrawingSet[]
  sheets                        Sheet[]
  sheetRevisions                SheetRevision[]

  @@index([orgId])
  @@index([orgId, status, archivedAt])
  @@index([templateId])
}

model ProjectParty {
  id                   String           @id @default(uuid())
  projectId            String
  companyId            String
  role                 ProjectPartyRole
  contactName          String?
  contactEmail         String?
  contactPhone         String?
  accessLevel          String           @default("collaborator")
  permissionProfile    String?
  permissionsJson      Json             @default("{}")
  permissionTemplateId String?
  status               String           @default("active")
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  project                       Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company                       Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  permissionTemplate            PermissionTemplate?  @relation(fields: [permissionTemplateId], references: [id], onDelete: SetNull)
  members                       ProjectPartyMember[]
  invitationTokens              InvitationToken[]
  rfiOwnerAssignments           Rfi[]                @relation("RfiOwnerParty")
  rfiReviewerAssignments        Rfi[]                @relation("RfiReviewerParty")
  rfiApproverAssignments        Rfi[]                @relation("RfiApproverParty")
  submittalOwnerAssignments     Submittal[]          @relation("SubmittalOwnerParty")
  submittalReviewerAssignments  Submittal[]          @relation("SubmittalReviewerParty")
  submittalApproverAssignments  Submittal[]          @relation("SubmittalApproverParty")
  meetingAttendees              MeetingAttendee[]
  meetingDistributions          MeetingDistribution[]

  @@unique([projectId, companyId, role])
  @@index([projectId])
  @@index([projectId, role])
  @@index([companyId])
  @@index([permissionTemplateId])
  @@index([status])
}

model ProjectPartyMember {
  id                  String    @id @default(uuid())
  projectPartyId      String
  userId              String
  companyMembershipId String?
  role                String    @default("member")
  status              String    @default("active")
  invitedAt           DateTime?
  acceptedAt          DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  projectParty      ProjectParty       @relation(fields: [projectPartyId], references: [id], onDelete: Cascade)
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyMembership CompanyMembership? @relation(fields: [companyMembershipId], references: [id], onDelete: SetNull)

  @@unique([projectPartyId, userId])
  @@index([userId, projectPartyId])
  @@index([companyMembershipId])
  @@index([status])
}

model ProjectAssignment {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      String // role within this project

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model RefreshSession {
  id                  String    @id @default(uuid())
  userId              String
  orgId               String
  tokenHash           String    @unique
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([orgId, userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  orgId     String
  email     String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([orgId, email])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([revokedAt])
}

model InvitationToken {
  id           String    @id @default(uuid())
  orgId        String
  projectId    String?
  companyId    String?
  projectPartyId String?
  email        String
  role         String
  tokenHash    String    @unique
  note         String?
  status       String    @default("pending")
  invitedById  String?
  acceptedById String?
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  projectParty ProjectParty? @relation(fields: [projectPartyId], references: [id], onDelete: SetNull)
  invitedBy  User?        @relation("InvitationInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)
  acceptedBy User?        @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([companyId])
  @@index([projectPartyId])
  @@index([orgId, email])
  @@index([orgId, status])
  @@index([invitedById])
  @@index([acceptedById])
  @@index([expiresAt])
  @@index([acceptedAt])
  @@index([revokedAt])
}

model AuthAuditEvent {
  id           String   @id @default(uuid())
  orgId        String?
  projectId    String?
  userId       String?
  actorId      String?
  actorRole    String?
  entityType   String
  entityId     String?
  action       String
  email        String?
  ipAddress    String?
  userAgent    String?
  metadataJson Json     @default("{}")
  createdAt    DateTime @default(now())

  org     Organisation? @relation(fields: [orgId], references: [id], onDelete: SetNull)
  project Project?      @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user    User?         @relation("AuthAuditUser", fields: [userId], references: [id], onDelete: SetNull)
  actor   User?         @relation("AuthAuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([projectId])
  @@index([userId])
  @@index([actorId])
  @@index([entityType, entityId])
  @@index([email])
  @@index([createdAt])
}

model AuditEvent {
  id              String   @id @default(uuid())
  orgId           String
  projectId       String
  entityType      String
  entityId        String
  action          String
  actorId         String?
  actorRole       String?
  occurredAt      DateTime @default(now())
  oldStatus       String?
  newStatus       String?
  reason          String?
  oldSummaryJson  Json?
  newSummaryJson  Json?
  summaryJson     Json     @default("{}")
  attachmentsJson Json     @default("[]")
  metadataJson    Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([orgId])
  @@index([projectId])
  @@index([orgId, projectId, occurredAt])
  @@index([projectId, entityType, entityId, occurredAt])
  @@index([entityType, entityId])
}

model RecordHistorySnapshot {
  id                   String   @id @default(uuid())
  orgId                String
  projectId            String
  entityType           String
  entityId             String
  action               String
  actorId              String?
  actorRole            String?
  auditEventId         String?
  occurredAt           DateTime @default(now())
  oldStatus            String?
  newStatus            String?
  reason               String?
  previousSnapshotJson Json?
  snapshotJson         Json     @default("{}")
  changeSetJson        Json     @default("{}")
  metadataJson         Json     @default("{}")
  createdAt            DateTime @default(now())

  @@unique([auditEventId])
  @@index([orgId])
  @@index([projectId])
  @@index([orgId, projectId, occurredAt])
  @@index([projectId, entityType, entityId, occurredAt])
  @@index([entityType, entityId])
}

model ActivityAssignment {
  id         String @id @default(uuid())
  activityId String
  userId     String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

// ─── BOQ ───
// Tasks
model Task {
  id          String    @id @default(uuid())
  orgId       String
  projectId   String
  activityId  String?
  taskNumber  String
  title       String
  description String?
  label       String    @default("action")
  priority    String    @default("medium")
  status      String    @default("todo")
  dueDate     DateTime?
  assigneeId  String?
  createdById String?
  updatedById String?
  closedById  String?
  closedAt    DateTime?
  archivedAt  DateTime?
  archivedBy  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

