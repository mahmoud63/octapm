model LongLeadItem {
  id                   String    @id @default(uuid())
  projectId            String
  activityId           String?
  // The procurement package this item is being bought under, when one exists.
  // Nullable on purpose: a long-lead item is registered before anything is
  // ordered — that is what the register is for. While it is null the planner
  // maintains the dates and statuses by hand; once it is set they are derived
  // from the package, its orders and its deliveries, so the planner and the
  // buyer are not keeping the same facts in two places (OCTA-PROC-LONGLEAD-083).
  procurementPackageId String?
  item                 String
  leadWeeks            Int       @default(0)
  requiredTiming       String    @default("activity_start") // activity_start, activity_finish
  needOffsetDays       Int       @default(0)
