// â”€â”€â”€ Project knowledge assistant (OCTA-AI-ASSIST-028) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

model AssistantConversation {
  id            String    @id @default(uuid())
  orgId         String
  projectId     String?
  userId        String
  title         String
  // OCTA-AI-RFI-029: chat (Ask OctaPM) or a stored AI run on a record (rfi_draft, rfi_response, rfi_summary).
  kind          String    @default("chat")
  recordType    String?
  recordId      String?
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())
