  rfqs             Rfq[]

  @@unique([commitmentId, number])
  @@unique([projectId, ref])
  @@index([orgId])
  @@index([projectId, status])
  @@index([primeChangeOrderId])
}

// â”€â”€â”€ Scope and responsibility (OCTA-SUB-SCOPE-054) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/**
 * What a subcontract actually covers, agreed before it is written.
 *
 * Construction disputes come overwhelmingly from unclear scope boundaries â€”
 * who supplies the crane, who takes the waste away, who calls the inspection.
 * The matrix makes each of those an explicit row with a named party rather
 * than a paragraph of prose nobody re-reads.
 *
 * One per commitment or bid package, so a scope agreed at tender carries into
 * the contract without being retyped.
 */
model ScopeMatrix {
  id           String   @id @default(uuid())
  orgId        String
  projectId    String
  commitmentId String?  @unique
  bidPackageId String?  @unique
  title        String
  status       String   @default("draft") // draft, agreed
  notes        String?
  agreedAt     DateTime?
  agreedBy     String?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  org        Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  commitment Commitment?  @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  bidPackage BidPackage?  @relation(fields: [bidPackageId], references: [id], onDelete: Cascade)
  items      ScopeMatrixItem[]

  @@index([orgId])
  @@index([projectId, status])
}

/**
 * One statement about scope.
 *
 * `kind` keeps the five lists the brief asks for in one table, because they
 * are all statements about the same boundary and the contract generator walks
 * them in a single pass. Only scope and responsibility rows carry a party.
 */
model ScopeMatrixItem {
  id             String   @id @default(uuid())
  orgId          String
  projectId      String
  matrixId       String
  // scope, responsibility, inclusion, exclusion, clarification, interface
  kind           String   @default("scope")
  section        String?
  description    String
  // gc, subcontractor, by_others, shared, not_applicable â€” null on the list
  // kinds, which are statements rather than allocations.
  responsibility String?
  notes          String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  matrix  ScopeMatrix  @relation(fields: [matrixId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([matrixId, kind, sortOrder])
}

// â”€â”€â”€ Subcontract closeout (OCTA-SUB-CLOSE-056) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/**
 * What must be true before a subcontract is paid out and closed.
 *
 * Half the checklist is already knowable from records the system holds â€” the
 * punch list, the insurance certificates, the payment applications â€” so those
 * checks are derived on read rather than ticked by hand. The rest are things
 * somebody hands over: as-builts, O&M manuals, warranties, training, the final
 * lien waiver. Those are rows here, completed against evidence.
 *
 * A required item can be waived, with a reason, because real projects release
 * a retention against a written undertaking often enough that pretending
 * otherwise just teaches people to lie to the checklist.
 */
model SubcontractCloseout {
  id           String    @id @default(uuid())
  orgId        String
  projectId    String
  commitmentId String    @unique
  status       String    @default("open") // open, complete
  notes        String?
  completedAt  DateTime?
  completedBy  String?
  createdBy    String?
  updatedBy    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org        Organisation   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project    Project        @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  commitment Commitment     @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  items      CloseoutItem[]

  @@index([orgId])
  @@index([projectId, status])
}

/**
 * One closeout requirement.
 *
 * A row exists for every handover item, and also for a derived check that has
 * been waived â€” the stored row is what overrides the live answer, so a waiver
 * survives the thing it waived changing underneath it.
 */
model CloseoutItem {
  id           String    @id @default(uuid())
  orgId        String
  projectId    String
  closeoutId   String
  key          String
  label        String
  required     Boolean   @default(true)
  // outstanding, complete, waived, not_applicable
  status       String    @default("outstanding")
  documentId   String?
  note         String?
  waivedReason String?
  completedAt  DateTime?
  completedBy  String?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org      Organisation        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project  Project             @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  closeout SubcontractCloseout @relation(fields: [closeoutId], references: [id], onDelete: Cascade)
  document ProjectDocument?    @relation("CloseoutItemEvidence", fields: [documentId], references: [id], onDelete: SetNull)

  @@unique([closeoutId, key])
  @@index([orgId])
  @@index([closeoutId, sortOrder])
  @@index([documentId])
}

// â”€â”€â”€ Subcontractor payment applications (OCTA-FIN-SUBPAY-021) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

/** A period claim against a commitment's schedule of values. */
model SubPayApp {
  id                       String    @id @default(uuid())
  orgId                    String
  projectId                String
  commitmentId             String
  number                   Int
  ref                      String
  periodLabel              String
  periodStart              DateTime?
  periodEnd                DateTime?
  status                   String    @default("draft") // draft, submitted, under_review, approved, paid, rejected, void
  workThisPeriod           Decimal   @default(0) @db.Decimal(18, 2)
  workCumulative           Decimal   @default(0) @db.Decimal(18, 2)
  materialsOnSite          Decimal   @default(0) @db.Decimal(18, 2)
  grossThisPeriod          Decimal   @default(0) @db.Decimal(18, 2)
  retentionRate            Float     @default(5)
  retentionThisPeriod      Decimal   @default(0) @db.Decimal(18, 2)
  retentionCumulative      Decimal   @default(0) @db.Decimal(18, 2)
  backCharges              Decimal   @default(0) @db.Decimal(18, 2)
  backChargesNote          String?
  // Withheld for a stated reason that is not a back-charge, and tax on what
  // is left after everything is withheld (OCTA-COM-SUBPAY-052).
  otherDeductions          Decimal   @default(0) @db.Decimal(18, 2)
  otherDeductionsNote      String?
  taxRate                  Float     @default(0)
  taxAmount                Decimal   @default(0) @db.Decimal(18, 2)
  netThisPeriod            Decimal   @default(0) @db.Decimal(18, 2)
  paidAmount               Decimal   @default(0) @db.Decimal(18, 2)
  overClaimAmount          Decimal   @default(0) @db.Decimal(18, 2)
  waiverRequired           Boolean   @default(false)
  waiverDocumentId         String?
  complianceOverrideReason String?
  overClaimOverrideReason  String?
  reviewNote               String?
  rejectionCode            String?
  rejectedReason           String?
  notes                    String?
  submittedAt              DateTime?
  submittedBy              String?
  reviewedAt               DateTime?
  reviewedBy               String?
  approvedAt               DateTime?
  approvedBy               String?
  rejectedAt               DateTime?
  rejectedBy               String?
  paidAt                   DateTime?
  voidReason               String?
  // Revoking a certification reverses the ledger with negative mirrors rather
  // than deleting, so the original idempotency keys survive. The revision is
  // what a corrected re-certification keys on, so it counts as its own economic
  // event instead of being swallowed as a duplicate (OCTA-FIN-SUBPAY-063).
  certificationRevision    Int       @default(0)
  revokedReason            String?
  revokedAt                DateTime?
  revokedBy                String?
  createdBy                String?
  updatedBy                String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  org            Organisation       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project        Project            @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  commitment     Commitment         @relation(fields: [commitmentId], references: [id], onDelete: Cascade)
  waiverDocument ProjectDocument?   @relation("SubPayAppWaiverDocument", fields: [waiverDocumentId], references: [id], onDelete: SetNull)
  lines          SubPayAppLine[]
  payments       SubPayAppPayment[]

  @@unique([commitmentId, number])
  @@unique([projectId, ref])
  @@index([orgId])
  @@index([projectId, status])
  @@index([commitmentId, status])
}

/** One row per schedule-of-values line: previous, this period, cumulative and the approved-progress cap. */
model SubPayAppLine {
  id               String   @id @default(uuid())
  orgId            String
  projectId        String
  payAppId         String
  sovLineId        String
  description      String
  scheduledAmount  Decimal  @default(0) @db.Decimal(18, 2)
  // The line as revised by approved change orders at the moment this claim was
  // made, and what the changes contributed. Snapshotted alongside capAmount
  // and approvedPct, which are also what-was-true-then figures.
  approvedChangeAmount   Decimal @default(0) @db.Decimal(18, 2)
  revisedScheduledAmount Decimal @default(0) @db.Decimal(18, 2)
  previousAmount   Decimal  @default(0) @db.Decimal(18, 2)
  thisPeriodAmount Decimal  @default(0) @db.Decimal(18, 2)
  cumulativeAmount Decimal  @default(0) @db.Decimal(18, 2)
  materialsOnSite  Decimal  @default(0) @db.Decimal(18, 2)
  approvedPct      Float?
  capAmount        Decimal? @db.Decimal(18, 2)
  overClaimAmount  Decimal  @default(0) @db.Decimal(18, 2)
  notes            String?
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  org     Organisation      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project           @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  payApp  SubPayApp         @relation(fields: [payAppId], references: [id], onDelete: Cascade)
  sovLine CommitmentSovLine @relation(fields: [sovLineId], references: [id], onDelete: Cascade)

  @@unique([payAppId, sovLineId])
  @@index([orgId])
  @@index([projectId, payAppId])
  @@index([sovLineId])
}

model SubPayAppPayment {
  id        String   @id @default(uuid())
  orgId     String
  projectId String
  payAppId  String
  amount    Decimal  @default(0) @db.Decimal(18, 2)
  paidAt    DateTime
  method    String?
  reference String?
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  org     Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  project Project      @relation(fields: [projectId, orgId], references: [id, orgId], onDelete: Cascade)
  payApp  SubPayApp    @relation(fields: [payAppId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([projectId, paidAt])
  @@index([payAppId])
}

model CompanyEquipment {
  id        String   @id @default(uuid())
