  disposition        String?
  status             String    @default("open")
  owner              String?
  reviewer           String?
  approver           String?
  responsible        String?
  ownerUserId        String?
  reviewerUserId     String?
  approverUserId     String?
  assigneeUserId     String?
  assigneeCompanyId  String?
  ballInCourtUserId  String?
  dueDate            DateTime?
  closureComment     String?
