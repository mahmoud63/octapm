/// One person's place in one workspace: the role, administration and
/// ownership that used to be global columns on User (enterprise programme,
/// membership doc §1). A person holds one row per organisation; a guest row
/// (party members) can only carry the external_party role and never admin or
/// ownership — a CHECK constraint in the migration enforces that, since Prisma
/// cannot express it.
model OrganizationMembership {
  id               String    @id @default(uuid())
  orgId            String
  userId           String
  role             String                       // catalogue role id (shared/permissions.json roles) or 'external_party' for guests
  kind             String    @default("member") // member | guest
  isAdmin          Boolean   @default(false)    // company administration (was User.isCompanyAdmin)
  isOwner          Boolean   @default(false)    // ownership: billing, conversion, cannot be removed while last
  status           String    @default("active") // invited | active | suspended | left
  invitedById      String?
  invitationId     String?                      // InvitationToken that created it
  joinedAt         DateTime?
  leftAt           DateTime?
  lastActiveAt     DateTime?
  defaultProjectId String?                      // last project opened in this workspace (client convenience, nullable)
  // This workspace's own single-sign-on link (OIDC subject from its provider).
  // Scoped to the workspace: one company's provider never binds or blocks the
  // person's sign-in anywhere else (D-ID-1 Q2).
  ssoSubject       String?
  ssoLinkedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshSessions  RefreshSession[]
  ssoTickets       SsoTicket[]
  apiClients       ApiClient[]
  invitationTokens InvitationToken[]
  notifications    Notification[]
  projectAssignments     ProjectAssignment[]
  projectUserPermissions ProjectUserPermission[]

  @@unique([orgId, userId])
  @@unique([orgId, ssoSubject])
  @@index([userId, status])
  @@index([orgId, status])
  @@index([orgId, isOwner])
}

model RefreshSession {
