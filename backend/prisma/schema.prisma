generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Organisation & Users ───
model Organisation {
  id        String   @id @default(uuid())
  name      String
  plan      String   @default("standard")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  refreshSessions  RefreshSession[]
  projects         Project[]
  projectDocuments ProjectDocument[]
  subscription     Subscription?
  enterpriseLeads  EnterpriseLead[]
}

model User {
  id           String    @id @default(uuid())
  orgId        String
  name         String
  email        String    @unique
  phone        String?
  passwordHash String
  role         String    @default("site_engineer") // super_admin, pm, planning_eng, qs, cost_controller, procurement, warehouse, site_engineer, finance
  status       String    @default("active")
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  org                 Organisation         @relation(fields: [orgId], references: [id])
  projectAssignments  ProjectAssignment[]
  activityAssignments ActivityAssignment[]
  refreshSessions     RefreshSession[]
  dailyReports        DailyReport[]
  siteDiaries         SiteDiary[]

  @@index([orgId])
  @@index([email])
}

// ─── Projects ───
model Project {
  id                    String    @id @default(uuid())
  orgId                 String
  name                  String
  type                  String?
  location              String?
  clientName            String?
  consultantName        String?
  contractorName        String?
  contractType          String?
  contractNumber        String?
  startDate             DateTime?
  endDate               DateTime?
  completionDate        DateTime?
  baselineDate          DateTime?
  revisedCompletionDate DateTime?
  duration              Int?
  durationUnit          String    @default("months")
  contractValue         Decimal?  @db.Decimal(18, 2)
  defaultRetentionRate  Float?
  ldRatePerDay          Decimal   @default(0) @db.Decimal(18, 2)
  weatherAllowanceDays  Int       @default(20)
  projectCalendar       String?
  reportingCutoffDay    Int?
  currency              String    @default("USD")
  status                String    @default("active")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  org                           Organisation                   @relation(fields: [orgId], references: [id])
  assignments                   ProjectAssignment[]
  boqRevisions                  BoqRevision[]
  boqItems                      BoqItem[]
  boqActivities                 BoqActivity[]
  activityBoqAllocations        ActivityBoqAllocation[]
  activities                    Activity[]
  activityDependencies          ActivityDependency[]
  scheduleRevisions             ScheduleRevision[]
  costRecords                   CostRecord[]
  burnRateEntries               BurnRateEntry[]
  risks                         Risk[]
  longLeadItems                 LongLeadItem[]
  procurementSuppliers          ProcurementSupplier[]
  procurementPackages           ProcurementPackage[]
  procurementPoLines            ProcurementPoLine[]
  deliveryReceipts              DeliveryReceipt[]
  deliveryReceiptLines          DeliveryReceiptLine[]
  activityMaterialUsages        ActivityMaterialUsage[]
  procurementLeadTimeAlerts     ProcurementLeadTimeAlert[]
  changeOrders                  ChangeOrder[]
  changeOrderActivityLinks      ChangeOrderActivityLink[]
  changeOrderAllocationLinks    ChangeOrderAllocationLink[]
  ipcItems                      IpcItem[]
  ipcItemProgressLinks          IpcItemProgressLink[]
  ipcCertificates               IpcCertificate[]
  ipcInvoices                   IpcInvoice[]
  ipcPayments                   IpcPayment[]
  ipcRetentionReleases          IpcRetentionRelease[]
  subValuations                 SubValuation[]
  subValuationActivityLinks     SubValuationActivityLink[]
  subValuationAllocationLinks   SubValuationAllocationLink[]
  budgetRevisions               BudgetRevision[]
  reportingPeriods              ReportingPeriod[]
  activityCostLoadings          ActivityCostLoading[]
  evPeriodSnapshots             EvPeriodSnapshot[]
  activityProgressMethods       ActivityProgressMethod[]
  progressSubmissions           ProgressSubmission[]
  cashFlowEntries               CashFlowEntry[]
  eotClaims                     EotClaim[]
  eotClaimActivityLinks         EotClaimActivityLink[]
  eotClaimWeatherDelayLinks     EotClaimWeatherDelayLink[]
  weatherDelays                 WeatherDelay[]
  weatherDelayActivityLinks     WeatherDelayActivityLink[]
  procurementOrders             ProcurementOrder[]
  materialMaster                MaterialMaster[]
  equipment                     Equipment[]
  itpRecords                    ItpRecord[]
  ncrRecords                    NcrRecord[]
  defectRecords                 DefectRecord[]
  safetyIncidents               SafetyIncident[]
  materialTests                 MaterialTest[]
  rfis                          Rfi[]
  submittals                    Submittal[]
  drawingRecords                DrawingRecord[]
  transmittals                  Transmittal[]
  correspondences               Correspondence[]
  workflowAttachments           WorkflowAttachment[]
  workflowStatusHistory         WorkflowStatusHistory[]
  approvalWorkflowEvents        ApprovalWorkflowEvent[]
  workflowActivityLinks         WorkflowActivityLink[]
  documentRevisions             DocumentRevision[]
  projectDocuments              ProjectDocument[]
  commercialCorrespondenceLinks CommercialCorrespondenceLink[]
  commercialAttachmentRefs      CommercialAttachmentRef[]
  dailyReports                  DailyReport[]
  siteDiary                     SiteDiary[]
  weeklyReports                 WeeklyReport[]
  resourceAllocations           ResourceAllocation[]
  activityMaterials             ActivityMaterial[]

  @@index([orgId])
}

model ProjectAssignment {
  id        String @id @default(uuid())
  projectId String
  userId    String
  role      String // role within this project

  project Project @relation(fields: [projectId], references: [id])
  user    User    @relation(fields: [userId], references: [id])

  @@unique([projectId, userId])
  @@index([userId, projectId])
}

model RefreshSession {
  id                  String    @id @default(uuid())
  userId              String
  orgId               String
  tokenHash           String    @unique
  userAgent           String?
  ipAddress           String?
  expiresAt           DateTime
  revokedAt           DateTime?
  replacedBySessionId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org  Organisation @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([orgId])
  @@index([orgId, userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model AuditEvent {
  id              String   @id @default(uuid())
  orgId           String
  projectId       String
  entityType      String
  entityId        String
  action          String
  actorId         String?
  actorRole       String?
  occurredAt      DateTime @default(now())
  oldStatus       String?
  newStatus       String?
  reason          String?
  oldSummaryJson  Json?
  newSummaryJson  Json?
  summaryJson     Json     @default("{}")
  attachmentsJson Json     @default("[]")
  metadataJson    Json     @default("{}")
  createdAt       DateTime @default(now())

  @@index([orgId])
  @@index([projectId])
  @@index([orgId, projectId, occurredAt])
  @@index([projectId, entityType, entityId, occurredAt])
  @@index([entityType, entityId])
}

model RecordHistorySnapshot {
  id                   String   @id @default(uuid())
  orgId                String
  projectId            String
  entityType           String
  entityId             String
  action               String
  actorId              String?
  actorRole            String?
  auditEventId         String?
  occurredAt           DateTime @default(now())
  oldStatus            String?
  newStatus            String?
  reason               String?
  previousSnapshotJson Json?
  snapshotJson         Json     @default("{}")
  changeSetJson        Json     @default("{}")
  metadataJson         Json     @default("{}")
  createdAt            DateTime @default(now())

  @@unique([auditEventId])
  @@index([orgId])
  @@index([projectId])
  @@index([orgId, projectId, occurredAt])
  @@index([projectId, entityType, entityId, occurredAt])
  @@index([entityType, entityId])
}

model ActivityAssignment {
  id         String @id @default(uuid())
  activityId String
  userId     String

  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([activityId, userId])
  @@index([activityId])
  @@index([userId])
}

// ─── BOQ ───
model BoqItem {
  id                     String    @id @default(uuid())
  projectId              String
  revisionId             String?
  code                   String? // e.g. "1.1", "2.3" — BOQ item code
  ref                    String? // legacy field kept for IPC compatibility
  description            String
  unit                   String?
  qty                    Float     @default(0)
  rate                   Decimal   @default(0) @db.Decimal(18, 2)
  amount                 Decimal   @default(0) @db.Decimal(18, 2)
  section                String?
  isManual               Boolean   @default(false)
  isActive               Boolean   @default(true)
  baselineLocked         Boolean   @default(false)
  supersededAt           DateTime?
  supersededByRevisionId String?
  supersededReason       String?
  sortOrder              Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  project                 Project                      @relation(fields: [projectId], references: [id])
  boqRevision             BoqRevision?                 @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  ipcItems                IpcItem[]
  boqActivities           BoqActivity[]
  activityBoqAllocations  ActivityBoqAllocation[]
  changeOrderAllocations  ChangeOrderAllocationLink[]
  subValuationAllocations SubValuationAllocationLink[]

  @@index([projectId])
  @@index([projectId, isActive])
  @@index([projectId, code])
  @@index([revisionId])
}

model BoqRevision {
  id               String    @id @default(uuid())
  projectId        String
  revisionNumber   Int
  label            String?
  source           String    @default("upload")
  status           String    @default("imported") // imported, comparison_only, baselined, superseded
  baselineLocked   Boolean   @default(false)
  lockedBy         String?
  lockedAt         DateTime?
  itemCount        Int       @default(0)
  addedCount       Int       @default(0)
  updatedCount     Int       @default(0)
  removedCount     Int       @default(0)
  unchangedCount   Int       @default(0)
  blockedCount     Int       @default(0)
  totalAmount      Decimal   @default(0) @db.Decimal(18, 2)
  importedRowsJson Json      @default("[]")
  compareJson      Json      @default("{}")
  createdBy        String?
  sourceDocumentId String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project        Project          @relation(fields: [projectId], references: [id])
  sourceDocument ProjectDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  boqItems       BoqItem[]

  @@unique([projectId, revisionNumber])
  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, baselineLocked])
  @@index([sourceDocumentId])
}

model ProjectDocument {
  id                 String    @id @default(uuid())
  orgId              String
  projectId          String
  documentType       String
  linkedEntityType   String?
  linkedEntityId     String?
  originalName       String
  fileName           String
  mimeType           String
  sizeBytes          Int
  sha256             String
  storageProvider    String
  bucket             String?
  objectKey          String
  storageKey         String    @unique
  storageVersionId   String?
  scanStatus         String    @default("clean")
  scannedAt          DateTime?
  status             String    @default("available")
  retentionPolicy    String?
  retentionExpiresAt DateTime?
  uploadedBy         String?
  uploadedAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  org                      Organisation              @relation(fields: [orgId], references: [id])
  project                  Project                   @relation(fields: [projectId], references: [id])
  boqRevisions             BoqRevision[]
  commercialAttachmentRefs CommercialAttachmentRef[]

  @@index([orgId])
  @@index([projectId])
  @@index([orgId, projectId, documentType])
  @@index([projectId, linkedEntityType, linkedEntityId])
  @@index([storageProvider, bucket])
  @@index([retentionExpiresAt])
}

model BoqActivity {
  id                 String    @id @default(uuid())
  boqItemId          String
  projectId          String
  activityCode       String
  activityName       String
  unit               String?
  quantity           Float     @default(0)
  rate               Decimal   @default(0) @db.Decimal(18, 2)
  budget             Decimal   @default(0) @db.Decimal(18, 2)
  dependencyType     String? // FS, SS, null
  predecessorCode    String? // activityCode of predecessor
  isManual           Boolean   @default(false)
  status             String    @default("draft_suggestion") // draft_suggestion, accepted, rejected
  acceptedActivityId String?
  acceptedAt         DateTime?
  acceptedBy         String?
  sortOrder          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  boqItem          BoqItem   @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  project          Project   @relation(fields: [projectId], references: [id])
  acceptedActivity Activity? @relation(fields: [acceptedActivityId], references: [id], onDelete: SetNull)

  @@unique([projectId, activityCode])
  @@index([boqItemId])
  @@index([projectId])
  @@index([projectId, status])
  @@index([acceptedActivityId])
}

model ExtraServicesConfig {
  id         String @id @default(uuid())
  label      String
  percentage Float  @default(0)
  sortOrder  Int    @default(0)
}

// ─── Activities (THE CORE — everything links here) ───
model Activity {
  id                String    @id @default(uuid())
  projectId         String
  name              String
  p6ActivityId      String?
  wbsCode           String?
  calendarId        String?
  category          String?
  startDate         DateTime?
  endDate           DateTime?
  duration          Int       @default(0)
  originalDuration  Int?
  remainingDuration Int?
  physComplete      Float?
  earlyStart        Int?
  earlyFinish       Int?
  baselineStart     Int?
  baselineFinish    Int?
  lateStart         Int?
  lateFinish        Int?
  totalFloat        Int?
  budget            Decimal   @default(0) @db.Decimal(18, 2)
  isMilestone       Boolean   @default(false)
  isCritical        Boolean   @default(false)
  predecessors      String? // comma-separated: "ACT-01 FS, ACT-02 SS+2"
  batchId           String? // for chunked generation: B1, B2, etc.
  isActive          Boolean   @default(true)
  retiredAt         DateTime?
  retiredBy         String?
  retiredReason     String?
  retiredRevisionId String?
  sortOrder         Int       @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project                Project                    @relation(fields: [projectId], references: [id])
  progress               ActivityProgress[]
  costRecords            CostRecord[]
  longLeadItems          LongLeadItem[]
  procurementPackages    ProcurementPackage[]
  changeOrders           ChangeOrder[]
  changeOrderLinks       ChangeOrderActivityLink[]
  itpRecords             ItpRecord[]
  procurementOrders      ProcurementOrder[]
  procurementPoLines     ProcurementPoLine[]
  deliveryReceiptLines   DeliveryReceiptLine[]
  materialUsages         ActivityMaterialUsage[]
  leadTimeAlerts         ProcurementLeadTimeAlert[]
  ncrRecords             NcrRecord[]
  defectRecords          DefectRecord[]
  safetyIncidents        SafetyIncident[]
  materialTests          MaterialTest[]
  rfis                   Rfi[]
  submittals             Submittal[]
  drawingRecords         DrawingRecord[]
  correspondences        Correspondence[]
  workflowLinks          WorkflowActivityLink[]
  dailyReports           DailyReport[]
  assignments            ActivityAssignment[]
  materials              ActivityMaterial[]
  activityEquipment      ActivityEquipment[]
  resourceAllocations    ResourceAllocation[]
  boqActivitySuggestions BoqActivity[]
  boqAllocations         ActivityBoqAllocation[]
  costLoadings           ActivityCostLoading[]
  progressMethod         ActivityProgressMethod?
  progressSubmissions    ProgressSubmission[]
  ipcProgressLinks       IpcItemProgressLink[]
  subValuationLinks      SubValuationActivityLink[]
  eotClaimLinks          EotClaimActivityLink[]
  weatherDelayLinks      WeatherDelayActivityLink[]
  predecessorLinks       ActivityDependency[]       @relation("ActivityDependencySuccessor")
  successorLinks         ActivityDependency[]       @relation("ActivityDependencyPredecessor")

  @@index([projectId])
  @@index([projectId, isActive])
  @@index([projectId, isActive, sortOrder])
  @@index([projectId, isActive, category])
  @@index([projectId, isCritical])
  @@index([projectId, p6ActivityId])
  @@index([projectId, wbsCode])
}

model ActivityDependency {
  id                     String   @id @default(uuid())
  projectId              String
  predecessorId          String
  successorId            String
  relationshipType       String   @default("FS") // FS, SS, FF, SF
  lagDays                Int      @default(0) // negative values represent lead
  source                 String   @default("manual") // manual, import, ai, migration
  importSource           String?
  externalPredecessorRef String?
  externalSuccessorRef   String?
  importMetadata         Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project     Project  @relation(fields: [projectId], references: [id])
  predecessor Activity @relation("ActivityDependencyPredecessor", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Activity @relation("ActivityDependencySuccessor", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([projectId, predecessorId, successorId])
  @@index([projectId])
  @@index([predecessorId])
  @@index([successorId])
  @@index([projectId, successorId])
}

model ActivityBoqAllocation {
  id             String    @id @default(uuid())
  projectId      String
  boqItemId      String
  activityId     String
  quantity       Float     @default(0)
  amount         Decimal   @default(0) @db.Decimal(18, 2)
  weight         Float     @default(0)
  source         String    @default("manual") // manual, import, ai, migration
  status         String    @default("draft") // draft, submitted, approved, rejected
  isActive       Boolean   @default(true)
  notes          String?
  submittedBy    String?
  submittedAt    DateTime?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedBy     String?
  rejectedAt     DateTime?
  rejectedReason String?
  createdBy      String?
  updatedBy      String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  project           Project                      @relation(fields: [projectId], references: [id])
  boqItem           BoqItem                      @relation(fields: [boqItemId], references: [id], onDelete: Cascade)
  activity          Activity                     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  ipcItems          IpcItem[]
  changeOrderLinks  ChangeOrderAllocationLink[]
  ipcProgressLinks  IpcItemProgressLink[]
  subValuationLinks SubValuationAllocationLink[]

  @@index([projectId])
  @@index([boqItemId])
  @@index([activityId])
  @@index([projectId, status])
}

model ActivityProgress {
  id                    String    @id @default(uuid())
  activityId            String
  submissionId          String?   @unique
  pctComplete           Float     @default(0)
  actualCost            Decimal?  @db.Decimal(18, 2)
  actualStart           DateTime?
  actualFinish          DateTime?
  progressMethod        String    @default("percent_complete")
  source                String    @default("manual")
  quantityComplete      Float?
  quantityPlanned       Float?
  quantityUnit          String?
  milestoneProgressJson Json?
  inspectionStatus      String?
  evidenceJson          Json?
  status                String    @default("approved")
  approvedBy            String?
  approvedAt            DateTime?
  notes                 String?
  updatedBy             String?
  updatedAt             DateTime  @default(now())

  activity   Activity              @relation(fields: [activityId], references: [id])
  submission ProgressSubmission?   @relation(fields: [submissionId], references: [id], onDelete: SetNull)
  ipcLinks   IpcItemProgressLink[]

  @@index([activityId])
  @@index([activityId, status, updatedAt])
}

model ActivityProgressMethod {
  id                   String   @id @default(uuid())
  projectId            String
  activityId           String   @unique
  method               String   @default("percent")
  plannedQuantity      Float?
  quantityUnit         String?
  milestoneWeightsJson Json?
  inspectionRequired   Boolean  @default(false)
  evidenceRequired     Boolean  @default(false)
  notes                String?
  createdBy            String?
  updatedBy            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project  Project  @relation(fields: [projectId], references: [id])
  activity Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, method])
}

model ProgressSubmission {
  id                    String    @id @default(uuid())
  projectId             String
  activityId            String
  dailyReportId         String?
  method                String    @default("percent")
  source                String    @default("manual")
  pctComplete           Float     @default(0)
  quantityComplete      Float?
  quantityPlanned       Float?
  quantityUnit          String?
  milestoneProgressJson Json?
  inspectionStatus      String?
  actualCost            Decimal?  @db.Decimal(18, 2)
  actualStart           DateTime?
  actualFinish          DateTime?
  notes                 String?
  evidenceJson          Json?
  status                String    @default("submitted") // draft, submitted, approved, rejected
  submittedBy           String?
  submittedAt           DateTime?
  reviewedBy            String?
  reviewedAt            DateTime?
  rejectionReason       String?
  createdBy             String?
  updatedBy             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project          Project           @relation(fields: [projectId], references: [id])
  activity         Activity          @relation(fields: [activityId], references: [id], onDelete: Cascade)
  dailyReport      DailyReport?      @relation(fields: [dailyReportId], references: [id], onDelete: SetNull)
  approvedProgress ActivityProgress?

  @@index([projectId])
  @@index([activityId])
  @@index([projectId, status])
  @@index([dailyReportId])
}

// ─── Schedule Revisions ───
model ScheduleRevision {
  id                       String    @id @default(uuid())
  projectId                String
  label                    String?
  activityCount            Int       @default(0)
  criticalCount            Int       @default(0)
  totalBudget              Decimal   @default(0) @db.Decimal(18, 2)
  snapshotJson             Json?
  source                   String?
  isActive                 Boolean   @default(false)
  status                   String    @default("draft") // draft, under_review, approved, rejected, baselined, superseded
  submittedBy              String?
  submittedAt              DateTime?
  reviewComment            String?
  approvedBy               String?
  approvedAt               DateTime?
  approvalComment          String?
  rejectedBy               String?
  rejectedAt               DateTime?
  rejectionReason          String?
  baselinedBy              String?
  baselinedAt              DateTime?
  baselineComment          String?
  supersededBy             String?
  supersededAt             DateTime?
  activatedBy              String?
  activatedAt              DateTime?
  activationComment        String?
  previousActiveRevisionId String?
  rolledBackBy             String?
  rolledBackAt             DateTime?
  rollbackReason           String?
  mappingJson              Json?
  activationAuditJson      Json?
  readinessJson            Json?
  statusTransitionLog      Json      @default("[]")
  createdAt                DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id])

  @@index([projectId])
  @@index([projectId, status])
  @@index([projectId, isActive])
}

model WeeklyReport {
  id                   String   @id @default(uuid())
  projectId            String
  ref                  String
  weekStartDate        DateTime
  weekEndDate          DateTime
  preparedBy           String?
  weatherCondition     String?
  weatherDelayDays     Int      @default(0)
  plannedProgress      Float    @default(0)
  actualProgress       Float    @default(0)
  manpowerCount        Int      @default(0)
  activitiesCompleted  Json     @default("[]")
  activitiesInProgress Json     @default("[]")
  issuesSummary        String?
  nextWeekPlan         String?
  remarks              String?
  status               String   @default("draft")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, ref])
  @@index([projectId])
  @@index([weekStartDate])
}

// ─── Cost Control ───
model CostRecord {
  id                String    @id @default(uuid())
  activityId        String
  projectId         String
  labour            Decimal   @default(0) @db.Decimal(18, 2)
  material          Decimal   @default(0) @db.Decimal(18, 2)
  equipment         Decimal   @default(0) @db.Decimal(18, 2)
  subcontract       Decimal   @default(0) @db.Decimal(18, 2)
  indirect          Decimal   @default(0) @db.Decimal(18, 2)
  overhead          Decimal   @default(0) @db.Decimal(18, 2)
  contingency       Decimal   @default(0) @db.Decimal(18, 2)
  budget            Decimal   @default(0) @db.Decimal(18, 2)
  committed         Decimal   @default(0) @db.Decimal(18, 2)
  actual            Decimal   @default(0) @db.Decimal(18, 2)
  actualThroughDate DateTime?
  forecast          Decimal   @default(0) @db.Decimal(18, 2)
  updatedAt         DateTime  @default(now()) @updatedAt

  activity Activity @relation(fields: [activityId], references: [id])
  project  Project  @relation(fields: [projectId], references: [id])

  @@index([activityId])
  @@index([projectId])
  @@index([projectId, updatedAt])
  @@index([projectId, actualThroughDate])
  @@index([projectId, actual])
  @@index([projectId, forecast])
}

model ReportingPeriod {
  id          String    @id @default(uuid())
  projectId   String
  code        String
  label       String?
  periodStart DateTime
  periodEnd   DateTime
  cutoffDate  DateTime
  status      String    @default("open") // open, locked
  lockedBy    String?
  lockedAt    DateTime?
  createdBy   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project      Project               @relation(fields: [projectId], references: [id])
  costLoadings ActivityCostLoading[]
  evSnapshot   EvPeriodSnapshot?

  @@unique([projectId, code])
  @@index([projectId])
  @@index([projectId, cutoffDate])
  @@index([projectId, status])
}

model ActivityCostLoading {
  id                String    @id @default(uuid())
  projectId         String
  activityId        String
  reportingPeriodId String?
  plannedDate       DateTime
