  optionsJson    Json? // [{ value, label }] for select / multi_select
  required       Boolean   @default(false)
  hidden         Boolean   @default(false)
  defaultJson    Json?
  validationJson Json? // { min, max, minLength, maxLength, pattern }
  conditionJson  Json? // { field, op, value } â€” shown when the condition holds
  position       Int       @default(0)
  status         String    @default("active") // active, archived
