# Copy to terraform.tfvars and fill in real values
# Never commit terraform.tfvars to git

aws_region    = "us-east-2"
app_name      = "pmcopilots"
environment   = "prod"

domain_name   = "octapm.com"

db_name     = "pmcopilots"
db_username = "pmcopilots"

# Production recovery policy
rds_backup_retention_days = 7
rds_backup_window         = "02:00-03:00"
rds_recovery_rpo_hours    = 24
rds_recovery_rto_hours    = 4

# Secrets — set via environment variables instead of this file:
#   export TF_VAR_db_password="..."
#   export TF_VAR_anthropic_api_key="sk-ant-..."
#   export TF_VAR_jwt_secret="..."
#   export TF_VAR_jwt_refresh_secret="..."
#   export TF_VAR_cloudfront_origin_secret="..."
db_password        = "CHANGE_ME"
anthropic_api_key  = "sk-ant-CHANGE_ME"
jwt_secret         = "CHANGE_ME"
jwt_refresh_secret = "CHANGE_ME"
cloudfront_origin_secret = "CHANGE_ME"

# Your SSH public key (cat ~/.ssh/id_ed25519.pub)
ssh_public_key = "ssh-ed25519 AAAA... your-email@example.com"

# Your IP for SSH access (curl ifconfig.me)
your_ip_cidr = "0.0.0.0/32"

# GitHub Actions OIDC — repo that is allowed to assume the deploy role
# Format: "org-or-username/repo-name"
github_repo = "CHANGE_ME/pmcopilots"
